+# [MP8] ===== 倒计时的自定义（默认全空，不影响其它 14 个小游戏）=====
+#
+# 这个 overlay 是**所有小游戏共用**的，所以这里只加"字段为空就什么都不做"的开关，
+# 由小游戏自己填。目前只有猎鸭在用（见 duck_hunt.gd 的 _mp8_setup_countdown）。
+#
+# 关键前提：倒计时文字是**每台机器各自渲染**的——服务器只广播 "3"/"2"/"1"/"GO!"
+# 这几个 token（见 Minigame._on_countdown_tick），所以同一时刻可以让鸭子看到一句话、
+# 猎人看到另一句话，不需要额外的 RPC。
+var mp8_go_text: String = ""        # 非空则替换 "GO!" 的文字（红色、大一号、剧烈抖动）
+var mp8_one_text: String = ""       # 非空则**整个替换掉倒计时的"1"**（红色），如"猎人已大幅增强"
+var mp8_shake_on_go: bool = false   # GO 那一下抖动
+
+const MP8_RED: Color = Color(1.0, 0.18, 0.18)
+const MP8_GO_FONT_SCALE: float = 1.18   # "大一号"（用户 2026-08-15 从大两号改回大一号）
+const MP8_SHAKE_AMPLITUDE: float = 34.0 # 抖动幅度（像素），越大越剧烈
+const MP8_SHAKE_STEPS: int = 16
+
+var _mp8_label_base_color: Color = Color.WHITE
+var _mp8_label_base_size: int = 128
+var _mp8_label_base_saved: bool = false
+var _mp8_label_base_position: Vector2 = Vector2.ZERO
+var _mp8_shake_tween: Tween = null
+
+
 func set_countdown(text: String, _with_fade: bool = true, _fade_time: float = 0.5):
 	var is_valid_string = false
