+# [MP8] 自动开局：人到齐后房主自己按 START，省掉人工点按钮。
+# 只在 host 实例上跑；超时就放弃，不会把大厅卡死。
+func _mp8_autostart(want: int) -> void :
+
+	print("[MP8] autostart：等 %d 人到齐" % want)
+
+	var waited: int = 0
+	while waited < 180:
+
+		await get_tree().create_timer(1.0).timeout
+		waited += 1
+
+		if not NetworkManager.active_backend:
+			continue
+
+		var n: int = NetworkManager.active_backend.connected_players.size()
+
+		if waited % 5 == 0:
+			print("[MP8] autostart：已连 %d/%d（%d 秒）" % [n, want, waited])
+
+		if n >= want:
+			print("[MP8] autostart：%d 人到齐，3 秒后开局" % n)
+			# [MP8] 大厅 8 席位宣传图就在这 3 秒里拍 —— 这是**唯一**"人全到齐、
+			# 还没开局"的窗口，错过就只剩空椅子或已经进小游戏了。
+			# 把原来一次 3 秒的等待劈成 1.5 + 1.5，总时长不变，不影响开局时序。
+			await get_tree().create_timer(1.5).timeout
+			_mp8_lobby_shot()
+			await get_tree().create_timer(1.5).timeout
+			print("[MP8] autostart：开局")
+			_on_lobby_start_button_pressed()
+			return
+
+	print("[MP8] autostart：等了 %d 秒还没到 %d 人，放弃" % [waited, want])
+
+
