+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 帧时间探针（opt-in：`mp8perf`）—— 定位 8 人卡顿卡在哪一层
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 起因：玩家报「隧道险境和立足之本 8 人卡得跟 ppt 一样，**所有人都卡**」（T50 ⑤）。
+# 读代码已经排掉四条（见 HANDOFF T50 ⑤）：不是我们的每帧代码（一行都没加）、
+# 不是多摆了对象、不是同步器流量（这两关最低）、不是纯网络延迟（所有人都卡）。
+# 而且**同样 8 人猎鸭不卡** —— 所以是这两个场景特有的东西 × 人数。
+#
+# 读到这儿就该停手上测量了。本探针每 2 秒打一行，把一帧的开销拆成三层：
+#
+#   process   —— 脚本逻辑（_process / _physics_process 里的 GDScript）
+#   physics   —— 物理步进（刚体、碰撞、角色控制器）
+#   draw/obj  —— 渲染（绘制调用数、被绘制的对象数）
+#
+# **三者哪个跟着人数涨，根因就在哪一层** —— 这是本探针唯一的目的。
+# 横比方法：同样 8 开，分别跑猎鸭（不卡）和隧道险境（卡），对比同一行的数字。
+#
+# 挂在 NetworkManager 而不是某个小游戏脚本：它是 autoload、跨小游戏常驻，
+# 一处改动就能覆盖全部 15 个小游戏，否则没法做上面那个横比。
+#
+# ⚠️ 用 Timer 而不是 _process：本脚本没有 _process，加一个有覆盖基类的风险（同 T49 的做法）。
+# ⚠️ opt-in，发布版玩家双击启动什么都不传 → 一个字节都不写（同侦察日志的规矩）。
+# ⚠️ 写**每实例一份文件**，不靠 print：8 开时所有实例共用一个 godot.log 会互相盖字，
+#    这一轮已经栽过一次（见 HANDOFF T49「常备诊断」）。性能数据糊了等于白跑。
+#    文件名用进程号而不是 peer id —— autoload 的 _ready 跑在联机建立之前，那时候还没有 peer id。
+# ⚠️ 每行 flush：测完是被 stop.ps1 强杀的，不 flush 缓冲里的全丢。
+var _mp8_perf_on: bool = false
+var _mp8_perf_timer: Timer = null
+var _mp8_perf_f: FileAccess = null
+
+func _mp8_perf_start() -> void :
+
+	var args := Array(OS.get_cmdline_args())
+	_mp8_perf_on = args.has("mp8perf")
+	if not _mp8_perf_on:
+		return
+
+	_mp8_perf_f = FileAccess.open("user://mp8_perf_%d.log" % OS.get_process_id(), FileAccess.WRITE)
+	print("[MP8-PERF] 帧时间探针已开（每 2 秒一行）→ user://mp8_perf_%d.log" % OS.get_process_id())
+
+	_mp8_perf_timer = Timer.new()
+	_mp8_perf_timer.wait_time = 2.0
+	_mp8_perf_timer.autostart = true
+	_mp8_perf_timer.timeout.connect(_mp8_perf_tick)
+	add_child(_mp8_perf_timer)
+
+
+func _mp8_perf_tick() -> void :
+
+	if not _mp8_perf_on:
+		return
+
+	# 当前在玩哪个小游戏 —— 不带这个，横比时对不上是哪一关的数
+	var where: String = "?"
+	if Globals != null:
+		var mg = Globals.get("current_minigame_identifier")
+		if mg != null:
+			where = str(mg)
+
+	var line: String = "[MP8-PERF] %-14s fps=%5.1f | 脚本 %6.2f ms | 物理 %6.2f ms | 绘制调用 %5d | 绘制对象 %5d | 节点 %5d | 玩家 %d" % [
+		where,
+		Performance.get_monitor(Performance.TIME_FPS),
+		Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0,
+		Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0,
+		int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
+		int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)),
+		int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)),
+		PlayerManager.player_presences.size() if PlayerManager != null else -1,
+	]
+	print(line)
+	if _mp8_perf_f != null:
+		_mp8_perf_f.store_line(line)
+		_mp8_perf_f.flush()
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] T53 版本不匹配的**可执行提示**（2026-08-31）
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 原版对所有不匹配只有一句话（`LOC_TAG_VERSION_MISMATCH`）：
+#     「连接失败。您当前的游戏版本与该房间不符。」
+# 它没告诉玩家**该做什么** —— 因为握手比的是整串相等
+# （`enet_backend.gd:133` / `steam_backend.gd:169`），下面四种情形走同一条路：
+#   我的 mod 旧 / 我的 mod 新 / 房主没装 mod / 我没装而房主装了。
+# 前三种要做的事完全不同（我更新 / 房主更新 / 卸载还原），第四种更是连
+# 「去装 mod」这个动作都提示不到。1.5 又要挡一批人，所以这次把话说清楚。
+#
+# ── 为什么需要互相报一次版本 ──
+# 拒绝时客机手上只有 `RefuseReason.VersionMismatch` 一个枚举，**不知道房主是什么版本**，
+# 光凭这个分不出「房主是原版」还是「房主 mod 版本不同」。
+# 所以房主在**每个 peer 连上的那一刻**先报一次自己的完整版本串，客机收到后回报自己的。
+#
+# 判据是**收没收到**，不是收到了什么：收到 → 串里有确切版本，能算出谁新谁旧；
+# 没收到 → 对面没有这套握手。⚠️「没装」与「版本太老」**分不开**，
+# 所以文案只能说「未回报版本」，不能断言「对方没装」。
+#
+# 🩸 **两个方向的精确度不一样（2026-09-03 实测，别记混）**：
+#   · **房主判断客机**：1.5 的客机**会**回报（它的 mp8_hello_rpc 回给服务器，而房主就是服务器）
+#     → 修好之后**立刻**就能精确点名 1.5 的人。没收到 = 原版或 ≤1.4。
+#   · **客机判断房主**：1.5 的房主**永远不会**回报 —— 它的 hello 挂在 `on_peer_connected` 上，
+#     而那个信号对被拒的人根本不发（就是本次修的 bug）。
+#     所以 **1.5↔1.6 这一次不匹配，客机侧只能落到情形 ③**，无论我们这边怎么改。
+#     没收到 = 原版 / ≤1.4 / **或 1.5**。要两边都 ≥ MP8_HELLO_SINCE 才精确。
+#
+# ── 第四种情形（我没装、房主装了）为什么只能显示在房主屏幕上 ──
+# 那台客机跑的是**原版代码**，我们一行都改不到，它必然显示原版那句话。
+# 唯一还能说话的是房主 —— 所以那条提示发到**房主的大厅消息条**
+# （`lobby_handler.send_lobby_message`，原版自带、复制房间号时就在用），
+# 让房主告诉进不来的那位。这是这一种能做到的全部，别指望客机端。
+#
+# ⚠️ 给原版客机发这条 RPC，会在**他那台机器**的日志里留一行「方法不存在」的错误。
+#    无害（节点存在、只是没这个方法），且他本来就要被拒；换来的是第四种情形有救。
+
+signal mp8_join_blocked(text: String)   # 房主侧：有人被版本挡住了，带上给房主看的话
+
+var _mp8_host_version: String = ""              # 客机侧：房主报来的完整版本串
+var _mp8_peer_versions: Dictionary = {}         # 房主侧：network_id -> 对方版本串
+var _mp8_peers_accepted: Dictionary = {}        # 房主侧：真正被收编过的 peer（见下）
+var _mp8_hello_waiting: Dictionary = {}        # engine-connected peers explicitly sent a hello
+var _mp8_network_reject_at: int = -5000
+
+
+# 🩸 2026-09-03 实测修正：钩子原先挂的是 `on_peer_connected`，**那个信号对被拒的人根本不发**。
+#
+# 原版后端的入房链条（enet_backend.gd / steam_backend.gd 形状完全相同）：
+#     multiplayer.peer_connected      ← 引擎层，**每个连上来的人都发**
+#       → _on_player_connected() → send_client_data_rpc.rpc_id(对方)
+#       → 对方回 receive_client_data_rpc(自己的 client_data)
+#           if client_game_version != Globals.game_version:
+#               refuse_client_rpc.rpc_id(对方, VersionMismatch)
+#               return                                   ← 被拒的人走这条，到此为止
+#       → acknowledge_client_data_rpc()
+#             on_peer_connected.emit()                   ← **只有通过版本检查的人才走到这里**
+#
+# 后果（实测）：版本不符的人一个 hello 都收不到，
+#   · 房主侧的「有人被挡在门外」（情形 ④）**从来没触发过**；
+#   · 客机侧 `_mp8_host_version` 恒为空 → `mp8_mismatch_text()` 永远落到情形 ③，
+#     ①②⑤ 三个分支**不可达**。
+# 对照实验坐实：原版客机被拒时它的日志里连「方法不存在」都没有（= 房主没发过 hello），
+# 而同版本成功入房时房主的 `_mp8_peer_versions` 里确实有对方版本（= 机制本身没坏）。
+#
+# 修法：改挂**引擎层**的 `multiplayer.peer_connected`。
+# 我们在 autoload 的 _ready() 里连，比后端节点（`set_active_backend` 时才创建）连得早，
+# 所以我们的 hello 会**先于** `send_client_data_rpc` 出门；两者同为 reliable、同一条信道，
+# 于是 hello 必定先于拒绝到达对方。
+#
+# ⚠️ 同时废掉了原来那个「等 2 秒再看」的形状：实测从 peer_connected 到
+# peer_disconnected 只有 **2 毫秒**（本机 ENet，大厅场景帧率极高），等 2 秒时人早走光了。
+# 判定改挂 `peer_disconnected` —— 那是确定性的时刻，不是猜的时长。
+func _mp8_version_hooks() -> void :
+
+	multiplayer.peer_connected.connect(_mp8_on_raw_peer_connected)
+	multiplayer.peer_disconnected.connect(_mp8_on_raw_peer_disconnected)
+
+	# 游戏层的 on_peer_connected = 「这个人通过了版本检查、被收编了」。
+	# 拿它记账，`peer_disconnected` 时就能分辨「正常离开」还是「被挡在门外」。
+	on_peer_connected.connect(func(nid): _mp8_peers_accepted[nid] = true)
+
+
+# 房主：任何人一连上（**在版本检查之前**）就先报一次自己的版本。
+func _mp8_on_raw_peer_connected(network_id: int) -> void :
+
+	if not multiplayer.is_server() or network_id <= 0 or network_id == get_multiplayer_authority() \
+			or not multiplayer.get_peers().has(network_id) or _mp8_hello_waiting.has(network_id):
+		return
+
+	_mp8_hello_waiting[network_id] = true
+	mp8_hello_rpc.rpc_id(network_id, Globals.game_version)
+
+
+# 房主：peer 断开。若它从没被收编过，说明它是被版本挡下的 —— 这是情形 ④ 的触发点。
+func _mp8_on_raw_peer_disconnected(network_id: int) -> void :
+
+	var theirs: String = String(_mp8_peer_versions.get(network_id, ""))
+	_mp8_peer_versions.erase(network_id)
+	_mp8_hello_waiting.erase(network_id)
+
+	if not multiplayer.is_server():
+		return
+
+	# 正常玩过一场再离开的人：收编过，不是被拒
+	if _mp8_peers_accepted.has(network_id):
+		_mp8_peers_accepted.erase(network_id)
+		return
+
+	# 收编过的名单里没有他 → 他连上了却没进来。ENet/Steam 两个后端里，
+	# 唯一会让人「连上但不收编」的分支就是版本不符那一条。
+	mp8_join_blocked.emit(_mp8_blocked_text_for_host(theirs))
+
+
+@rpc("authority", "call_remote", "reliable")
+func mp8_hello_rpc(full_version: String) -> void :
+	var sender: int = multiplayer.get_remote_sender_id()
+	if multiplayer.is_server() or sender <= 0 or sender != get_multiplayer_authority() \
+			or not multiplayer.get_peers().has(sender) or not _mp8_valid_version(full_version):
+		_mp8_network_reject("hello", sender)
+		return
+	if not _mp8_host_version.is_empty():
+		return
+	_mp8_host_version = full_version
+	mp8_hello_back_rpc.rpc_id(get_multiplayer_authority(), Globals.game_version)
+
+
+@rpc("any_peer", "call_remote", "reliable")
+func mp8_hello_back_rpc(full_version: String) -> void :
+	if not multiplayer.is_server():
+		return
+	var sender: int = multiplayer.get_remote_sender_id()
+	if sender <= 0 or sender == get_multiplayer_authority() or not multiplayer.get_peers().has(sender) \
+			or not _mp8_hello_waiting.has(sender) or not _mp8_valid_version(full_version):
+		_mp8_network_reject("hello-reply", sender)
+		return
+	_mp8_hello_waiting.erase(sender)
+	_mp8_peer_versions[sender] = full_version
+
+
+func _mp8_valid_version(value: String) -> bool :
+	if value.is_empty() or value.length() > 128:
+		return false
+	for i in value.length():
+		var c: int = value.unicode_at(i)
+		if not ((c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c in [43, 45, 46, 95]):
+			return false
+	return true
+
+
+func _mp8_network_reject(event: String, sender: int) -> void :
+	var now: int = Time.get_ticks_msec()
+	if now - _mp8_network_reject_at >= 5000:
+		_mp8_network_reject_at = now
+		print("[MP8-NET] rejected event=%s sender=%d" % [event, sender])
+
+
+# 从完整版本串里拆出 mod 标签（没有就是空串 = 原版）。串长这样：`v2.1.2+overtime-1.5`
+func _mp8_tag_of(full_version: String) -> String:
+	var i: int = full_version.find("+overtime-")
+	return "" if i < 0 else full_version.substr(i + 1)
+
+
+func _mp8_zh() -> bool:
+	return mp8_locale() != "EN"
+
