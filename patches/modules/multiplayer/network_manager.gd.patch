+func mp8_mismatch_text() -> String:
+	var mine: String = Globals.game_version
+	var theirs: String = _mp8_host_version
+	print("[MP8-VERSION] mismatch self=%s host=%s" % [mine, theirs])
+	if theirs.is_empty():
+		return _mp8_text("Host build unreported. Compare versions and sources.\nYou %s; full details in the game log.",
+			"房主未回报版本。请核对完整版本及下载来源。\n您 %s；完整信息见游戏日志。",
+			"房主未回報版本。請核對完整版本及下載來源。\n您 %s；完整資訊見遊戲日誌。") % _mp8_version_brief(mine)
+	if mine == theirs:
+		return _mp8_text("Connection refused; reported builds match.\nCheck the game log and download sources.",
+			"连接被拒，但回报的版本相同。\n请核对游戏日志及下载来源。",
+			"連線被拒，但回報的版本相同。\n請核對遊戲日誌及下載來源。")
+	if not _mp8_tag_of(mine).is_empty() and _mp8_tag_of(mine) == _mp8_tag_of(theirs) and _mp8_base_of(mine) != _mp8_base_of(theirs):
