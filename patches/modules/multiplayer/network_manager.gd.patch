+# 「从哪一版开始，房主会主动回报自己的版本」。
+# 🩸 **发版时手动核对这个数**：它等于本次修复实际发出去的那个版本号，
+# 不会自己跟着 MP8_VERSION_TAG 走。填错只会让情形 ③ 那句话里的数字不准，不影响功能。
+const MP8_HELLO_SINCE: String = "1.6"
+
+
+# "v2.1.2+overtime-1.5" -> "1.5"（没有 tag 就回空串）
+func _mp8_tag_num(full_version: String) -> String:
+	return _mp8_tag_of(full_version).trim_prefix("overtime-")
+
