+func _enter_tree() -> void:
+	_mp8_expand_seats()
+
+# 本地大厅和联机大厅是同一个房间，做法也照搬联机的 _mp8_extend_lobby：
+# 原版 4 个座位的坐姿烘进了各自的 Armature，每位偏移不同，所以一个都不挪；
+# 第 5–8 位是第 1–4 位的副本，整排平移 MP8_LOCAL_ROW2_OFFSET，椅子同样复制一排，摄像机拉远。
+# Exported Node references outside the duplicated subtree need explicit rebinding (especially the dresser).
+func _mp8_expand_seats() -> void:
+	var n: int = local_lobby_player_controls.size()
+	if n >= MAX_PLAYERS:
+		return
+	var control_source = local_lobby_player_controls[0]
+	for seat in range(n, MAX_PLAYERS):
+		var model_source: Node3D = players_node.get_child(seat % n)
+		var assigner_path: NodePath = model_source.get_path_to(local_lobby_player_controls[seat % n].customization_assigner)
+		var model: Node3D = model_source.duplicate(14)
+		model.name = "MP8Player%d" % (seat + 1)
+		_mp8_remap_clone_exports(model_source, model, model_source, model)
+		players_node.add_child(model)
+		model.position = model_source.position + MP8_LOCAL_ROW2_OFFSET
+		var controls = control_source.duplicate(14) as LocalLobbyPlayerControls
+		_mp8_remap_clone_exports(control_source, controls, control_source, controls)
+		controls.customization_assigner = model.get_node(assigner_path)
+		controls.seat_index = seat
+		control_source.get_parent().add_child(controls)
+		local_lobby_player_controls.append(controls)
+	NetworkManager._mp8_clone_chairs(players_node, MP8_LOCAL_ROW2_OFFSET)
+	var cam = players_node.get_parent().get_node_or_null("Camera3D")
+	if cam:
+		cam.position = Vector3(cam.position.x, cam.position.y * 1.08, cam.position.z * 1.22)
+
+# 比联机的 (0.6, 0, 5.2) 更靠前、更居中：按实机截图量过，这个偏移下第二排不挡第一排任何人的头。
+const MP8_LOCAL_ROW2_OFFSET := Vector3(0.2, 0.0, 5.8)
+
+func _mp8_remap_clone_exports(source: Node, copy: Node, source_root: Node, copy_root: Node) -> void:
+	for property in source.get_property_list():
+		if not (int(property.usage) & PROPERTY_USAGE_SCRIPT_VARIABLE):
+			continue
+		var value = source.get(property.name)
+		if value is Node and (value == source_root or source_root.is_ancestor_of(value)):
+			copy.set(property.name, copy_root.get_node(source_root.get_path_to(value)))
+		elif value is Array:
+			var rebound: Array = value.duplicate()
+			for i in rebound.size():
+				if rebound[i] is Node and (rebound[i] == source_root or source_root.is_ancestor_of(rebound[i])):
+					rebound[i] = copy_root.get_node(source_root.get_path_to(rebound[i]))
+			copy.set(property.name, rebound)
+	for i in source.get_child_count():
+		_mp8_remap_clone_exports(source.get_child(i), copy.get_child(i), source_root, copy_root)
+
