+# Shared session state calls this before changing round counters. This is a
+# local lifecycle guard only; no votes, peer IDs or restart snapshots involved.
+func mp8_claim_round_finish(instance_id: int, epoch: int) -> bool:
+	if not is_instance_valid(minigame) or epoch != _mp8_round_epoch:
+		return false
+	if instance_id != minigame.get_instance_id() or _mp8_finish_claimed:
+		return false
+	_mp8_finish_claimed = true
+	return true
+
 func _on_minigame_player_scored(_network_id: int, _score: int):
-	round_score_by_network_id[_network_id] += (_score * score_multiplier)
+	if _mp8_round_committed or not round_score_by_network_id.has(_network_id):
+		return
+	round_score_by_network_id[_network_id] += int(_score * score_multiplier * _mp8_score_scale())
 
 func _on_minigame_player_score_finalized(player_scores):
+	if _mp8_round_committed or _mp8_final_scores_received:
+		return
+	_mp8_final_scores_received = true
 
 	for network_id in player_scores.keys():
 		if round_score_by_network_id.has(network_id):
-			round_score_by_network_id[network_id] += player_scores[network_id] * score_multiplier
+			round_score_by_network_id[network_id] += int(player_scores[network_id] * score_multiplier * _mp8_score_scale())
+
+func _mp8_score_scale() -> float:
+	var identifier = Globals.current_minigame_identifier
+	var by_count: Dictionary = MP8_MINIGAME_SCORE_SCALE_BY_COUNT.get(identifier, {})
+	return float(by_count.get(PlayerManager.player_presences.size(), MP8_MINIGAME_SCORE_SCALE.get(identifier, 1.0)))
+
+func _mp8_create_device_status() -> void:
+	var canvas: CanvasLayer = CanvasLayer.new()
+	canvas.layer = 80
+	add_child(canvas)
+	var column: VBoxContainer = VBoxContainer.new()
+	column.position = Vector2(8, 8)
+	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	canvas.add_child(column)
+	for presence in PlayerManager.player_presences.values():
+		var label: Label = Label.new()
+		label.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		label.add_theme_font_override("font", load("res://fonts/Terminal F4.ttf"))
+		label.add_theme_font_size_override("font_size", 18)
+		label.add_theme_color_override("font_outline_color", Color.BLACK)
+		label.add_theme_constant_override("outline_size", 4)
+		column.add_child(label)
+		_mp8_device_labels[presence.device_id] = label
+	_mp8_update_device_status()
+
+func _process(_delta: float) -> void:
+	_mp8_update_device_status()
+
+func _mp8_update_device_status() -> void:
+	for device in _mp8_device_labels:
+		if not PlayerManager.player_presences.has(device):
+			continue
+		var presence = PlayerManager.player_presences[device]
+		var label: Label = _mp8_device_labels[device]
+		label.text = presence.mp8_local_status_text()
+		label.modulate = Color.WHITE if presence.local_controller_connected else Color(1.0, 0.55, 0.2)
 
