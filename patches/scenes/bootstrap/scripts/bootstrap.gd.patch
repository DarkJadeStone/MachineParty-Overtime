 func check_debug_tools_launch(command_line_arguments):
@@ -36,8 +39,49 @@ func check_debug_tools_launch(command_line_arguments):
 	for arg in command_line_arguments:
 		if arg == "-debug-tools":
 			Globals.allow_singleplayer = true
+			Globals.debug = true  # [MP8] 新增：触发上面的调试大厅路由
 			Globals.enable_debug_tools()
 
+		# [MP8] 自动化测试快进开关。
+		#
+		# 铁律：**只允许跳小游戏之外的过场，绝不碰小游戏内部的时序。**
+		# 下面两项都发生在小游戏开始之前，安全：
+		#   skipping_intro_cutscene → 整局开场动画
+		#   debug_instant_start     → 抽签环节的过场动画（intermission_cutscene_intro）
+		#
+		# ⚠️ 以下两项都试过、都翻车了（2026-08-14），别再加回来：
+		#
+		# ① debug_skip_intermission —— 服务器跳过抽签直接 load_minigame()，
+		#    客户端还没建好节点，RPC 先到被整条丢弃。
+		#    实测 recv_nodes 未授权报错 352 条（关掉后 0 条）。
+		#
+		# ② debug_skip_brief —— 跳掉赛前说明和倒计时，把 start_pattern() 提前。
+		#    disco_dodge 的每块砖在 set_data_rpc() 里有个"7 秒后随机换显示符号
+		#    但不更新 symbol_index"的定时器（原版自带的显示/索引双状态隐患）。
+		#    正常流程里说明+倒计时远超 7 秒，这批定时器早就跑完；跳掉之后
+		#    start_pattern() 先把符号设对，7 秒定时器随后才炸、把显示改成随机符号，
+		#    于是显示与判定脱钩：**该塌的不塌，不该塌的反而塌**。
+		#    这个症状极像"8 人把小游戏玩坏了"，实际跟人数毫无关系。
+		if arg == "mp8fast":
+			Globals.debug_instant_start = true
+			Globals.skipping_intro_cutscene = true
+			print("[MP8] mp8fast：只跳小游戏之外的过场（不碰局内时序）")
+
+		# [MP8] 只跳开场动画，**一点时序都不碰**（`play.ps1 -Clean` 用这个）。
+		#
+		# `mp8fast` 其实绑了两样东西，可以拆开：
+		#   `skipping_intro_cutscene` → 跳整局开场动画。这是**游戏自带的正常选项**，
+		#       大厅里就有"跳过开场"的按钮（`lobby_scene.gd:331`），不是调试 hack，真人也常关掉。
+		#   `debug_instant_start` → 还会跳抽签过场里的 `set_intermission_viewport_screen(true)`
+		#       和 1 秒等待，**压缩了局内前置时序**（坑第 20 条：实测一局多出
+		#       320 条 recv_nodes 未授权报错）。
+		#
+		# 判断"好不好玩 / 正不正常"时只想要前者：既不用每局看一遍开场动画，
+		# 又不至于让快进开关造出假 bug。
+		if arg == "mp8skipintro":
+			Globals.skipping_intro_cutscene = true
+			print("[MP8] mp8skipintro：跳开场动画，局内时序与真人一致")
