+func _mp8_make_crate(seat_idx: int, seat_pos: Vector3) -> void :
+
+	# 只给点名的那几个座位放箱子
+	if not MP8_CRATE_SEATS.has(seat_idx):
+		return
+
+	var src: Node3D = get_node_or_null(MP8_CRATE_PATH) as Node3D
+	if src == null:
+		push_warning("[MP8] 吸烟小憩：找不到木箱 %s，座位 %d 没有箱子" % [MP8_CRATE_PATH, seat_idx + 1])
+		return
+
+	var dup: Node3D = src.duplicate()
+	dup.name = "MP8Crate%d" % seat_idx
+	src.get_parent().add_child(dup)
