+
+func _mp8_load_seats() -> Array :
+	# ⚠️ 没有存盘文件时**不是**回退到"弧上插空"，而是回退到定稿表 MP8_SEATS_BAKED。
+	# 客机永远走这条 —— 存盘文件只在房主机器上。要纯自动布局请传 mp8smokenofile。
+	if not FileAccess.file_exists(MP8_SEAT_FILE):
+		return _mp8_baked_seats()
+	var f := FileAccess.open(MP8_SEAT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] 吸烟小憩：打不开 %s，用内置定稿表" % MP8_SEAT_FILE)
+		return _mp8_baked_seats()
+	var rows: Array = []
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var c: PackedStringArray = line.split(",", false)
+		if c.size() < 3:
+			continue
+		var sx: String = c[0].strip_edges()
+		var sz: String = c[1].strip_edges()
+		var sy: String = c[2].strip_edges()
+		if not (sx.is_valid_float() and sz.is_valid_float() and sy.is_valid_float()):
+			continue
+		# 第 4 列（有没有木箱）是后加的，老文件没有就默认有
+		var has: bool = true
+		if c.size() >= 4 and c[3].strip_edges().is_valid_int():
+			has = (int(c[3].strip_edges()) != 0)
+		var row := {"pos": Vector2(float(sx), float(sz)), "yaw": float(sy), "crate": has}
+		# 第 5~8 列是**手调过的箱子位置**（x, y, z, yaw）。有就用，没有就走自动偏移。
+		if c.size() >= 8:
+			var cx: String = c[4].strip_edges()
+			var cy: String = c[5].strip_edges()
+			var cz: String = c[6].strip_edges()
+			var cw: String = c[7].strip_edges()
+			if cx.is_valid_float() and cy.is_valid_float() and cz.is_valid_float() and cw.is_valid_float():
+				row["crate_pos"] = Vector3(float(cx), float(cy), float(cz))
+				row["crate_yaw"] = float(cw)
+		rows.append(row)
+	f.close()
+
+	_mp8_seat_src = "存盘文件 %s" % MP8_SEAT_FILE
+
+	# ⚠️ 格式变过一次：老版本只存**新增的 4 个**座位，新版本存**全部 8 个**。
+	# 行数不到 8 行的一律当老文件丢掉 —— 拿 4 行去填 8 个座位会整体错位，
+	# 那种错位在画面上看着像"座位乱跳"，很难联想到是文件格式。
+	if rows.size() > 0 and rows.size() < MP8_MAX_PLAYERS:
+		push_warning("[MP8] 吸烟小憩：%s 只有 %d 行（旧格式，现在要 8 行），已忽略，用内置定稿表" % [
+			MP8_SEAT_FILE, rows.size()
+		])
+		print("[MP8] 吸烟小憩：座位文件是旧格式（%d 行），已忽略。重新摆一遍按 0 存盘即可覆盖。" % rows.size())
+		return _mp8_baked_seats()
+
+	if rows.is_empty():
+		# 文件在但一行有效数据都没有（被清空 / 全是注释）→ 也走定稿表，
+		# 不能掉回"弧上插空"：那样这台机器又和别人不一样了。
+		push_warning("[MP8] 吸烟小憩：%s 里没有有效行，用内置定稿表" % MP8_SEAT_FILE)
+		return _mp8_baked_seats()
+
+	return rows
+
+
+# [MP8] 定稿表 → 和 _mp8_load_seats() 一模一样的行结构。
+# **客机走的就是这条**（它们没有房主那份存盘文件），所以这张表必须与房主的文件一致。
+func _mp8_baked_seats() -> Array :
+
+	_mp8_seat_src = "内置定稿表 MP8_SEATS_BAKED"
+	var rows: Array = []
+	for r in MP8_SEATS_BAKED:
+		var row := {"pos": r[0] as Vector2, "yaw": float(r[1]), "crate": bool(r[2])}
+		if r[3] != null:
+			row["crate_pos"] = r[3] as Vector3
+			row["crate_yaw"] = float(r[4])
+		rows.append(row)
+	return rows
+
+
+func _mp8_save_seats() -> bool :
+	var f := FileAccess.open(MP8_SEAT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] 吸烟小憩：写不了 %s" % MP8_SEAT_FILE)
+		return false
+	f.store_line("# 吸烟小憩（mp8game=4）座位表 —— **8 行，座位 1~8 各一行**")
+	f.store_line("# 每行 = x, z, yaw(度), 有没有木箱(1/0)")
+	f.store_line("# ⚠️ 只在 5 人及以上生效；≤4 人一律用原版那 4 个座位，一个字节不动。")
+	f.store_line("# ⚠️ 左轮转角是从坐标算的，只在原版四个座位的角度跨度内可靠：")
+	f.store_line("#    算出来要落在 %.0f° ~ %.0f° 之间，出了这个范围枪会瞄不准（编辑器里报黄灯）。" % [
+		MP8_AIM_MIN, MP8_AIM_MAX])
+	f.store_line("# 木箱只有新增座位才有（原版四个坐的是场景美术，删不掉也加不上）。")
+	f.store_line("# 删掉这个文件 = 回到内置的「弧上插空」。")
+	f.store_line("# 存于 %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for i in player_spawn_positions.size():
+		var n: Node3D = player_spawn_positions[i]
+		var crate = _mp8_crates.get(i)
+		var has: int = 0
+		var line: String = "%.2f, %.2f, %.1f" % [
+			n.global_position.x, n.global_position.z, rad_to_deg(n.global_rotation.y)
+		]
+		if crate != null and is_instance_valid(crate) and (crate as Node3D).visible:
+			has = 1
+			var c3: Node3D = crate
+			# 箱子的**绝对位置**也一起存（含高度）—— 它是手调的，
+			# 不能靠"座位 + 固定偏移"反算，否则下次开局又回到自动位置
+			line += ", 1, %.2f, %.2f, %.2f, %.1f" % [
+				c3.global_position.x, c3.global_position.y, c3.global_position.z,
+				rad_to_deg(c3.global_rotation.y)
+			]
+		else:
+			line += ", %d" % has
+		f.store_line(line)
+	f.close()
+	print("[MP8] 吸烟小憩：座位已存盘 → %s" % ProjectSettings.globalize_path(MP8_SEAT_FILE))
+	return true
+
+
+# ---- 局内手调（mp8smokeedit / play.ps1 -SmokeEdit）----
+
+func _mp8_edit_begin() -> void :
+
+	if player_spawn_positions.size() <= 4:
+		_mp8_edit_on = false
+		return
+
+	var lbl := Label.new()
+	lbl.name = "MP8SmokeEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -150.0
+	lbl.offset_right = 980.0
+	lbl.offset_bottom = -8.0
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 20)
+	lbl.add_theme_color_override("font_color", Color(0.6, 0.95, 1.0))
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+	_mp8_edit_canvas.add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	# 每个座位头顶挂号码牌 —— 座位是 Marker3D，看不见的
+	for i in player_spawn_positions.size():
+		var tag := Label3D.new()
+		tag.name = "MP8SeatTag"
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 90
+		tag.outline_size = 20
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true
+		if f != null:
+			tag.font = f
+		player_spawn_positions[i].add_child(tag)
+		tag.position = Vector3(0.0, 1.6, 0.0)
+		_mp8_tags.append(tag)
+
+	_mp8_edit_sel = 4
+	# 一开就先把倒计时冻住，给足摆位时间；按 P 放行
+	mp8_edit_paused = true
+	_mp8_edit_refresh()
+	print("[MP8] 吸烟小憩：座位手调已开 —— 可调 %d~%d（原版 0~3 锁死），回合倒计时已暂停（P 键继续）" % [
+		4, player_spawn_positions.size() - 1
+	])
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or player_spawn_positions.size() <= 4:
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+	var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+
+	match key.keycode:
+		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8:
+			# [MP8] 数字 1~8 对应座位下标 0~7，**面板和头顶牌子也一律显示 1~8**。
+			# 之前是"按键 5~8 → 牌子写 4~7"，错位一格，用户已经被坑过一次。
+			var want: int = key.keycode - KEY_1
+			if want >= player_spawn_positions.size():
+				return
+			_mp8_edit_sel = want
+			_mp8_edit_refresh()
+
+		KEY_X:
+			# 删掉/恢复当前座位的木箱（用户 2026-08-17：有的座位不要箱子）
+			mp8_toggle_crate_rpc.rpc(_mp8_edit_sel)
+
+		KEY_C:
+			# 切换 I/K/J/L 挪谁：座位（连人）还是那个座位的木箱
+			var cr0 = _mp8_crates.get(_mp8_edit_sel)
+			if cr0 == null or not is_instance_valid(cr0):
+				print("[MP8] 吸烟小憩：座位 %d 没有木箱，切不过去" % (_mp8_edit_sel + 1))
+				return
+			_mp8_edit_crate = not _mp8_edit_crate
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			var dir: Vector2 = _mp8_screen_axis(key.keycode)
+			if dir == Vector2.ZERO:
+				return
+			if _mp8_edit_crate:
+				var cr1 = _mp8_crates.get(_mp8_edit_sel)
+				if cr1 == null or not is_instance_valid(cr1):
+					return
+				var cp := (cr1 as Node3D).global_position
+				mp8_move_crate_rpc.rpc(_mp8_edit_sel,
+					Vector3(cp.x + dir.y * step, cp.y, cp.z + dir.x * step),
+					rad_to_deg((cr1 as Node3D).global_rotation.y))
+			else:
+				var p := n.global_position
+				mp8_move_seat_rpc.rpc(_mp8_edit_sel,
+					Vector2(p.x + dir.y * step, p.z + dir.x * step),
+					rad_to_deg(n.global_rotation.y))
+
+		KEY_U, KEY_O:
+			var d: float = (-15.0 if key.keycode == KEY_U else 15.0)
+			if _mp8_edit_crate:
+				var cr2 = _mp8_crates.get(_mp8_edit_sel)
+				if cr2 == null or not is_instance_valid(cr2):
+					return
+				mp8_move_crate_rpc.rpc(_mp8_edit_sel,
+					(cr2 as Node3D).global_position,
+					rad_to_deg((cr2 as Node3D).global_rotation.y) + d)
+			else:
+				mp8_move_seat_rpc.rpc(_mp8_edit_sel,
+					Vector2(n.global_position.x, n.global_position.z),
+					rad_to_deg(n.global_rotation.y) + d)
+
+		KEY_Y:
+			# 箱子高低（原版箱子是坐在地上的，重排座位后可能需要抬一点）
+			if not _mp8_edit_crate:
+				return
+			var cr3 = _mp8_crates.get(_mp8_edit_sel)
+			if cr3 == null or not is_instance_valid(cr3):
+				return
+			var q := (cr3 as Node3D).global_position
+			mp8_move_crate_rpc.rpc(_mp8_edit_sel,
+				Vector3(q.x, q.y + (step if key.shift_pressed else - step), q.z),
+				rad_to_deg((cr3 as Node3D).global_rotation.y))
+
+		KEY_M:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_P:
+			# 倒计时暂停/继续。⚠️ 必须走 RPC：计时循环只在**服务器**上跑，
+			# 改本地标志对它毫无影响（残骸平台落石那条坑同一个形状）。
+			mp8_set_pause_rpc.rpc(not mp8_edit_paused)
+
+		KEY_0:
+			var ok: bool = _mp8_save_seats()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("【已存盘】下次开局自动用这套座位\n" if ok
+					else "【存盘失败】看日志\n") + _mp8_edit_panel.text
+
+		KEY_N:
+			var parts := PackedStringArray()
+			for i in range(4, player_spawn_positions.size()):
+				var q := player_spawn_positions[i].global_position
+				parts.append("座位%d(%.2f,%.2f) 转角%.1f°" % [
+					i, q.x, q.z, _mp8_aim_for(q)])
+			print("[MP8] 吸烟小憩座位报告：%s" % " | ".join(parts))
+
+		_:
+			return
+
+	get_viewport().set_input_as_handled()
+
+
+func _mp8_screen_axis(code: int) -> Vector2 :
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector2.ZERO
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var r2 := Vector2(right.x, right.z)
+	var f2 := Vector2(fwd.x, fwd.z)
+	if r2.length() < 0.001 or f2.length() < 0.001:
+		return Vector2.ZERO
+	r2 = r2.normalized()
+	f2 = f2.normalized()
+	match code:
+		KEY_L: return Vector2(r2.y, r2.x)
+		KEY_J: return - Vector2(r2.y, r2.x)
+		KEY_I: return Vector2(f2.y, f2.x)
+		KEY_K: return - Vector2(f2.y, f2.x)
+	return Vector2.ZERO
+
+
+# [MP8] any_peer + call_local：8 台机器一起挪（座位标记、木箱、号码牌都是各机本地节点）。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_move_seat_rpc(slot: int, pos: Vector2, yaw_deg: float) -> void :
+
+	# [MP8] 用户 2026-08-17 改判：**八个座位的位置和朝向都可以调**（原来只放开 4~7）。
+	# ≤4 人时这套自定义布局整段不跑，所以"4 人局与原版一致"仍然成立 —— 靠的是
+	# `_mp8_setup_seats()` 里那条人数判断，不再靠"锁死原版座位"。
+	if slot < 0 or slot >= player_spawn_positions.size():
+		return
+	var n: Node3D = player_spawn_positions[slot]
+	if n == null or not is_instance_valid(n):
+		return
+
+	var old: Vector3 = n.global_position
+	n.global_position = Vector3(pos.x, old.y, pos.y)
+	n.global_rotation = Vector3(0.0, deg_to_rad(yaw_deg), 0.0)
+
+	# ⚠️ **木箱不跟着走**（用户 2026-08-17 定：箱子位置固定，人自己往箱子上摆）。
+	# 原来是挪座位带着箱子一起动，现在箱子建好就钉死。
+
+	# [MP8] 让**坐在这个座位上的人**跟着一起挪 —— 光看一个号码牌摆不准，
+	# 要看见人坐过去才知道挤不挤、朝向对不对（用户 2026-08-17 要求）。
+	#
+	# ⚠️ 只有服务器发这一步：`setup_rpc` 本身是 RPC，
+	# 在广播 RPC 的处理函数里再发一次，8 台机器会各广播一遍（风暴）。
+	if multiplayer.is_server():
+		for p in players_node_parent.get_children():
+			if not (p is SmokeBreakPlayer):
+				continue
+			if (p as SmokeBreakPlayer).active_player_seat_index != slot:
+				continue
+			p.setup_rpc.rpc(
+				n.global_position, n.global_rotation, slot,
+				(mp8_death_anim_by_seat[slot] if slot < mp8_death_anim_by_seat.size() else "")
+			)
+			break
+
+	# 转角跟着重算，并交回推车
+	var trolley: Node = _mp8_find_trolley()
+	if trolley != null:
+		var rots = trolley.get("rot_by_seat_index_array")
+		if rots is Array and slot < (rots as Array).size():
+			var arr: Array[Vector3] = []
+			for r in (rots as Array):
+				arr.append(r as Vector3)
+			arr[slot] = Vector3(_mp8_aim_for(n.global_position), 0.0, 0.0)
+			trolley.set("rot_by_seat_index_array", arr)
+
+	_mp8_edit_refresh()
+
+
+# [MP8] 挪某个座位的木箱（位置 + 朝向）。箱子是各机本地的场景节点，所以广播到每台。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_move_crate_rpc(slot: int, pos: Vector3, yaw_deg: float) -> void :
+
+	var crate = _mp8_crates.get(slot)
+	if crate == null or not is_instance_valid(crate):
+		return
+	(crate as Node3D).global_position = pos
+	(crate as Node3D).global_rotation = Vector3(0.0, deg_to_rad(yaw_deg), 0.0)
+	_mp8_edit_refresh()
+
+
+# [MP8] 删/恢复某个座位的木箱。箱子是各机本地的场景节点，所以广播到每台。
+# 用 visible 而不是 queue_free：这样能来回切，摆错了不用重开一局。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_toggle_crate_rpc(slot: int) -> void :
+
+	var crate = _mp8_crates.get(slot)
+	if crate == null or not is_instance_valid(crate):
+		print("[MP8] 吸烟小憩：座位 %d 本来就没有木箱（原版座位坐的是场景美术）" % (slot + 1))
+		_mp8_edit_refresh()
+		return
+
+	(crate as Node3D).visible = not (crate as Node3D).visible
+	print("[MP8] 吸烟小憩：座位 %d 的木箱 %s" % [
+		slot + 1, ("显示" if (crate as Node3D).visible else "隐藏")
+	])
+	_mp8_edit_refresh()
+
+
+# [MP8] 暂停/继续回合倒计时。计时循环在服务器上，所以广播到每台（call_local）。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_set_pause_rpc(paused: bool) -> void :
+	mp8_edit_paused = paused
+	_mp8_edit_refresh()
+	print("[MP8] 吸烟小憩：回合倒计时 %s" % ("已暂停" if paused else "继续"))
+
+
+func _mp8_edit_refresh() -> void :
+
+	for i in _mp8_tags.size():
+		var t: Label3D = _mp8_tags[i]
+		if t == null or not is_instance_valid(t):
+			continue
+		# [MP8] 一律显示 1~8，和按键 1~8 对上（之前牌子 0~7、按键 5~8，错位一格）
+		var sel: bool = (i == _mp8_edit_sel)
+		t.text = ("▼%d▼" % (i + 1)) if sel else str(i + 1)
+		t.modulate = (Color(1.0, 0.85, 0.2) if sel else Color(0.55, 0.75, 0.85))
+
+	if _mp8_edit_panel == null:
+		return
+
+	var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+	var p := n.global_position
+	var aim: float = _mp8_aim_for(p)
+	var ok: bool = _mp8_aim_ok(aim)
+
+	# 离最近的另一个座位多远（"太挤"就是这个数太小）
+	var gap: float = INF
+	for i in player_spawn_positions.size():
+		if i == _mp8_edit_sel:
+			continue
