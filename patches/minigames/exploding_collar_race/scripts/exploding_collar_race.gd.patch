+# 与其赌 I/J/K/L/M/N 没被占，不如开局把 InputMap 查一遍，撞了就报出来
+func _mp8_check_keys() -> void :
+
+	var mine: Dictionary = {
+		KEY_1: "选1", KEY_2: "选2", KEY_3: "选3", KEY_4: "选4",
+		KEY_5: "选5", KEY_6: "选6", KEY_7: "选7", KEY_8: "选8",
+		KEY_I: "远", KEY_K: "近", KEY_J: "左", KEY_L: "右",
+		KEY_M: "步长", KEY_N: "报告", KEY_0: "存盘", KEY_9: "复位",
+	}
+	var clash := PackedStringArray()
+	for action in InputMap.get_actions():
+		for ev in InputMap.action_get_events(action):
+			var k := ev as InputEventKey
+			if k == null:
+				continue
+			for code in [k.keycode, k.physical_keycode]:
+				if code != 0 and mine.has(code):
+					clash.append("%s(%s)↔%s" % [
+						OS.get_keycode_string(code), mine[code], String(action)
+					])
+	if clash.is_empty():
+		print("[MP8] 雷区：手调按键与游戏 InputMap 无冲突（查了 %d 个动作）" % InputMap.get_actions().size())
+	else:
+		print("[MP8] 雷区：⚠️ 按键撞车 —— %s" % ", ".join(clash))
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or player_spawn_positions.is_empty():
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+
+	match key.keycode:
+		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8:
+			var want: int = key.keycode - KEY_1
+			if want >= player_spawn_positions.size():
+				return
+			_mp8_edit_sel = want
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			# 按**屏幕方向**推。相机朝 -Z 看，所以屏幕左右就是世界 x；
+			# 但方向从相机基向量实时算，不写死 —— 相机哪天改了也不会反向。
+			var dir: Vector2 = _mp8_screen_axis(key.keycode)
+			if dir == Vector2.ZERO:
+				return
+			var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+			var cur := Vector2(n.global_position.x, n.global_position.z)
+			mp8_move_spawn_rpc.rpc(_mp8_edit_sel, cur + Vector2(dir.y, dir.x) * step)
+
+		KEY_M:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_0:
+			var ok: bool = _mp8_save_spawns()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("【已存盘】下次开局自动用这套坐标\n" if ok
+					else "【存盘失败】看日志\n") + _mp8_edit_panel.text
+
+		KEY_9:
+			var d: Array = _mp8_default_spawns(player_spawn_positions.size())
+			for i in mini(d.size(), player_spawn_positions.size()):
+				mp8_move_spawn_rpc.rpc(i, d[i])
+			print("[MP8] 雷区：出生点已复位成内置默认（存盘文件没删，要彻底回退请删文件）")
+
+		KEY_N:
+			print("[MP8] 雷区出生点报告：%s" % _mp8_spawn_desc())
+
+		_:
+			return
+
+	get_viewport().set_input_as_handled()
+
+
+# 屏幕方向 → 世界水平方向。返回 Vector2(dx, dz)。
+func _mp8_screen_axis(code: int) -> Vector2 :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector2.ZERO
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var r2 := Vector2(right.x, right.z)
+	var f2 := Vector2(fwd.x, fwd.z)
+	if r2.length() < 0.001 or f2.length() < 0.001:
+		return Vector2.ZERO
+	r2 = r2.normalized()
+	f2 = f2.normalized()
+	match code:
+		KEY_L: return Vector2(r2.y, r2.x)
+		KEY_J: return - Vector2(r2.y, r2.x)
+		KEY_I: return Vector2(f2.y, f2.x)
+		KEY_K: return - Vector2(f2.y, f2.x)
+	return Vector2.ZERO
+
+
+# [MP8] any_peer + call_local：8 台机器一起挪。
+# 出生点本身只有服务器读，但**号码牌和站在上面的人**每台机器都要看得见，所以广播。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_move_spawn_rpc(slot: int, pos: Vector2) -> void :
+
+	if slot < 0 or slot >= player_spawn_positions.size():
+		return
+	var n: Node3D = player_spawn_positions[slot]
+	if n == null or not is_instance_valid(n):
+		return
+
+	var p: Vector2 = _mp8_clamp(pos)
+	n.global_position = Vector3(p.x, n.global_position.y, p.y)
+
+	# 把站在这个点上的人一起挪过去 —— 看得见才好摆。
+	# （出生点是 shuffle 分配的，所以按**节点对象**查，不能按下标。）
+	#
+	# ⚠️ 两条都必须守住：
+	#  ① 只有服务器动人。`_mp8_owner` 只在 spawn_players()（服务器）里填过，
+	#     客户端那份是空的；而且**在广播 RPC 的处理函数里再发一次 RPC**，
+	#     8 台机器会各广播一遍，直接变成风暴。
+	#  ② 走原版的 `teleport_rpc` 而不是直接写 global_position ——
+	#     直接写只在本机生效，别人看到的人还在原地。
+	if multiplayer.is_server():
+		var who = _mp8_owner.get(n)
+		if who != null and is_instance_valid(who):
+			who.teleport_rpc.rpc(Vector3(p.x, (who as Node3D).global_position.y, p.y))
+
+	_mp8_edit_refresh()
+
+
+func _mp8_edit_refresh() -> void :
+
+	for i in _mp8_tags.size():
+		var t: Label3D = _mp8_tags[i]
+		if t == null or not is_instance_valid(t):
+			continue
+		var sel: bool = (i == _mp8_edit_sel)
+		t.text = ("▼%d▼" % (i + 1)) if sel else str(i + 1)
+		t.modulate = (Color(1.0, 0.85, 0.2) if sel else Color(0.55, 0.75, 0.85))
+
+	if _mp8_edit_panel == null:
+		return
+
+	var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+	var cur := Vector2(n.global_position.x, n.global_position.z)
+
+	# 离最近的另一个出生点多远（太近会挤在一起）
+	var gap: float = INF
+	for i in player_spawn_positions.size():
+		if i == _mp8_edit_sel:
+			continue
+		var o: Node3D = player_spawn_positions[i]
+		if o == null or not is_instance_valid(o):
+			continue
+		gap = minf(gap, cur.distance_to(Vector2(o.global_position.x, o.global_position.z)))
+
+	_mp8_edit_panel.text = "\n".join([
+		"【出生点手调】选中第 %d 个 / 共 %d   步长 %.1f 米   来源 %s" % [
+			_mp8_edit_sel + 1, player_spawn_positions.size(),
+			MP8_EDIT_STEPS[_mp8_edit_step_i], _mp8_layout_src],
+		"位置 x=%.2f  z=%.2f      离最近的点 %.2f 米 %s" % [
+			cur.x, cur.y, gap, ("✓" if gap >= 1.5 else "⚠挤")],
+		"可摆范围 x∈[%.1f,%.1f] z∈[%.1f,%.1f]（走廊已拉宽 ×%.2f；z=-10 起是雷区，z=+10 是落后判死区）" % [
+			MP8_SPAWN_BOX_MIN.x * _mp8_wide, MP8_SPAWN_BOX_MAX.x * _mp8_wide,
+			MP8_SPAWN_BOX_MIN.y, MP8_SPAWN_BOX_MAX.y, _mp8_wide],
+		"1~8 选点   I/K 远近   J/L 左右   M 步长   0 存盘   9 复位   N 报告",
+	])
+
