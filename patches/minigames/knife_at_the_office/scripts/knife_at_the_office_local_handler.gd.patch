+# One normalized layout drives textures, HUD, viewport sizes and pointer mapping.
+static func mp8_layout(count: int) -> Array[Rect2]:
+	var result: Array[Rect2] = []
+	if count <= 0:
+		return result
+	count = mini(count, 8)
+	if count <= 4:
+		for pair in Layouts[count]:
+			result.append(Rect2(pair[0], pair[1]))
+		return result
+	var columns: int = 3 if count <= 6 else 4
+	for i in count:
+		result.append(Rect2(Vector2(float(i % columns) / columns, float(i / columns) / 2.0),
+			Vector2(1.0 / columns, 0.5)))
+	return result
+
+static func mp8_pixel_rect(rect: Rect2, canvas_size: Vector2) -> Rect2:
+	var first := (rect.position * canvas_size).floor()
+	var last := (rect.end * canvas_size).floor()
+	return Rect2(first, (last - first).max(Vector2.ONE))
+
+static func mp8_screen_to_view(point: Vector2, screen_rect: Rect2, viewport_size: Vector2) -> Vector2:
+	if screen_rect.size.x <= 0 or screen_rect.size.y <= 0 or not screen_rect.has_point(point):
+		return Vector2(-1, -1)
+	return (point - screen_rect.position) / screen_rect.size * viewport_size
+
+func _mp8_seat(player) -> int:
+	var fallback: int = maxi(0, PlayerManager.player_presences.keys().find(player.player_presence.network_id))
+	return int(player.player_presence.get_meta("mp8_local_seat", fallback))
+
+func _mp8_player_tag(player) -> String:
+	var device: String = "Pad" if player.player_presence.using_joystick else "KB"
+	return "P%d · %s · %s" % [_mp8_seat(player) + 1, player.player_presence.network_name, device]
+
+func _ready() -> void:
+	get_viewport().size_changed.connect(_mp8_relayout)
+	if is_instance_valid(local_canvas_root):
+		local_canvas_root.resized.connect(_mp8_relayout)
+
+func _mp8_relayout() -> void:
+	if _mp8_players.is_empty() or not is_instance_valid(local_canvas_root):
+		return
+	var canvas_size: Vector2 = local_canvas_root.size
+	if canvas_size.x <= 0 or canvas_size.y <= 0:
+		canvas_size = local_canvas_root.get_viewport_rect().size
+	var layout := mp8_layout(_mp8_players.size())
+	for i in _mp8_players.size():
+		var player = _mp8_players[i]
+		if not is_instance_valid(player):
+			continue
+		var rect := mp8_pixel_rect(layout[i], canvas_size)
+		var display: TextureRect = texture_rects[i]
+		display.position = rect.position
+		display.size = rect.size
+		player.local_viewport.size = Vector2i(rect.size)
+		var transform := display.get_global_transform_with_canvas()
+		player.local_viewport.set_meta("mp8_input_rect",
+			Rect2(transform * Vector2.ZERO, (transform * rect.size) - (transform * Vector2.ZERO)))
+		_mp8_place_overlay(player, rect)
+
+func _mp8_place_overlay(player, rect: Rect2) -> void:
+	var overlay = vignette_color_rects[player]
+	overlay.position = rect.position
+	overlay.size = rect.size
+	var tag: Label = overlay.get_child(0)
+	tag.size.x = maxf(1.0, rect.size.x - 16.0)
+	tag.clip_text = true
+
+func _mp8_clear_views() -> void:
+	for display in texture_rects:
+		if is_instance_valid(display):
+			display.get_parent().remove_child(display)
+			display.queue_free()
+	texture_rects.clear()
+	for overlay in vignette_color_rects.values():
+		if is_instance_valid(overlay):
+			overlay.get_parent().remove_child(overlay)
+			overlay.queue_free()
+	vignette_color_rects.clear()
+	_mp8_players.clear()
+	_mp8_tags.clear()
