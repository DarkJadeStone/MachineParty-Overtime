+		print("[MP8] 内部暗手：出生点 %d → %d，**用存盘文件** %s" % [
+			n, all_now.size(), ProjectSettings.globalize_path(MP8_SPAWN_FILE)])
+		_mp8_spawn_markers = all_now
+		return
+
+	if saved.size() > 0:
+		print("[MP8] 内部暗手：存盘文件只有 %d 行（要 %d），已忽略，用内置算法" % [saved.size(), want])
+
+	var origin_points: Array[Vector3] = []
+	for m in originals:
+		origin_points.append((m as Node3D).position)
+
+	var extras: Array[Vector3] = _mp8_spread_inside(origin_points, want)
+
+	for i in extras.size():
+		var extra: Node3D = (originals[0] as Node3D).duplicate()
+		extra.name = "MP8Spawn%d" % i
+		player_spawn_positions_node.add_child(extra)
+		extra.position = extras[i]
+		added.append(extra)
+
+	# 自证：把最小间距算出来打进日志。摆位改动必须能对着数字核，不能只说"摆好了"。
+	var all_points: Array = originals + added
+	var min_gap: float = INF
+	var min_pair: String = ""
+	for i in all_points.size():
+		for j in range(i + 1, all_points.size()):
+			var d: float = (all_points[i] as Node3D).position.distance_to((all_points[j] as Node3D).position)
+			if d < min_gap:
+				min_gap = d
+				min_pair = "%s↔%s" % [all_points[i].name, all_points[j].name]
+
+	var parts: Array = []
+	for m in added:
+		parts.append("%s(%.2f,%.2f)" % [m.name, (m as Node3D).position.x, (m as Node3D).position.z])
+
+	print("[MP8] 内部暗手：%d 人 —— 出生点 %d → %d，最小间距 %.2f 米（%s）；新增 %s" % [
+		mp8_player_count, n, all_points.size(), min_gap, min_pair, ", ".join(parts)])
+
+	if min_gap < MP8_MIN_SPAWN_GAP:
+		push_warning("[MP8] 内部暗手：最小间距 %.2f 米 < %.2f，可能有人叠着生成" % [
+			min_gap, MP8_MIN_SPAWN_GAP])
+
+	_mp8_spawn_markers = all_points
+
+
+# ═══════════════ [MP8] 出生点手调（mp8knifeedit）═══════════════
+# ⚠️ 全部 UI 与按键都在 `_mp8_edit_on` 之下；不传参数 = 屏幕上一个像素都不多、
+# `_unhandled_key_input` 开头就 return。所以 ③ 收尾天然无事可做。
+
+func _mp8_load_spawn_file() -> Array :
+
+	if not FileAccess.file_exists(MP8_SPAWN_FILE):
+		return []
+
+	var f := FileAccess.open(MP8_SPAWN_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] 内部暗手：读不了 %s（错误 %d）" % [
+			MP8_SPAWN_FILE, FileAccess.get_open_error()])
+		return []
+
+	var rows: Array = []
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var parts: PackedStringArray = line.split(",", false)
+		if parts.size() < 2:
+			push_warning("[MP8] 内部暗手：布局文件这一行看不懂，跳过 —— '%s'" % line)
+			continue
+		var x: float = float(parts[0].strip_edges())
+		var z: float = float(parts[1].strip_edges())
+		var yaw: float = (float(parts[2].strip_edges()) if parts.size() >= 3 else 0.0)
+		rows.append([Vector3(x, 0.0, z), yaw])
+	f.close()
+	return rows
+
+
+func _mp8_save_spawn_file() -> void :
+
+	var f := FileAccess.open(MP8_SPAWN_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] 内部暗手：写不了 %s（错误 %d）" % [
+			MP8_SPAWN_FILE, FileAccess.get_open_error()])
+		return
+
+	f.store_line("# 内部暗手（mp8game=7）出生点")
+	f.store_line("# 一行一个点：x, z, 朝向度数。**必须 8 行**，行数不足会被忽略。")
+	f.store_line("# 前 4 行是场景原版那 4 个（也可以调），后 4 行是本 mod 新增的。")
+	f.store_line("# 只在 5 人及以上生效；≤4 人一律用场景里原版那 4 个点，一个字节不动。")
+	f.store_line("# 删掉这个文件 = 回到内置的凸包最远点插入算法。可以直接用记事本改。")
+	f.store_line("# 存于 %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+
+	var snippet := PackedStringArray()
+	for m in _mp8_spawn_markers:
+		var node3d: Node3D = m
+		f.store_line("%.2f, %.2f, %.0f" % [
+			node3d.position.x, node3d.position.z, rad_to_deg(node3d.rotation.y)])
+		snippet.append("\t[Vector3(%.2f, 0.0, %.2f), %.1f]," % [
+			node3d.position.x, node3d.position.z, rad_to_deg(node3d.rotation.y)])
+	f.close()
+
+	print("[MP8] 内部暗手：出生点已存盘（%d 个）→ %s" % [
+		_mp8_spawn_markers.size(), ProjectSettings.globalize_path(MP8_SPAWN_FILE)])
+	# 定稿后可直接贴回代码当内置默认，省得下一个 agent 再反推坐标
+	print("[MP8] 内部暗手：贴回代码用 ——\n%s" % "\n".join(snippet))
+
+
+func _mp8_edit_begin() -> void :
+
+	_mp8_edit_canvas = CanvasLayer.new()
+	_mp8_edit_canvas.layer = 80
+	add_child(_mp8_edit_canvas)
+
+	_mp8_edit_panel = Label.new()
+	_mp8_edit_panel.set_anchors_preset(Control.PRESET_TOP_LEFT)
+	_mp8_edit_panel.offset_left = 24
+	_mp8_edit_panel.offset_top = 24
+	# Label 默认不裁剪，不设这两个也画得出来；设上是为了别踩右上角那个坑
+	_mp8_edit_panel.offset_right = 720
+	_mp8_edit_panel.offset_bottom = 520
+	# 同上：默认主题字体字距是坏的，必须用游戏自己的
+	var edit_font = load("res://fonts/Terminal F4.ttf")
+	if edit_font != null:
+		_mp8_edit_panel.add_theme_font_override("font", edit_font)
+	_mp8_edit_panel.add_theme_font_size_override("font_size", 20)
+	_mp8_edit_panel.add_theme_color_override("font_color", Color(0.6, 1.0, 0.6))
+	_mp8_edit_panel.add_theme_color_override("font_outline_color", Color.BLACK)
+	_mp8_edit_panel.add_theme_constant_override("outline_size", 6)
+	_mp8_edit_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_mp8_edit_canvas.add_child(_mp8_edit_panel)
+
+	_mp8_edit_refresh()
+	print("[MP8] 内部暗手：出生点手调已开 —— 1~8 选点 / IKJL 挪 / UO 转 / M 步长 / 0 存盘 / N 报告")
+
+
+func _mp8_edit_refresh() -> void :
+
+	if _mp8_edit_panel == null:
+		return
+
+	var lines := PackedStringArray()
+	lines.append("内部暗手 出生点手调　步长 %.2f 米（M 键切换）" % _mp8_edit_step)
+	lines.append("1~8 选点　IKJL 挪　UO 转　0 存盘　N 打报告")
+	lines.append("")
+	for i in _mp8_spawn_markers.size():
+		var node3d: Node3D = _mp8_spawn_markers[i]
+		lines.append("%s %d号  (%6.2f, %6.2f)  %5.0f°" % [
+			"▶" if i == _mp8_edit_sel else "　", i + 1,
+			node3d.position.x, node3d.position.z, rad_to_deg(node3d.rotation.y)])
+	_mp8_edit_panel.text = "\n".join(lines)
+
+
+func _mp8_edit_report() -> void :
+
+	var parts := PackedStringArray()
+	for i in _mp8_spawn_markers.size():
+		var node3d: Node3D = _mp8_spawn_markers[i]
+		parts.append("%d号(%.2f,%.2f)@%.0f°" % [
+			i + 1, node3d.position.x, node3d.position.z, rad_to_deg(node3d.rotation.y)])
+
+	var min_gap: float = INF
+	for i in _mp8_spawn_markers.size():
+		for j in range(i + 1, _mp8_spawn_markers.size()):
+			min_gap = minf(min_gap, (_mp8_spawn_markers[i] as Node3D).position.distance_to(
+				(_mp8_spawn_markers[j] as Node3D).position))
+
+	print("[MP8] 内部暗手出生点报告（最小间距 %.2f 米）：%s" % [min_gap, " | ".join(parts)])
+
+
+# [MP8] 挪完把对应的人也传过去，好当场看站位（只有服务器发，否则 8 台各广播一遍）
+func _mp8_edit_sync_player(index: int) -> void :
+
+	if not multiplayer.is_server():
+		return
+	if index >= _mp8_spawn_markers.size():
+		return
+
+	var list: Array = players.values()
+	if index >= list.size():
+		return
+
+	var node3d: Node3D = _mp8_spawn_markers[index]
+	list[index].teleport_rpc.rpc(node3d.global_position, node3d.global_rotation)
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on:
+		return
+	if not (event is InputEventKey) or not event.pressed or event.echo:
+		return
+
+	var key: int = (event as InputEventKey).keycode
+
+	if key >= KEY_1 and key <= KEY_8:
+		var want_sel: int = key - KEY_1
+		if want_sel < _mp8_spawn_markers.size():
+			_mp8_edit_sel = want_sel
+			_mp8_edit_refresh()
+		return
+
+	if _mp8_edit_sel >= _mp8_spawn_markers.size():
+		return
+	var sel: Node3D = _mp8_spawn_markers[_mp8_edit_sel]
+
+	match key:
+		KEY_I: sel.position.z -= _mp8_edit_step
+		KEY_K: sel.position.z += _mp8_edit_step
+		KEY_J: sel.position.x -= _mp8_edit_step
+		KEY_L: sel.position.x += _mp8_edit_step
+		KEY_U: sel.rotation.y += deg_to_rad(15.0)
+		KEY_O: sel.rotation.y -= deg_to_rad(15.0)
+		KEY_M:
+			_mp8_edit_step = (
+				1.0 if is_equal_approx(_mp8_edit_step, 0.5)
+				else (0.1 if is_equal_approx(_mp8_edit_step, 1.0) else 0.5)
+			)
+		KEY_0:
+			_mp8_save_spawn_file()
+			return
+		KEY_N:
+			_mp8_edit_report()
+			return
+		_:
+			return
+
+	_mp8_edit_sync_player(_mp8_edit_sel)
+	_mp8_edit_refresh()
+
+
+# [MP8] 把场景里**真实**的可搜容器收进 `searchables`。
+# `searchables` 是原版声明了却从没填过的数组（类型正好对），这里把它用起来。
+# 不用硬编码的 26（那是设计意图值，与场景实际不符：probe70 数出 36 个），
+# 主体仍走类型判定；仅对实机确认不可达的原始 #5 / #6 使用稳定完整路径排除。
+func _mp8_collect_searchables() -> void :
+
+	if mp8_searchables_collected:
+		return
+	mp8_searchables_collected = true
+
+	searchables.clear()
+	var stack: Array = [self]
+	var disabled_count: int = 0
+	var raw_index: int = 0
+	while not stack.is_empty():
+		var node: Node = stack.pop_back()
+		if node is KnifeAtTheOfficeSearchable:
+			var searchable := node as KnifeAtTheOfficeSearchable
+			# 调试标记继续显示过滤前的原始编号：停用后画面会缺 #5/#6，
+			# 而不是让原始 #7/#8 前移后冒充成新的 #5/#6。
+			searchable.set_meta(&"mp8_raw_searchable_index", raw_index)
+			raw_index += 1
+			if _mp8_disable_searchable_if_needed(searchable):
+				disabled_count += 1
+			else:
+				searchables.append(searchable)
+		for c in node.get_children():
+			stack.append(c)
+
+	if disabled_count != MP8_DISABLED_SEARCHABLE_PATHS.size():
+		push_warning("[MP8] 内部暗手：应停用 %d 个不可达容器，实际命中 %d 个；场景路径可能变了" % [
+			MP8_DISABLED_SEARCHABLE_PATHS.size(), disabled_count])
+	else:
+		print("[MP8] 内部暗手：不可达容器 #5/#6 已停用；有效容器 %d 个" % searchables.size())
+
+
+func _mp8_disable_searchable_if_needed(node: KnifeAtTheOfficeSearchable) -> bool :
+
+	var relative_path: String = String(get_path_to(node))
+	if not MP8_DISABLED_SEARCHABLE_PATHS.has(relative_path):
+		return false
+
+	# 玩家交互区通过 area_entered 发现 Searchable。四项一起清掉，既不再被发现，
+	# 也不再主动检测任何对象；视觉子树不动，所以房间布景保持原样。
+	node.monitoring = false
+	node.monitorable = false
+	node.collision_layer = 0
+	node.collision_mask = 0
+	return true
+
+
+# [MP8] 针筒：**真的放进容器里**（用户 2026-08-17 要的容器模型）。
+#
+# 原版是计数模型：`containers_searched == guaranteed_search_result` 时，
+# 谁在搜谁就拿到 —— 针筒没有位置，容器也不知道自己有没有东西
+# （`Searchable.has_item` / `set_has_item_rpc` 在原版里从来没人调用过）。
+# 现在改成：开局把针筒塞进随机的容器，`has_item = true`，开到那个柜子才算找到。
+#
+# 顺带治好原版的一个卡死：原版把出现位次算成 `round(26 * 人数/4) - 随机`，
+# 8 人局能算到 52，而全场只有 38 个容器且**一次性** → 约 52% 的局永远搜不出针筒，
+# 猎杀阶段不开始、倒计时不启动、check_game_end 不成立 → **整局卡死**。
+# 容器模型天然没有这个问题：针筒就在某个柜子里，最坏也就是等它被开到。
+#
+# 保留原版的**节奏下限**：早于全图 34% 的搜索次数不出针筒（原版 4 人局的下界）。
+# 早于它开到藏针筒的柜子，就当"还没在这儿"，照瞬移规则挪走。
+# 不设上限 —— 容器模型下上限是自然的（柜子迟早被开到）。
+func _mp8_setup_syringes() -> void :
+
+	var args := Array(OS.get_cmdline_args())
+	mp8_player_count = PlayerManager.player_presences.size()
+	mp8_syringes_found = 0
+	mp8_relocations = 0
+	mp8_syringe_containers.clear()
+	mp8_syringe_holders.clear()
+
+	_mp8_collect_searchables()
+	var total: int = searchables.size()
+
+	if args.has("mp8noexpand"):
+		mp8_syringes_needed = 1
+		print("[MP8] 内部暗手：mp8noexpand，针筒保持原版计数模型（纯原版对照组，⚠️ 必须配 4 人）")
+		return
+
+	if total <= 0:
+		push_warning("[MP8] 内部暗手：一个可搜容器都没数到，针筒退回原版计数模型")
+		return
+
+	# ≤4 人：原版一支。⚠️ 仍然改用容器模型 —— 原版计数模型在 4 人下不会卡死，
+	# 但两套模型并存会让后面的瞬移规则要写两遍。容器模型在 4 人下的手感与原版一致：
+	# 都是"搜到第 34%~ 若干次时出现"，只是决定权从计数器换成了柜子。
+	mp8_syringes_needed = 1 if mp8_player_count <= 4 else 2
+
+	# 开局把针筒塞进随机容器（真的写 has_item，用原版那个没人用过的 RPC）
+	var pool: Array = searchables.duplicate()
+	pool.shuffle()
+	for i in mini(mp8_syringes_needed, pool.size()):
+		var c = pool[i]
+		c.set_has_item_rpc.rpc(true)
+		mp8_syringe_containers.append(c)
+
+	var names := PackedStringArray()
+	for c in mp8_syringe_containers:
+		names.append(String(c.name))
+
+	print("[MP8] 内部暗手：%d 人 —— 容器 %d 个，针筒 %d 支已放进 [%s]（无节奏下限，开到即找到）" % [
+		mp8_player_count, total, mp8_syringes_needed, ", ".join(names)])
+
+
+# [MP8] 针筒瞬移（用户 2026-08-17 定的规则）。
+#
+# 规则：**已经被感染的人不许再摸到针筒。** 他照样能搜（不禁），
+# 但当他开到装着针筒的柜子时，针筒**立刻挪到另一个还没被搜过的容器里**。
+#
+# 挑新柜子时**优先离触发者远的**（真容器模型才做得到这件事，计数模型表达不出来）。
+#
+# 兜底（用户点名要的）：**场上没有未搜容器时，随机挑一个重置状态再把针筒塞进去。**
+# 不做这一步的话，最后一个容器被感染者开走就再也没地方放针筒了 → 又卡死。
+func _mp8_relocate_syringe(from_container, away_from: Vector3, reason: String) -> void :
+
+	if is_instance_valid(from_container):
+		from_container.set_has_item_rpc.rpc(false)
+		mp8_syringe_containers.erase(from_container)
+
+	# 候选：还没被搜过的、且不是刚开的那个、且身上还没有针筒的
+	var candidates: Array = []
+	for s in searchables:
+		if not is_instance_valid(s):
+			continue
+		if s == from_container or s.searched or mp8_syringe_containers.has(s):
+			continue
+		candidates.append(s)
+
+	mp8_relocations += 1
+
+	if candidates.is_empty():
+
+		# ═══════════════════════════════════════════════════════════════════
+		# [MP8] 🩸 没有未搜容器时**不再重置柜子** —— 那正是"找不到第二根针"的根因
+		# ═══════════════════════════════════════════════════════════════════
+		#
+		# 旧做法：随机挑一个已搜柜子 `set_searched_rpc(false)` + 塞回针筒。
+		# 看着合理，实际把针筒藏进了一个**画面上永远开着的柜子**：
+		#
+		#   `searchable.gd` 的 `set_searched_rpc()` 里只有
+		#       `if searched && searchable_visuals != null: open_container()`
+		#   —— **没有关回去的分支**，`Searchable_Visuals` 也只有 `open_container()`，
+		#   抽屉是 tween 出去的，没有任何方法能收回来。
+		#
+		# 于是 `searched` 标志虽然清了、柜子却还敞着，高亮也还是红的
+		#（`get_highlight_color()` 看的是 searched，这个倒是跟着变绿了，
+		#  但抽屉的开合是玩家真正会依据的视觉线索）。
+		# 玩家扫一眼"这柜子开过了"就走了 —— 针筒就此人间蒸发，本局再也找不到第二支。
+		#
+		# 新做法：**放弃瞬移，直接让这个已感染者拿走**。
+		# 理由：走到这一步说明全场 38 个柜子都被搜过了，游戏已经到了收尾阶段，
+		# 「不让感染者摸到针筒」这条规则的意义（保持悬念）已经不存在，
+		# 而**让局能结束**的优先级更高 —— 原版卡死的教训就在本文件开头第三条。
+		# 这条路径正常局跑不到（节奏下限删掉之后瞬移本来就很少），是纯兜底。
+		mp8_relocations -= 1   # 这次没真的瞬移，别记进计数
+		_mp8_debug_last = "%s → 全场无未搜容器，破例判定为找到" % reason
+		_mp8_debug_refresh()
+		print("[MP8] 内部暗手：⚠️ 全场 %d 个容器都搜过了，无处可挪 —— 破例让这次算找到（%s）" % [
+			searchables.size(), reason])
+		mp8_force_find = true
+		return
+
+	# 优先挪远：在候选里取离触发者最远的前半段，再随机挑一个
+	candidates.sort_custom(func(a, b):
+		return a.global_position.distance_to(away_from) > b.global_position.distance_to(away_from)
+	)
+	var half: int = maxi(candidates.size() / 2, 1)
+	var target = candidates[randi() % half]
+	target.set_has_item_rpc.rpc(true)
+	mp8_syringe_containers.append(target)
+
+	var from_name: String = String(from_container.name) if is_instance_valid(from_container) else "?"
+	_mp8_debug_last = "%s → %s 挪到 %s（远 %.1f 米）" % [
+		reason, from_name, target.name, target.global_position.distance_to(away_from)]
+	_mp8_debug_refresh()
+
+	print("[MP8] 内部暗手：针筒瞬移（%s）—— 从 %s 挪到 %s（离触发点 %.1f 米，候选 %d 个）" % [
+		reason, from_name, target.name,
+		target.global_position.distance_to(away_from),
+		candidates.size(),
+	])
+
+
+# [MP8] 结算日志。**不改任何分数**，纯为事后核对得分对不对。
+# 三个得分点：找到针筒 +1 ／ 成功感染一人 +1 ／ 活到最后的人类 +mp8_survivor_bonus。
+# 判据：把每个人的分拆开看 —— 幸存者至少有 bonus 分；感染者的分 = 是否找到针筒 + 感染人数。
+func _mp8_log_scores(survivors: int) -> void :
+
+	var rows := PackedStringArray()
+	for id in players.keys():
+		rows.append("%s %d分%s" % [
+			_mp8_name(id),
+			player_scores.get(id, 0),
+			"(感染者)" if infected_players.has(id) else "(人类)",
+		])
+
+	print("[MP8] 内部暗手结算（%d 人在场 / %d 人幸存 / 幸存分 %d / 感染者 %d 人）：%s" % [
+		players.size(), survivors, mp8_survivor_bonus, infected_players.size(),
+		" | ".join(rows),
+	])
+
+
+func _mp8_name(network_id: int) -> String :
+
+	if players.has(network_id) and is_instance_valid(players[network_id]):
+		return String(players[network_id].player_presence.network_name)
+	return "id%d" % network_id
+
+
+# [MP8] 猎杀阶段开始时，把之前"揣着没揭晓"的人统一装备上。
+#
+# 先找到的那个人当初是 `set_has_item_rpc(true, false)` 收到的针筒 ——
+# has_item 记了，但没出模型、没变感染态。到这一刻再补发一次 equip=true。
+#
+# ⚠️ 重发会让玩家那边再 `item_found.emit()` 一次 → `_on_item_found` 再跑一轮。
+# 那边已经被 `mp8_first_time`（= `not infected_players.has()`）挡住，不会重复加分
+# —— 这条依赖必须一直成立。
+#
+# [MP8] 2026-08-19：`mp8_syringes_found` 现在**不在 `_on_item_found` 里加**了
+#（搬到了 `request_item_find_rpc`），所以这条补发路径根本碰不到针筒计数，
+# 比原来更安全：走补发进来的这一轮只会被 mp8_first_time 挡掉加分，别的什么都不动。
+func _mp8_equip_all_infected() -> void :
+
+	var done: int = 0
+	for id in infected_players:
+		if not (players.has(id) and is_instance_valid(players[id])):
+			continue
+		# 已经装备过的不再补发 —— needed=1 时找到即当场装备，这里就是空操作，
+		# 免得白白多一轮 RPC 与 item_found 回环。
+		if players[id].is_holding_syringe:
+			continue
+		players[id].set_has_item_rpc.rpc(true, true)
+		done += 1
+
+	print("[MP8] 内部暗手：揭晓 —— %d 个感染者现在装备针筒并变模型（在场感染者 %d 个）" % [
+		done, infected_players.size()])
+
+
+# ═══════════════ [MP8] 针筒调试面板（mp8knifedebug）═══════════════
+# 用户 2026-08-17：「我会操作玩家搜箱子，来测试是否真的会瞬移」。
+# 左上角实时列出针筒当前在哪个柜子、瞬移过几次、最后一次是从哪挪到哪。
+# ⚠️ 状态只在服务器上，所以**只有 1 号窗口（房主）**的面板有内容。
+
+func _mp8_debug_begin() -> void :
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8KnifeDebugHud"
+	layer.layer = 99
+	add_child(layer)
+
+	_mp8_debug_panel = Label.new()
+	_mp8_debug_panel.set_anchors_preset(Control.PRESET_TOP_LEFT)
+	_mp8_debug_panel.offset_left = 18.0
+	_mp8_debug_panel.offset_top = 14.0
+	_mp8_debug_panel.offset_right = 860.0
+	_mp8_debug_panel.offset_bottom = 460.0
+	# 同前：默认主题字体字距是坏的，必须用游戏自己的（这条已经栽过四次）
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		_mp8_debug_panel.add_theme_font_override("font", f)
+	_mp8_debug_panel.add_theme_font_size_override("font_size", 20)
+	_mp8_debug_panel.add_theme_color_override("font_color", Color(1.0, 0.9, 0.4))
+	_mp8_debug_panel.add_theme_color_override("font_outline_color", Color.BLACK)
+	_mp8_debug_panel.add_theme_constant_override("outline_size", 6)
+	_mp8_debug_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	layer.add_child(_mp8_debug_panel)
+
+	_mp8_debug_refresh()
+	print("[MP8] 内部暗手：针筒调试面板已开（左上角，只有房主这台有内容）")
+
+
+func _mp8_debug_refresh() -> void :
+
+	if not _mp8_debug_on or _mp8_debug_panel == null:
+		return
+
+	if not multiplayer.is_server():
+		_mp8_debug_panel.text = "内部暗手 针筒调试\n（针筒状态只在房主那台，这里没有内容）"
+		return
+
+	var searched: int = 0
+	for s in searchables:
+		if is_instance_valid(s) and s.searched:
+			searched += 1
+
+	var where := PackedStringArray()
+	for c in mp8_syringe_containers:
+		if is_instance_valid(c):
+			where.append(String(c.name))
+
+	var infected := PackedStringArray()
+	for id in infected_players:
+		infected.append(_mp8_name(id))
+
+	var lines := PackedStringArray()
+	lines.append("内部暗手 针筒调试（房主）")
+	lines.append("容器 %d 个：已搜 %d / 未搜 %d　　搜索次数 %d" % [
+		searchables.size(), searched, searchables.size() - searched, containers_searched])
+	lines.append("针筒 %d/%d 已找到　场上还剩 %d 支" % [
+		mp8_syringes_found, mp8_syringes_needed, mp8_syringe_containers.size()])
+	lines.append("针筒现在在：%s" % ("（没有了）" if where.is_empty() else ", ".join(where)))
+	lines.append("已瞬移 %d 次" % mp8_relocations)
+	lines.append("　最后一次：%s" % _mp8_debug_last)
+	lines.append("已感染：%s" % ("（无）" if infected.is_empty() else ", ".join(infected)))
+	lines.append("猎杀阶段：%s（决定能不能扎人）" % ("已开始" if searching_disabled else "**未开始**"))
+	_mp8_debug_panel.text = "\n".join(lines)
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 右上角容器指示器「容器 12/34」（用户 2026-08-19 要的）
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 用户实测「有概率找不到第二根针」时提的：搜了半天不知道还剩多少柜子没开，
+# 也不知道是自己没搜到、还是针筒根本不在场上。这一行把它变成可见的。
+#
+# ### 为什么每台自己数，不发 RPC
+#
+# `_mp8_collect_searchables()` 在 `_ready()` 里跑，**每个端都会跑**，
+# 所以每台机器的 `searchables` 都是全的；而 `set_searched_rpc` 是
+# `call_local` 广播，每台的 `searched` 标志也都是准的。
+# → 本机遍历一遍就是正确答案，不需要服务器告诉它。
+# （这跟左上角那个调试面板不同：那个显示的是针筒在哪个柜子，
+#   `mp8_syringe_containers` 只有服务器有，所以那个面板只对房主有意义。）
+#
+# ### 显示的是「已搜/总数」，不是「剩余」
+#
+# 34/34 = 当前有效容器全搜完了。
+# 全搜完还没找到针筒时变红 —— 那说明撞上了兜底路径，看一眼就知道该查日志。
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 容器标记（mp8knifemark）—— 把"找柜子"变成"看一眼"
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 每个**还没搜过**的容器头顶挂一个 Label3D，写过滤前的原始收集编号，
+# `no_depth_test = true` 所以**穿墙可见**。搜过一个就消失一个。
+#
+# 用途：找出"数得到但玩家摸不着"的容器。用户 2026-08-19 报「场上只有 34 个可互动，
+# 找了好久没找到最后两个」，而 probe70 证实 36 个容器结构完全一样、
+# 只有坐标不同 —— 所以够不着是关卡几何造成的，静态分析查不出来，只能进场看。
+#
+# 跑完把剩下的编号告诉我（或看日志里那行「还剩 N 个没搜」），就能精确排除它们。
+func _mp8_mark_begin() -> void :
+
+	if not _mp8_marks.is_empty():
+		return
+	_mp8_collect_searchables()
+
+	for i in searchables.size():
+		var s = searchables[i]
+		if not is_instance_valid(s):
+			continue
+
+		var lbl := Label3D.new()
+		lbl.text = str(s.get_meta(&"mp8_raw_searchable_index", i))
+		lbl.font_size = 96
+		lbl.pixel_size = 0.012
+		lbl.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		# 穿墙可见 —— 这是本开关的全部意义，没有它就还是得挨个屋子找
+		lbl.no_depth_test = true
+		lbl.modulate = Color(1.0, 0.9, 0.2)
+		lbl.outline_modulate = Color.BLACK
+		lbl.outline_size = 12
+		lbl.position = Vector3(0, 1.6, 0)
+		s.add_child(lbl)
+		_mp8_marks.append([lbl, s])
+
+	print("[MP8] 内部暗手：mp8knifemark —— %d 个容器已挂编号（穿墙可见，搜过即消失）" % _mp8_marks.size())
+
+
+func _mp8_mark_refresh() -> void :
+
+	if _mp8_marks.is_empty():
+		return
+
+	var left := PackedStringArray()
+	for pair in _mp8_marks:
+		var lbl = pair[0]
+		var s = pair[1]
+		if not is_instance_valid(lbl) or not is_instance_valid(s):
+			continue
+		lbl.visible = not s.searched
+		if not s.searched:
+			left.append(lbl.text)
+
+	# 只在"快搜完了"的时候打日志，免得刷屏。剩 4 个以内时每次变化都报一次。
+	if left.size() <= 4 and left.size() > 0:
+		var key: String = ",".join(left)
+		if key != _mp8_mark_last:
+			_mp8_mark_last = key
+			var parts := PackedStringArray()
+			for pair in _mp8_marks:
+				var s = pair[1]
+				if is_instance_valid(s) and not s.searched:
+					parts.append("#%s (%.1f, %.1f)" % [
+						pair[0].text, s.global_position.x, s.global_position.z])
+			print("[MP8] 内部暗手：还剩 %d 个容器没搜 —— %s" % [left.size(), " / ".join(parts)])
+
+
+func _mp8_container_hud_refresh() -> void :
+
+	if mp8_container_label == null or not is_instance_valid(mp8_container_label):
+		return
+
+	var total: int = searchables.size()
+	if total <= 0:
+		mp8_container_label.text = ""
+		return
+
+	var searched: int = 0
+	for s in searchables:
+		if is_instance_valid(s) and s.searched:
+			searched += 1
+
+	mp8_container_label.text = "容器 %d/%d" % [searched, total]
+
+	# 全开完了还在搜 = 异常，标红提醒
+	if searched >= total:
+		mp8_container_label.add_theme_color_override("font_color", Color(1.0, 0.45, 0.45))
+	else:
+		mp8_container_label.add_theme_color_override("font_color", Color(0.85, 0.9, 0.85))
+
+
+func _mp8_container_hud_begin() -> void :
+
+	if mp8_container_label != null and is_instance_valid(mp8_container_label):
+		return
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8ContainerHud"
+	layer.layer = 100
+	add_child(layer)
+
+	var lbl := Label.new()
+	lbl.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+	lbl.offset_left = -320.0
+	# ⚠️ 压在「有人已被感染」那行**下面**（那行 top=14 / bottom=54），
+	# 不设 bottom 会得到负高度、文字被裁 —— 见下面那个函数的血泪注释。
+	lbl.offset_top = 58.0
+	lbl.offset_right = -18.0
+	lbl.offset_bottom = 96.0
+	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+
+	# ⚠️ 必须显式指定游戏自己的字体，默认主题字体字距是坏的（第五次踩，见下方注释）
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 24)
+	lbl.add_theme_color_override("font_color", Color(0.85, 0.9, 0.85))
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	layer.add_child(lbl)
+
+	mp8_container_label = lbl
+	_mp8_container_hud_refresh()
+	print("[MP8] 内部暗手：右上角容器指示器已建（本机自己数，%d 个容器）" % searchables.size())
+
+
+# [MP8] 右上角常驻一行「有人已被感染」（用户 2026-08-17 要的）。
+# ⚠️ 照枪械工厂那套：HUD 建在**小游戏自己身上**，只建一次。
+# 猎鸭当初把 HUD 挂在玩家身上，结果每台机器 8 个玩家各建一个 Label 叠成一团。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_show_infected_notice_rpc() -> void :
