+	for i in partners.size():
+		txt.append("%d(%.0f,%.0f)->%d" % [
+			i + 1, slots[i].x, slots[i].z, partners[i] + 1
+		])
+	print("[MP8] 翻转配对 %s：%s" % [
+		"❌不成立（槽位不是 180° 对称）" if bad else "✓对合成立",
+		" ".join(txt)
+	])
+
+
+# [MP8] 把一个平台的引用全部指回它自己那套家当，flipped 指向对角那套
+func _mp8_wire_platform(own: Dictionary, partner: Dictionary) -> void :
+
+	var p: JunkPlatformPlatform = own["platform"]
+
+	var own_indicator: Node3D = _mp8_pick(own, "damage indicator")
+	var own_visual: Node3D = _mp8_pick(own, "platform main")
+	var own_compactor = _mp8_pick(own, "compactor")
+	var own_alarm = _mp8_pick(own, "speaker_indicator alarm")
+
+	var far_indicator: Node3D = _mp8_pick(partner, "damage indicator")
+	var far_visual: Node3D = _mp8_pick(partner, "platform main")
+	var far_compactor = _mp8_pick(partner, "compactor")
+	var far_alarm = _mp8_pick(partner, "speaker_indicator alarm")
+
+	if own_indicator != null:
+		p.damage_circle_parent = own_indicator
+	if far_indicator != null:
+		p.damage_circle_parent_flipped = far_indicator
+
+	var vis: Array[Node3D] = []
+	if own_indicator != null:
+		vis.append(own_indicator)
+	if own_visual != null:
+		vis.append(own_visual)
+	p.platform_visuals = vis
+
+	var vis_f: Array[Node3D] = []
+	if far_indicator != null:
+		vis_f.append(far_indicator)
+	if far_visual != null:
+		vis_f.append(far_visual)
+	p.platform_visuals_flipped = vis_f
+
+	if own_compactor != null:
+		p.compactor = own_compactor
+	if far_compactor != null:
+		p.compactor_flipped = far_compactor
+	if own_alarm != null:
+		p.speaker_alarm = own_alarm
+	if far_alarm != null:
+		p.speaker_alarm_flipped = far_alarm
+
+	p.assign_indicators()
+
+
+# 从一组家当里按名字前缀挑一个（复制件名字前面加了 "MP8_<序号>_"，所以用 contains）
+func _mp8_pick(group: Dictionary, keyword: String):
+	for node in group["nodes"]:
+		if String(node.name).contains(keyword):
+			return node
+	return null
+
+
+# [MP8] 出生点补到和平台一样多，并且**顺序与平台严格一致**。
+# 垃圾掉落点是从出生点推的（spawn_players 里 add_spawn_point(id, 出生点+20米)），
+# 出生点没跟着平台走的话，垃圾会掉到旧位置的虚空里。
+func _mp8_rebuild_spawn_points(slots: Array[Vector3]) -> void :
+
+	var container: Node3D = player_spawn_position_node
+	if container == null:
+		return
+
+	var kids: Array = container.get_children()
+	if kids.is_empty():
+		return
+
+	var template: Node3D = kids[0]
+	while container.get_child_count() < slots.size():
+		var dup: Node3D = template.duplicate()
+		dup.name = "MP8Spawn%d" % container.get_child_count()
+		container.add_child(dup)
+
+	var all: Array = container.get_children()
+	for i in slots.size():
+		if i >= all.size():
+			break
+		var m: Node3D = all[i]
+		# 站在平台中心，稍微抬高一点免得卡进碰撞体
+		m.global_position = slots[i] + Vector3(0.0, template.global_position.y, 0.0)
+
+
+# [MP8] ═══════════ 视角模式 B / C（2026-08-25 用户要求做两版对比）═══════════
+#
+# 起因：8 个人挤在 2 个朝向里，远端那几个被近端的挡住。
+#
+# ---- 为什么原版只有 2 个朝向 ----
+#
+# 转朝向时**相机和美术是一起转的**（`camera_base` + `visuals_base`），
+# 而平台的**碰撞体/逻辑节点不动**（Platform1..4 钉在 ±13）。
+# 于是 `visuals_base` 一转，原来盖在 A 平台上的那套美术就跑到别的平台头上，
+# 所以每块平台必须**重新指认此刻落在它头上的那一套** —— 原版拿
+# `platform_visuals` / `platform_visuals_flipped` 两个槽做这件事，**只有两态**。
+# 这就是 0°/180° 的全部由来。
+#
+# 🩸 **那不是硬限制，是「只准备了两态」。** 重新指认这件事可以按几何算，
+# 任意角度都算得出来 —— 前提是那个角度得把「美术组」映射回「平台位置」上，
+# 也就是**必须是平台环的对称角**。B 和 C 的差别就在这一条。
+#
+# ---- B：布局不动，4 个朝向 ----
+#
+# 现在是**混合双环**：内环 4 块 r=18.38 在 45/135/225/315°，外环 4 块 r=22.5 在 0/90/180/270°。
+#   转 90° → 内环落到内环、外环落到外环 ✅
+#   转 45° → 内环会落到外环的**角度**上，但**半径对不上** ❌
+# 所以只能 4 档。8 个人两两共用一个朝向，而共用的那两块正好是 θ±22.5° 那两块 ——
+# **都是离相机最近的，并排贴在画面下缘**，谁也挡不到谁。
+#
+# ---- C：凑成正八边形，8 个朝向 ----
+#
+# 把**原版那 4 块也搬到 r=22.5**（方位角不变，只改半径），45° 就成了对称角 → 一人一档。
+# ⚠️ 这**推翻了用户 2026-08-16「原版那 4 个一动不动」的定案**。
+#    但那条定案的目的是孤岛感/间隙，而 C 在这一点上**更好**：
+#    正八边形 r=22.5，相邻圆心距 2R·sin(22.5°) = 17.22，减两个平台半径 6 → **间隙 5.2**，
+#    比现在混合双环的 4.1 还宽（当初被否掉的同半径 18.38 只有 2.1，那才是走得过去的那版）。
+#
+# ---- 两版都不碰的东西 ----
+#
+# 相机的**位置和 fov** 仍然走原有那套（`mp8junkcam=` / `_mp8_apply_camera`），这里只改朝向。
+# 相机层级里没有别的自由挂点可用：
+#   `Camera3D.rotation`  被 `anim_camera sway`（autoplay）**每帧**写
+#   `CameraDefault`      被 `shaker_camera shake` 当 Target 写
+#   `ShakerComponent3D`  本身就是抖动件
+# **只有 `camera_base` 没人抢**，所以朝向只能转它。
+# 【用户 2026-08-25 实机定案：**用 C 版**（“看着基本没问题”）】
+# 所以默认就是 c；另外两档降为**对照用的调试旋钮**，传 mp8junkview=a / =b 才走。
+#   a = 原样（2 个朝向，混合双环，与本轮之前逐值一致）
+#   b = 4 个朝向，布局不动
+#   c = 8 个朝向，正八边形（**当前默认**）
+const MP8_VIEW_STEPS: Dictionary = {"a": 180.0, "b": 90.0, "c": 45.0}
+const MP8_VIEW_DEFAULT: String = "c"
+# 走原版那条两态路的档位（`platform_visuals` ↔ `_flipped` 开关）。
+# 其余档位一律走 `_mp8_apply_view()` 的几何重新指认。
+const MP8_VIEW_VANILLA: String = "a"
+
+var _mp8_view_mode: String = MP8_VIEW_DEFAULT
+var _mp8_my_facing: float = 0.0
+# 搬完位置之后的每组家当：{"platform":, "nodes":, "pos": 最终世界坐标}
+var _mp8_groups_final: Array = []
+
+
+func _mp8_facing_step() -> float:
+	return float(MP8_VIEW_STEPS.get(_mp8_view_mode, 180.0))
+
+
+# [MP8] 这个人该用哪个朝向。
+# 相机静止时在 +Z 侧朝 -Z 看，所以朝向 = 平台的方位角 `atan2(x, z)`，按模式步长取整。
+# ⚠️ **step=180 时与原版逐例等价**，所以三种模式可以统一走这一个函数：
+#    (±13,+13) → ±45° → 取整到 0；(±13,−13) → ±135° → 取整到 180。
+func _mp8_facing_for(pos: Vector3) -> float:
+	var step: float = _mp8_facing_step()
+	var bearing: float = rad_to_deg(atan2(pos.x, pos.z))
+	return fposmod(round(bearing / step) * step, 360.0)
+
+
+# [MP8] 按当前朝向，把每块平台指认到「此刻落在它头上」的那套美术。
+#
+# `visuals_base` 转了 deg，所以原来在 g 处的美术现在在 R(deg)·g；
+# 要找盖住平台 p 的那一组，就是找 **g ≈ R(−deg)·p**。
+#
+# ⚠️ B/C 模式下**绝不能**再走原版那句 `platform_visuals = platform_visuals_flipped`：
+#    那是两态开关，这里已经直接指认成正确的一套了，再翻一次就翻错。
+func _mp8_rebind_for_facing(deg: float) -> void :
+
+	if _mp8_groups_final.is_empty():
+		return
+
+	var inv := Basis(Vector3.UP, deg_to_rad( - deg))
+	var hit: int = 0
+
+	for g in _mp8_groups_final:
+		var pl = g["platform"]
+		if pl == null or not is_instance_valid(pl):
+			continue
+
+		var p: Vector3 = Vector3(pl.global_position.x, 0.0, pl.global_position.z)
+		var want: Vector3 = inv * p
+		var want_far: Vector3 = - want
+
+		var best: Dictionary = {}
+		var far: Dictionary = {}
+		var bd: float = INF
+		var fd: float = INF
+		for h in _mp8_groups_final:
+			var hp: Vector3 = h["pos"]
+			var d: float = Vector2(hp.x - want.x, hp.z - want.z).length()
+			if d < bd:
+				bd = d
+				best = h
+			var d2: float = Vector2(hp.x - want_far.x, hp.z - want_far.z).length()
+			if d2 < fd:
+				fd = d2
+				far = h
+
+		if best.is_empty():
+			continue
+
+		# 拿平台本体 + 那一组的家当拼一个临时组，复用已经验过的接线函数
+		_mp8_wire_platform(
+			{"platform": pl, "nodes": best["nodes"]},
+			(far if not far.is_empty() else best)
+		)
+		hit += 1
+
+	print("[MP8] 残骸平台：朝向 %.0f° → 重新指认了 %d/%d 块平台的美术" % [
+		deg, hit, _mp8_groups_final.size()
+	])
+
+
+# [MP8] B/C 模式下的整套视角切换。**本机执行，每台机器各转各的。**
+func _mp8_apply_view(deg: float) -> void :
+
+	_mp8_my_facing = deg
+	if camera_base != null:
+		camera_base.rotation_degrees.y = deg
+	if visuals_base != null:
+		visuals_base.rotation_degrees.y = deg
+	_mp8_rebind_for_facing(deg)
+	_mp8_show_id_hud()
+
+
+# [MP8] ===== 相机：**按玩家单独调，能不动的一律不动**（用户 2026-08-16 提议）=====
+#
+# 能这么做的前提（逆向确认）：**相机是每台机器一份的**，不是全场共享一个。
+# 原版自己就在按玩家发相机指令（`rotate_camera_rpc.rpc_id(network_id, ...)`），
+# 所以给不同的人不同的相机完全走得通。
+#
+# ⚠️ **唯一锁死的是朝向：只能 0° 或 180°。**
+# 因为转的是 `camera_base` + `visuals_base` 两个一起转，而平台视觉件是**对角两两共用**的
+# （`platform_visuals` / `platform_visuals_flipped`），只有这两种状态。
+# **位置和 fov 则完全自由**，可以逐人不同。
+#
+# 实测（原版相机、八边形半径 22.5、平台半径 5）：8 个平台里只有**正对相机中轴**的
+# 那两个 (0,0,±R) 顶到画面边缘（纵向余量 +1.0 / +2.7 < 半径 5），
+# 其余 6 个原版构图绰绰有余（余量 7~13）。
+# 所以**只给这两个平台的主人补一点后拉+下移+广角，另外 6 个人的画面和原版一模一样**。
+# 改动面越小越不容易把本来对的地方改坏（坑第 21 条：原版是对的就别动它）。
+#
+# ⚠️⚠️ **必须挪相机在 camera_base 局部空间里的位置，绝对不能挪 camera_base 本身。**
+# camera_base 绕**自己的原点**转（实测它就在世界原点）。
+# 上一版写的是 `camera_base.global_position += back`，后果是：
+# 朝向 0° 那半人的相机确实往后退了，但 camera_base 一转 180°，
+# 同一个世界偏移就指向反方向 —— **另一半人的相机反而往前挪**。
+# 两边构图不一致，而且这种不对称在 8 个小窗口里肉眼极难发现。
+# 挪局部坐标就没这个问题：偏移跟着 camera_base 一起转，两边严格对称。
+#
+# 三个量用命令行 `mp8junkcam=<后拉>,<下移>,<广角增量>` 临时覆盖，不用重新编译，
+# 配合日志里的 [MP8-CAM] 体检行调。
+# 【2026-08-16 用户定案】用户实际选定的是**全场统一**的这一套：
+#   后拉 6 / 下移 2 / 广角 +10（原版 50.3 → 60.3），相机 (0,27.1,30.7) -> (0,25.1,36.7)。
+# 对应画面 `notes\shots\oct_cam_b6d2f10_t3_P1.png`。
+# 逐人模式（只调正对中轴那两个人、其余保持原版）仍然可用，传 `mp8junkcamper` 打开。
+const MP8_CAM_BACK: float = 6.0      # 沿视线**水平**后退（不抬高：抬高会越过压缩机顶端 y≈26.8，顶盖糊画面）
+const MP8_CAM_DOWN: float = 2.0      # 相机下移
+const MP8_CAM_FOV_ADD: float = 10.0  # 视场角增量（原版 50.3 → 60.3）
+
+var _mp8_cam_xf0: Transform3D        # 原版相机变换（_ready 里 camera_base 还没转，是干净基准）
+var _mp8_cam_fov0: float = 0.0
+
+
+# [MP8] 这个玩家的相机要不要动？返回 (后拉, 下移, 广角增量)，全 0 = 保持原版。
+#
+# 判据：**他自己的平台**在他那台机器的画面里是不是完整的。
+# 只看平台上表面（人站的那一面），不管平台柱子的下半截——原版近侧那两个平台的
+# 柱子本来就被下边缘切掉一截，那是原版长相，不是毛病。
+func _mp8_camera_adjust_for(pos: Vector3, rot: float) -> Vector3:
+
+	if _mp8_cam_fov0 <= 0.0:
+		return Vector3.ZERO
+
+	# 默认走**全场统一**（已在 _ready 里调过了），这里就不再逐人加，免得叠两次
+	if not Array(OS.get_cmdline_args()).has("mp8junkcamper"):
+		return Vector3.ZERO
+
+	var radius: float = 6.0
+	if junk_handler != null and "platform_radius" in junk_handler:
+		radius = junk_handler.platform_radius
+
+	# 他那台机器的相机只会转 0° 或 180°。转 180° 等价于把平台位置绕 Y 转 180°
+	# （(x,z) -> (-x,-z)）之后用**原版朝向**的相机去看，所以直接换算位置即可。
+	var p: Vector3 = Vector3(pos.x, 0.0, pos.z)
+	if absf(rot) > 90.0:
+		p = Vector3( - p.x, 0.0, - p.z)
+
+	var half_v: float = deg_to_rad(_mp8_cam_fov0) * 0.5
+	var half_h: float = atan(tan(half_v) * _mp8_aspect())
+	var m: Vector3 = _mp8_frame_margin(_mp8_cam_xf0, half_v, half_h, p)
+
+	if minf(m.y, m.z) >= radius:
+		return Vector3.ZERO   # 原版构图就够，一个字不改
+
+	return _mp8_cam_values()
+
+
+# [MP8] 相机微调量 (后拉, 下移, 广角增量)，命令行 mp8junkcam=<后拉>,<下移>,<广角增量> 可覆盖
+func _mp8_cam_values() -> Vector3:
+
+	var back: float = MP8_CAM_BACK
+	var down: float = MP8_CAM_DOWN
+	var fov_add: float = MP8_CAM_FOV_ADD
+	var v: String = _mp8_arg("mp8junkcam=")
+	if v != "":
+		var parts: PackedStringArray = v.split(",")
+		if parts.size() > 0 and String(parts[0]).is_valid_float():
+			back = float(parts[0])
+		if parts.size() > 1 and String(parts[1]).is_valid_float():
+			down = float(parts[1])
+		if parts.size() > 2 and String(parts[2]).is_valid_float():
+			fov_add = float(parts[2])
+	return Vector3(back, down, fov_add)
+
+
+# [MP8] 服务器按玩家单独下发。call_local 不用——服务器自己那份在 spawn_players 里直接调。
+@rpc("authority", "call_remote", "reliable")
+func mp8_adjust_camera_rpc(back: float, down: float, fov_add: float) -> void :
+	_mp8_apply_camera(back, down, fov_add)
+
+
+func _mp8_apply_camera(back: float, down: float, fov_add: float) -> void :
+
+	if camera == null or camera_base == null:
+		return
+
+	var before: Vector3 = camera.global_position
+	var before_fov: float = camera.fov
+
+	# camera_base 局部空间里，+Z 就是"背对视线"的方向（相机看向 -Z），
+	# 所以后拉 = +Z，下移 = -Y。偏移跟着 camera_base 的 180° 一起转，两边对称。
+	var t: Transform3D = camera_base.global_transform.affine_inverse() * camera.global_transform
+	t.origin += Vector3(0.0, - down, back)
+	camera.global_transform = camera_base.global_transform * t
+
+	camera.fov = before_fov + fov_add
+
+	print("[MP8] 本机相机微调：后拉 %.1f、下移 %.1f、广角 %.1f -> %.1f；位置 (%.1f, %.1f, %.1f) -> (%.1f, %.1f, %.1f)" % [
+		back, down, before_fov, camera.fov,
+		before.x, before.y, before.z,
+		camera.global_position.x, camera.global_position.y, camera.global_position.z
+	])
+
+
+func _mp8_aspect() -> float:
+	var vp: Viewport = get_viewport()
+	if vp != null and vp.get_visible_rect().size.y > 0.0:
+		return vp.get_visible_rect().size.x / vp.get_visible_rect().size.y
+	return 16.0 / 9.0
+
+
+# [MP8] 相机构图体检：把"哪个平台在画面里、哪个掉出去了"直接打成日志。
+#
+# 相机不动之后，构图余量完全由原版决定，靠人盯 8 个小窗口画面判断既慢又容易看漏
+# （尤其"掉出画面"和"被别的东西挡住"肉眼看起来很像）。所以这里算清楚再打出来。
+#
+# **两种朝向都要算**：对面那半玩家把 camera_base 绕 Y 转了 180°，
+# 等价于把平台位置绕 Y 转 180° 之后用同一个相机看，所以第二种朝向直接用 (-x, y, -z)。
+#
+# 余量的含义：视锥边界到该点的世界单位距离。
+#   余量 < 0        → 平台**中心**都在画面外，这个平台的主人根本看不见自己的平台
+#   0 ≤ 余量 < 半径 → 中心在画面里，但平台边缘被切掉一部分（原版近侧那排本来就是这样）
+#   余量 ≥ 半径     → 整块平台都在画面里
+func _mp8_report_camera(groups: Array, slots: Array[Vector3]) -> void :
+
+	if camera == null:
+		return
+
+	var xf: Transform3D = camera.global_transform
+	var half_v: float = deg_to_rad(camera.fov) * 0.5
