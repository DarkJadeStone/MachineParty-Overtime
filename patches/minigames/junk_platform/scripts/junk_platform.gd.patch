diff --git a/minigames/junk_platform/scripts/junk_platform.gd b/minigames/junk_platform/scripts/junk_platform.gd
--- a/minigames/junk_platform/scripts/junk_platform.gd
+++ b/minigames/junk_platform/scripts/junk_platform.gd
@@ -30,21 +30,368 @@ var finished: bool = false
 
 var player_count: int = 0
 
+# [MP8] ===== 残骸平台扩到 8 个 =====
+#
+# 这个小游戏是**每人一个实体平台**，不是补个出生点就行的那种：
+# 一个平台 = Area3D 碰撞体 + 平台视觉件 + 损伤指示圈 + 压缩机 + 警报音源，共 5 组节点。
+#
+# ---- 场景是怎么搭的（逆向出来的，改之前必读）----
+#
+# 1. **平台碰撞体是静止的，视觉件挂在会旋转的 `visuals base` 上**。
+#    对面那半玩家把 `camera_base` 和 `visuals_base` 一起绕 Y 转 180°，
+#    于是 1 号平台底下换成了对角那个平台的视觉件——所以脚本里要重新指认
+#    （`platform_visuals` → `platform_visuals_flipped`）。**翻转配对 = 正对角。**
+#
+# 2. **编号不可信，位置才可信**：`platform main parent1` 并不在 `Platform1` 底下
+#    （实测 parent1 在 (-13,+13)，而 Platform1 在 (-13,-13)），
+#    而且对角两个平台**互相引用同一批视觉件**（1 引用 1 和 3，3 引用 3 和 1）。
+#    所以搬家**必须按空间位置认组**，不能按编号认，否则会把同一个节点搬两次。
+#
+# 3. `junk platform compactors` 这个父节点自带 -90° 旋转，
+#    压缩机的局部坐标要乘上父变换才是世界坐标（换算后每台确实在对应平台正上方）。
+#
+# ---- 布局（2026-08-16 用户定案）----
+#
+# 原版 4 个平台在 (±13, 0, ±13)、半径 6，彼此间距 26（边缘空隙 14）——是**孤岛**。
+#
+# ⚠️ 初版排成"两排各 4 个"（z=±13，x=±6.5/±19.5）：功能全正常，但间距压到 13、
+#    边缘只剩 1 的空隙，**人一步就能走到别人的平台上**，孤岛感没了。
+#
+# 定案（用户 2026-08-16）：**八边形** —— 原版那 4 个一动不动，
+# 新增 4 个摆在 0°/90°/180°/270° 方位、半径 MP8_NEW_RADIUS 处，
+# 并各自绕 Y 转 45° 让朝向和站位一致。半径 22.5 时相邻边缘间隙约 4.1（初版是 1.0），走不过去。
+#
+# ⚠️⚠️ **相机一律保持原版，一个字都不改**（用户 2026-08-16 明确要求，等他的反馈再说）。
+# 上一版的"自动后拉构图"已经**默认关掉**，只在传 mp8junkcam 时才跑（见 _mp8_pull_camera_back）。
+# 上一版为什么被否：自动构图是沿视线后退的，而视线俯角 34.5°，
+# 退 9 个单位就把相机抬到 y≈28、高过压缩机顶端 y≈27，顶盖糊在画面上方挡视野。
+#
+# 相机不动的代价是**构图余量由原版决定，不能再靠拉相机去凑**：
+# 原版近侧那排平台（z=+13）中心已经压在画面下边界附近，
+# 所以圆环半径一大，正前方那个平台就会掉到画面外面去。
+# `_mp8_report_camera()` 会把每个平台在两种朝向下的"进没进画面"直接打进日志，
+# 不用靠人盯着画面猜。半径可以用命令行 mp8junkr=<半径> 临时改，不用重新编译。
+
+# 新平台所在半径。原版四角在 √(13²+13²) = 18.38 处。
+# 半径越大离得越开，但正前方那个平台也越贴近相机（相机在 z=27.66）：
+#   18.38（同一个圆）→ 相邻间隙仅 2.1，可能还是能走过去
+#   22.5            → 间隙 4.1，基本走不过去
+# ⚠️ 相机现在不动了，所以这个值是**唯一的旋钮**，构图好不好全看它。
+# 命令行 mp8junkr=<半径> 可临时覆盖，不用重新编译（配合日志里的 [MP8-CAM] 体检行调）。
+const MP8_NEW_RADIUS: float = 22.5
+
+# 新平台绕 Y 转 45°，让它的朝向和"站在 45° 方位"这件事一致（用户要求）
+const MP8_NEW_YAW_DEGREES: float = 45.0
+
+# 玩家落位：platforms[i] ↔ 出生点[i] ↔ 第 i 个玩家，而 platforms 的顺序是
+# **原版 4 个在前、复制件在后**，所以边界情况天然分成两半：
+#   P1~P4 = 原版四角平台（原始节点，位置一动没动）
+#   P5~P8 = 新增的 45° 方位平台（复制件 + 转了 45°）
+# 于是"只有复制件坏"的症状就是 P5~P8 全出问题，和"某一侧坏"区分得很干净。
+# P8 还占着数组末位，按下标索引的越界会先打在他身上。
+
+var _mp8_expanded: bool = false
+
+
+# [MP8] ===== 调试设施：右上角"我是谁" + 数字键切落石速度 =====
+#
+# 1. **右上角玩家 id**：8 开的时候光看画面分不清哪个窗口是谁
+#    （平台名牌能看出"这个平台是谁的"，但看不出"我正在操作的是谁"）。
+# 2. **数字键切落石速度**：原版落石节奏很快（3 秒一批、10 秒内加速到 1 秒一批），
+#    想看清楚指示圈/塌陷/压缩机根本来不及。用户 2026-08-16 要求把倍数交给按钮控制。
+#
+# ⚠️ 落石计时器**只在服务器上跑**（junk_handler 里 `if multiplayer.is_server()` 才连 timeout），
+# 所以按键必须走 RPC 通知服务器，客户端自己改本地的值没有任何效果。
+
+const MP8_JUNK_SPEED_KEYS: Dictionary = {
+	KEY_1: 1.0,    # 原速
+	KEY_2: 2.0,    # 2 倍慢
+	KEY_3: 5.0,    # 5 倍慢
+	KEY_4: 10.0,   # 10 倍慢
+	KEY_5: 0.0,    # 暂停落石
+}
+
+# [MP8] 调试辅助总开关（用户 2026-08-16 要求：收尾时这三样必须关掉）。
+# 管三样东西：① 数字键切落石速度 ② 右上角"我是谁" ③ 平台头顶名牌。
+# 跟着 `-debug-tools` 走 —— 测试台一定带它，**发布版一定不带**，所以正式游玩天然是干净的。
+# 想在测试台上也关掉看正式效果：传 `mp8nojunkdebug`。
+var _mp8_debug_aids: bool = false
+var _mp8_junk_keys: bool = false
+var _mp8_junk_mult: float = 1.0
+var _mp8_junk_base_interval: float = 0.0
+var _mp8_junk_base_min: float = 0.0
+var _mp8_debug_canvas: CanvasLayer = null
+# [MP8] 2026-08-25 用户要的「暂停落石」可点按钮。键盘 5 仍然有效，两者走同一条 RPC。
+var _mp8_junk_btn: Button = null
+var _mp8_id_label: Label = null
+var _mp8_junk_label: Label = null
+
+
 func _ready() -> void :
 	super._ready()
 
+	# [MP8] ⚠️ 开关必须在 _mp8_expand_platforms() **之前**算好：
+	# 平台头顶名牌是在扩平台那一步里建的，晚了就来不及拦。
+	_mp8_init_flags()
+
 	camera.current = true
 
+	# [MP8] 扩平台。**必须在 spawn_players() 之前跑完**——出生点是从平台位置推的，
+	# 而垃圾的掉落点又是从出生点推的（add_spawn_point(id, 出生点 + 20米)）。
+	if not Array(OS.get_cmdline_args()).has("mp8noexpand"):
+		_mp8_expand_platforms()
+
 	if multiplayer.is_server():
 
 		countdown_state.countdown_started.connect(_on_countdown_started)
 		countdown_state.tick.connect(_on_countdown_tick)
 		countdown_state.expired.connect(_on_countdown_expired)
 
+	# [MP8] 调试设施。落石基准值必须在这里记下来——后面按键是"原值 × 倍数"，
+	# 不记基准的话反复按会变成连乘（按两次 5 倍就成了 25 倍）。
+	_mp8_init_debug()
+
 	if GameManager.local_game:
 		await get_tree().create_timer(1.0).timeout
 		minigame_ready.emit(1)
 
+
+# [MP8] 调试辅助开关，必须在建任何 HUD / 名牌之前算好
+func _mp8_init_flags() -> void :
+
+	var args: Array = Array(OS.get_cmdline_args())
+	# [MP8] 2026-08-25 调整优先级：**显式传 mp8junkdebug 胜过 mp8nojunkdebug**。
+	# 原因：`play.ps1` 的 `-Clean` 会自动带上 `mp8nojunkdebug`（让测试台画面干净），
+	# 而按项目规矩 `-Clean` 是必带的 —— 老写法里 nojunk 压过一切，
+	# 于是「想在 -Clean 局里看右上角面板」这件事**根本做不到**（`-Extra mp8junkdebug` 也会被压掉）。
+	# 发布版两个开关都不传，所以正式游玩仍然天然干净，收尾要求不受影响。
+	_mp8_debug_aids = args.has("mp8junkdebug") \
+		or (args.has("-debug-tools") and not args.has("mp8nojunkdebug"))
+	_mp8_junk_keys = _mp8_debug_aids or args.has("mp8junkkeys")
+
+	# [MP8] 视角模式（2026-08-25 用户要求做 B / C 两版对比，当天实机定案采用 C）：
+	#   不传  = **C**（MP8_VIEW_DEFAULT），下面这行注释以前写的是"原样"，
+	#           那是 B/C 定案之前的行为，已过期 —— 现在默认就是 C。
+	#   =a   = 原样：2 个朝向（0°/180°），混合双环布局，与改动前逐值一致
+	#   =b   = 4 个朝向（0/90/180/270），**布局不动**
+	#   =c   = 8 个朝向（每 45°），布局改成同半径正八边形
+	# 判据与代价见 MP8_VIEW_STEPS 上面那一大段。
+	var vm: String = _mp8_arg("mp8junkview=").to_lower()
+	_mp8_view_mode = vm if MP8_VIEW_STEPS.has(vm) else MP8_VIEW_DEFAULT
+	if vm != "" and not MP8_VIEW_STEPS.has(vm):
+		push_warning("[MP8] 残骸平台：mp8junkview=%s 不认识，按默认 C 跑（只认 a / b / c）" % vm)
+	print("[MP8] 残骸平台：视角模式 = %s（%d 个朝向，步长 %.0f°）" % [
+		("原样" if _mp8_view_mode == MP8_VIEW_VANILLA else _mp8_view_mode.to_upper()),
+		int(round(360.0 / _mp8_facing_step())), _mp8_facing_step()
+	])
+
+
+# [MP8] 调试设施初始化：记基准值、建 HUD
+func _mp8_init_debug() -> void :
+
+	if junk_handler != null:
+		_mp8_junk_base_interval = junk_handler.spawn_interval
+		_mp8_junk_base_min = junk_handler.min_spawn_interval
+
+	# 起始倍数：命令行 mp8junkslow=<倍率> 优先；没传就在调试台默认 5 倍慢
+	# （用户 2026-08-16："把石头的倒计时拉长 5 倍"），发布版不带 -debug-tools 则保持原速。
+	var v: String = _mp8_arg("mp8junkslow=")
+	if v.is_valid_float():
+		_mp8_junk_mult = float(v)
+	elif _mp8_junk_keys:
+		_mp8_junk_mult = 5.0
+
+	if multiplayer.is_server():
+		_mp8_apply_junk_speed()
+
+	_mp8_show_id_hud()
+	_mp8_update_junk_hud()
+
+
+# [MP8] 调试覆盖层，右上角 id 和落石速度提示共用一个
+func _mp8_debug_layer() -> CanvasLayer:
+	if _mp8_debug_canvas == null:
+		_mp8_debug_canvas = CanvasLayer.new()
+		_mp8_debug_canvas.layer = 100
+		add_child(_mp8_debug_canvas)
+	return _mp8_debug_canvas
+
+
+# [MP8] 给调试 Label 套上游戏自己的字体。
+# ⚠️ 不套的话用的是默认主题字体，**字距是坏的**：实测字会挤成一团
+# （"P3  id 104..." 显示成 "P36idc104..."），空格换半角也没用。见猎鸭那边同样的坑。
+func _mp8_style_label(lbl: Label, color: Color) -> void :
+
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 26)
+	lbl.add_theme_color_override("font_color", color)
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+# [MP8] 右上角常驻显示"我是谁"：玩家名 + 网络 id。
+#
+# 这是**第一人称 HUD**，每台机器只显示自己那个人。
+# 名字要等 PlayerManager 填好，_ready 时不一定拿得到，所以
+# spawn_players 广播名牌时会再调一次刷新（见 mp8_set_platform_labels_rpc）。
+func _mp8_show_id_hud() -> void :
+
+	# [MP8] 收尾要求（用户 2026-08-16）：正式游玩不显示，只在调试台出现
+	if not _mp8_debug_aids:
+		return
+
+	if _mp8_id_label == null:
+		var lbl := Label.new()
+		lbl.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+		lbl.offset_left = -420.0
+		lbl.offset_top = 12.0
+		lbl.offset_right = -16.0
+		# [MP8] 2026-08-25 从 52 加高到 150：现在这块要放三行（谁 / 视角模式 / 我的朝向）
+		lbl.offset_bottom = 150.0
+		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+		_mp8_style_label(lbl, Color(1.0, 0.95, 0.4))
+		_mp8_debug_layer().add_child(lbl)
+		_mp8_id_label = lbl
+
+	var me: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var who: String = ""
+	if PlayerManager.player_presences.has(me):
+		who = String(PlayerManager.player_presences[me].network_name)
+
+	# [MP8] 2026-08-25：加两行视角信息 —— B/C 两版对比时全靠这个分辨自己在哪一档。
+	# 朝向是**本机**的值（每台机器各转各的），所以 8 个窗口应该显示 8 个不同的数（C 版）
+	# 或两两相同（B 版）。全都一样 = 朝向没生效，第一眼就能看出来。
+	var lines := PackedStringArray()
+	lines.append(("id %d" % me) if who == "" else ("%s   id %d" % [who, me]))
+	lines.append("视角 %s   共 %d 档" % [
+		("原样" if _mp8_view_mode == MP8_VIEW_VANILLA else _mp8_view_mode.to_upper()),
+		int(round(360.0 / _mp8_facing_step()))
+	])
+	lines.append("我的朝向 %.0f°" % _mp8_my_facing)
+	_mp8_id_label.text = "\n".join(lines)
+
+
+# [MP8] 落石速度提示（只有开了调试键才显示，免得挡正式游玩的画面）
+func _mp8_update_junk_hud() -> void :
+
+	if not _mp8_junk_keys:
+		return
+
+	if _mp8_junk_label == null:
+		var lbl := Label.new()
+		lbl.set_anchors_preset(Control.PRESET_TOP_WIDE)
+		lbl.offset_top = 12.0
+		lbl.offset_bottom = 52.0
+		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+		_mp8_style_label(lbl, Color(0.6, 0.9, 1.0))
+		_mp8_debug_layer().add_child(lbl)
+		_mp8_junk_label = lbl
+
+	var state: String
+	if _mp8_junk_mult <= 0.0:
+		state = "暂停落石"
+	elif is_equal_approx(_mp8_junk_mult, 1.0):
+		state = "原速（%.1f 秒一批）" % _mp8_junk_base_interval
+	else:
+		state = "%.0f 倍慢（%.1f 秒一批）" % [_mp8_junk_mult, _mp8_junk_base_interval * _mp8_junk_mult]
+
+	_mp8_junk_label.text = "[落石调试] %s    1=原速 2=2倍慢 3=5倍慢 4=10倍慢 5=暂停" % state
+
+	# [MP8] 2026-08-25 用户要求：把同一个开关做成**可点按钮**。
+	# 键盘 5 仍然有效 —— 两者走同一条 mp8_set_junk_speed_rpc，不会各记各的状态。
+	# ⚠️ 这个小游戏**没有捕获鼠标**（全工程 grep 不到它设 Input.mouse_mode），所以按钮点得到；
+	#    别的小游戏照抄之前先确认这一点，鼠标被捕获的地方按钮是死的。
+	# [MP8] 2026-08-25 用户定：**按钮只在房主出现**，客机只留数字键 5。
+	# 理由：暂停是**全局**的（真正停计时器的 `_mp8_apply_junk_speed()` 只在服务器跑），
+	# 8 个窗口各摆一个可点按钮 = 任何一个客机都能一键停掉全场落石，鼠标误触代价太大。
+	# 数字键保持所有端可用 —— 那是原有行为，而且按键不像按钮那样容易误碰。
+	if multiplayer.is_server() and _mp8_junk_btn == null:
+		var b := Button.new()
+		b.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+		b.offset_left = -220.0
+		b.offset_top = 158.0
+		b.offset_right = -16.0
+		b.offset_bottom = 202.0
+		var bf = load("res://fonts/Terminal F4.ttf")
+		if bf != null:
+			b.add_theme_font_override("font", bf)
+		b.add_theme_font_size_override("font_size", 24)
+		b.pressed.connect(_mp8_toggle_junk_pause)
+		_mp8_debug_layer().add_child(b)
+		_mp8_junk_btn = b
+
+	# 客机上按钮压根没建（见上），所以这里必须判空
+	if _mp8_junk_btn != null:
+		_mp8_junk_btn.text = "继续落石" if _mp8_junk_mult <= 0.0 else "暂停落石"
+
+
+# [MP8] 按钮点一下 = 在「暂停」与「原速」之间切。
+# 走的是和数字键 5 完全同一条 RPC，所以 8 个窗口的状态永远一致，
+# 也不需要另外记一个"上次是几倍慢"——按钮只管暂停/恢复，细分速度还是用数字键。
+func _mp8_toggle_junk_pause() -> void :
+	mp8_set_junk_speed_rpc.rpc(0.0 if _mp8_junk_mult > 0.0 else 1.0)
+
+
+# [MP8] 数字键切落石速度。
+# 按键在**任何一台机器**上都能按，但真正生效的是服务器上的计时器，所以走 RPC 广播。
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_junk_keys:
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+	if not MP8_JUNK_SPEED_KEYS.has(key.keycode):
+		return
+
+	mp8_set_junk_speed_rpc.rpc(float(MP8_JUNK_SPEED_KEYS[key.keycode]))
