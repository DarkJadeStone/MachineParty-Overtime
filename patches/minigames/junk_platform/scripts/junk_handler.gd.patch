+# ═══════ [MP8] 2026-08-19：卡在平台上不动的残骸，超时主动回收 ═══════
+#
+# 只在服务器跑（调用点 `_physics_process` 开头就 `is_server()` 早退了）。
+# 理由与整条链路见文件顶部 mp8_stuck_recycle_time 的大段注释。
+func _mp8_recycle_stuck_junk(delta: float) -> void :
+
+	# 不在游玩中就不计时：回合间/结算时残骸静止是正常的，
+	# 不清零的话下一轮一开局就会有一批被误判成"卡了一分钟"。
+	if not active:
+		mp8_idle_time.clear()
+		return
+
+	for k in junk_instances.keys():
+
+		var junk: JunkCubeRigidbody = junk_instances[k]
+
+		if not is_instance_valid(junk):
+			mp8_idle_time.erase(k)
+			continue
+
+		# 已经在池子里（或还没投放）—— reset_rpc 会把 active 置 false。
+		# 这一条同时也让"刚被回收区收走的"自动跳过，不会被重复塞进池子。
+		if not junk.active:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		# 被玩家举在手上不算卡住：那是有人在用它（举着时 freeze=true、速度恒为 0，
+		# 不排除的话举一分钟就会在手里凭空消失）。
+		if junk.held_by:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		# 还在动（掉落中 / 被扔出去 / 慢慢滚）—— 计时归零。
+		if junk.linear_velocity.length() > mp8_stuck_speed_threshold:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		var idle: float = mp8_idle_time.get(k, 0.0) + delta
+
+		if idle < mp8_stuck_recycle_time:
+			mp8_idle_time[k] = idle
+			continue
+
+		# 超时：走**和回收区完全同一条路**，下一个 tick 就会被重新投放。
+		mp8_idle_time[k] = 0.0
+		junk.reset_rpc.rpc()
+		caught_junk.append(junk)
+
+		mp8_stuck_recycled += 1
+		print("[MP8] 残骸平台：#%d 静止超过 %.0f 秒，主动回收（本局第 %d 块，池中 %d）" % [
+			k, mp8_stuck_recycle_time, mp8_stuck_recycled, caught_junk.size()])
