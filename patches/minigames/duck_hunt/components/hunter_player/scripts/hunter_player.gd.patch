+# [MP8] 取符号：正=增强，负=削弱，0=无效果。浮点比较留一点容差，避免 0.7999 被判成削弱。
+func _mp8_sign(v: float) -> int:
+	if v > 0.001:
+		return 1
+	if v < -0.001:
+		return -1
+	return 0
