+# [MP8] 本局该有几个猎人。至少留一只鸭，否则没人可打。
+func _mp8_hunter_count(total_players: int) -> int:
+	# [MP8] mp8lone：测试开关，强制单猎人。
+	# "独狼回合"本来只出现在 7 人局的**最后一个**小回合，而挂机机器人打不完前三个
+	# （鸭子不死不逃），那一轮的强化参数和专属口号根本验不到。
+	# 有了这个开关，8 人局直接就是 1 猎 7 鸭，独狼那套全走一遍。
+	if Array(OS.get_cmdline_args()).has("mp8lone"):
+		return 1
+	var wanted: int = 2 if total_players >= MP8_TWO_HUNTERS_FROM else 1
+	return clampi(wanted, 1, maxi(total_players - 1, 1))
+
