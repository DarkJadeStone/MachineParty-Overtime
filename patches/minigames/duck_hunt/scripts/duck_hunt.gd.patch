+func mp8_apply_role_reveal_label() -> void :
+
+	if ui_role_label == null:
+		return
+
+	var rtl: RichTextLabel = ui_role_label.get_node_or_null("MP8RoleRich")
+	if rtl == null:
+		rtl = RichTextLabel.new()
+		rtl.name = "MP8RoleRich"
+		rtl.bbcode_enabled = true
+		rtl.scroll_active = false
+		rtl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		rtl.set_anchors_preset(Control.PRESET_FULL_RECT)
+		var f: Font = ui_role_label.get_theme_font("font")
+		if f != null:
+			rtl.add_theme_font_override("normal_font", f)
+		var fs: int = ui_role_label.get_theme_font_size("font_size")
+		if fs > 0:
+			rtl.add_theme_font_size_override("normal_font_size", fs)
+		ui_role_label.add_child(rtl)
+
+	# ⚠️ 原 Label 的 modulate 是绿色 (0.61,0.81,0.53)，而 modulate **会往下传给子节点**，
+	# 不改的话红色会被乘成暗橄榄色。这里把它改成白色，颜色全交给 BBCode；
+	# alpha 仍旧由原来的淡入 tween 控制（那个 tween 只动 modulate:a，不碰 RGB）。
+	ui_role_label.modulate = Color(1.0, 1.0, 1.0, ui_role_label.modulate.a)
+	ui_role_label.text = ""
+
+	rtl.text = mp8_role_reveal_bbcode()
