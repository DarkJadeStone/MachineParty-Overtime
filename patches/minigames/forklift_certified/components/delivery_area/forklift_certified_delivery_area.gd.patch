+# ------------------------------------------------------------------------ [MP8]
+# 两人一队：`belongs_to_id` 是单个 int，而且一大堆判活代码靠
+# `belongs_to_id > check_id_threshold` 走，所以**不动它** —— 它仍然是队里第一个人。
+# 第二个人只在这里登记，唯一作用是让他也能看见自己那块区的射灯
+# （原版 `multiplayer.get_unique_id() == network_id` 那句只认得队长）。
+# 队伍逻辑（谁跟谁一队、一起淘汰、一起算分）全在 forklift_certified.gd 里，
+# 本文件只管"我这块区亮给谁看"。
+var mp8_member_ids: Array[int] = []
+
+@rpc("any_peer", "call_local", "reliable")
+func mp8_add_owner_rpc(network_id: int):
+
+	if not mp8_member_ids.has(network_id):
+		mp8_member_ids.append(network_id)
+
+	if multiplayer.get_unique_id() == network_id:
+		area_light.visible = true
+
+
+# ------------------------------------------------------------------ [MP8] 计分倍率
+# **单人队一个箱子算两个**（用户 2026-08-17 定）。
+# 5~7 人时队伍不等大（`[2,1,1,1]` 这种），2 人队约等于两倍收箱速度，
+# 而判定是"非最高分全淘汰" —— 不补偿的话单人队第一轮基本必死。
+#
+# 倍率由 forklift_certified._mp8_refresh_score_mults() 算好后广播下来，
+# 值 = 最大队人数 / 本队人数：≤4 人和 8 人全是 1（**与原版逐值一致**），
+# 5~7 人时只有单人队是 2。
+#
+# ⚠️ **计数牌显示算完倍率的分**（用户 2026-08-17 明确要求：单人区叉进 1 箱就显示 2）。
+# 三处必须是同一个数：淘汰判定、领先射灯、计数牌 ——
+# 玩家看到的必须就是裁判用的，藏着算分是派对游戏大忌。
+#
+# 唯一按**真实箱子数**走的是成就 `ach_crate_number`
+#（"真的叉够 4 箱"不该被倍率放水），见 forklift_certified._on_crate_numbers_changed。
+var mp8_score_mult: int = 1
+
+@rpc("any_peer", "call_local", "reliable")
+func mp8_set_score_mult_rpc(mult: int):
+
+	mp8_score_mult = maxi(1, mult)
+
+	# 倍率可能在局中变（队友掉线 → 剩下那个人变成单人队），牌面要当场跟上。
+	# ⚠️ `crates_in_area` 只有服务器在维护（body_entered 只在服务器接），
+	# 所以刷新只能由服务器算完再广播，不能各端自己算 —— 客户端算出来恒为 0。
+	if multiplayer.is_server():
+		update_counter_rpc.rpc(crates_in_area.size() * mp8_score_mult)
