+			])
+		for i in mini(rows.size(), _mp8_spawns.size()):
+			_mp8_spawns[i] = rows[i]
+		_mp8_spawns_src = "存盘文件（%d 行）" % rows.size()
+
+	print("[MP8] 叉车认证：出生点表 %d 个（%d 区 x %d 人），来源=%s" % [
+		_mp8_spawns.size(), area_count, MP8_TEAM_SIZE, _mp8_spawns_src
+	])
+
+
+func _mp8_load_layout_file() -> Array :
+
+	if not FileAccess.file_exists(MP8_LAYOUT_FILE):
+		return []
+
+	var f := FileAccess.open(MP8_LAYOUT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] 叉车认证：读不了 %s（错误 %d）" % [
+			MP8_LAYOUT_FILE, FileAccess.get_open_error()
+		])
+		return []
+
+	var rows: Array = []
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var parts: PackedStringArray = line.split(",", false)
+		if parts.size() < 2:
+			push_warning("[MP8] 叉车认证：布局文件这一行看不懂，跳过 —— '%s'" % line)
+			continue
+		var x: float = float(parts[0].strip_edges())
+		var z: float = float(parts[1].strip_edges())
+		var yaw: float = (float(parts[2].strip_edges()) if parts.size() >= 3 else 0.0)
+		rows.append([Vector3(x, 0.0, z), yaw])
+	f.close()
+	return rows
+
+
+func _mp8_save_layout_file() -> bool :
+
+	var f := FileAccess.open(MP8_LAYOUT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] 叉车认证：写不了 %s（错误 %d）" % [
+			MP8_LAYOUT_FILE, FileAccess.get_open_error()
+		])
+		return false
+
+	f.store_line("# 叉车认证（mp8game=16）出生点表 —— 两人一队，一块送货区两个位")
+	f.store_line("# 一行一个点：x, z, 朝向度数。**顺序不能乱**：")
+	f.store_line("#   第 1、2 行 = 0 号区那一队（主位、副位），第 3、4 行 = 1 号区，以此类推。")
+	f.store_line("#   区的顺序就是场景里 DropAreas 的子节点顺序。")
+	f.store_line("# 删掉本文件 = 回到内置值（主位=场景原版那 4 个点，副位=主位朝场地中心挪 %.1f 米）。" % MP8_MATE_OFFSET)
+	f.store_line("# 可以直接用记事本改。存于 %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for i in _mp8_spawns.size():
+		var r: Array = _mp8_spawns[i]
+		var p: Vector3 = r[0]
+		f.store_line("%.2f, %.2f, %.0f    # 区%d %s" % [
+			p.x, p.z, float(r[1]), i / MP8_TEAM_SIZE,
+			("主位" if i % MP8_TEAM_SIZE == 0 else "副位")
+		])
+	f.close()
+
+	print("[MP8] 叉车认证：出生点表已存盘（%d 个）→ %s" % [
+		_mp8_spawns.size(), ProjectSettings.globalize_path(MP8_LAYOUT_FILE)
+	])
+	return true
+
+
+# 局内手调 -------------------------------------------------------------------
+# 沿用碎骨者 -SpineEdit / 内部暗手 -KnifeEdit 那一套：只在 1 号窗口开，
+# 存盘落 user://，下次开局自动生效。
+
+func _mp8_edit_begin() -> void :
+
+	if _mp8_spawns.is_empty():
+		push_warning("[MP8] 叉车认证：出生点表是空的，手调模式不启动")
+		_mp8_edit_on = false
+		return
+
+	var lbl := Label.new()
+	lbl.name = "MP8ForkEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -190.0
+	lbl.offset_right = 1100.0
+	lbl.offset_bottom = -8.0
+	_mp8_style_label(lbl, Color(0.6, 0.95, 1.0))
+	_mp8_edit_layer().add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	_mp8_rebuild_markers()
+	_mp8_edit_check_keys()
+	_mp8_edit_refresh()
+
+	print("[MP8] 叉车认证：出生点手调已开 —— %d 个点，来源 %s" % [
+		_mp8_spawns.size(), _mp8_spawns_src
+	])
+
+
+func _mp8_edit_layer() -> CanvasLayer :
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+	return _mp8_edit_canvas
+
+
+# ⚠️ 必须显式指定游戏自己的字体：默认主题字体**字距是坏的**
+# （实测会把 "P3  id 104..." 显示成 "P36idc104..."）。猎鸭、残骸平台、枪械工厂都栽过。
+func _mp8_style_label(lbl: Label, color: Color) -> void :
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 22)
+	lbl.add_theme_color_override("font_color", color)
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+func _mp8_rebuild_markers() -> void :
+
+	for m in _mp8_markers:
+		if is_instance_valid(m):
+			m.queue_free()
+	_mp8_markers.clear()
+
+	var font = load("res://fonts/Terminal F4.ttf")
+
+	for i in _mp8_spawns.size():
+
+		var root := Node3D.new()
+		root.name = "MP8ForkMarker%d" % i
+		add_child(root)
+
+		var mi := MeshInstance3D.new()
+		var box := BoxMesh.new()
+		box.size = Vector3(MP8_CAR_HX * 2.0, 0.2, MP8_CAR_HZ * 2.0)   # 按叉车碰撞盒画，好看出叠没叠
+		mi.mesh = box
+		var mat := StandardMaterial3D.new()
+		mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+		mat.albedo_color = Color(0.2, 1.0, 0.3, 0.45)
+		mi.material_override = mat
+		mi.position.y = 0.1
+		root.add_child(mi)
+
+		# 朝向指示：往正前方伸一小截，好确认 yaw 对不对
+		var nose := MeshInstance3D.new()
+		var nb := BoxMesh.new()
+		nb.size = Vector3(0.18, 0.18, 1.2)
+		nose.mesh = nb
+		nose.material_override = mat
+		nose.position = Vector3(0.0, 0.35, -MP8_CAR_HZ - 0.6)
+		root.add_child(nose)
+
+		var tag := Label3D.new()
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 180
+		tag.outline_size = 36
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true      # 被墙挡住也要看得见，否则找不着自己在调哪个
+		if font != null:
+			tag.font = font
+		tag.text = "%d%s" % [i / MP8_TEAM_SIZE + 1, ("A" if i % MP8_TEAM_SIZE == 0 else "B")]
+		tag.position = Vector3(0.0, 3.0, 0.0)
+		root.add_child(tag)
+
+		_mp8_markers.append(root)
+
+	_mp8_sync_markers()
+
+
+func _mp8_sync_markers() -> void :
+
+	for i in _mp8_markers.size():
+		if i >= _mp8_spawns.size():
+			break
+		var root: Node3D = _mp8_markers[i]
+		if not is_instance_valid(root):
+			continue
+		var r: Array = _mp8_spawns[i]
+		root.global_position = r[0] as Vector3
+		root.rotation_degrees = Vector3(0.0, float(r[1]), 0.0)
+
+		# 颜色 = 判据结果：选中黄，合法绿，不合法红
+		var col := Color(0.2, 1.0, 0.3, 0.45)
+		if not _mp8_spawn_ok(i):
+			col = Color(1.0, 0.25, 0.2, 0.55)
+		if i == _mp8_edit_sel:
+			col = Color(1.0, 0.95, 0.2, 0.65)
+		for c in root.get_children():
+			if c is MeshInstance3D:
+				var m = (c as MeshInstance3D).material_override
+				if m is StandardMaterial3D:
+					(m as StandardMaterial3D).albedo_color = col
+
+
+# 三条判据，全是量出来的，不是拍脑袋：
+#   1. 车要在护栏里（probe60 的 side railing_002）；
+#   2. 两台车不能叠（碰撞盒 3.0 x 6.0，留 0.2 米余量）；
+#   3. 人该生在**自己那块区**里（原版就是这样，主位离自己区 0~1.17 米）。
+func _mp8_spawn_ok(i: int) -> bool :
+
+	var p: Vector3 = (_mp8_spawns[i] as Array)[0]
+
+	if absf(p.x) > MP8_FIELD_X - MP8_CAR_HX or absf(p.z) > MP8_FIELD_Z - MP8_CAR_HZ:
+		return false
+
+	for j in _mp8_spawns.size():
+		if j == i:
+			continue
+		var q: Vector3 = (_mp8_spawns[j] as Array)[0]
+		if absf(p.x - q.x) < MP8_CAR_HX * 2.0 + 0.2 and absf(p.z - q.z) < MP8_CAR_HZ * 2.0 + 0.2:
+			return false
+
+	var area_i: int = i / MP8_TEAM_SIZE
+	if area_i < delivery_area_parent.get_child_count():
+		var c: Vector3 = (delivery_area_parent.get_child(area_i) as Node3D).global_position
+		if absf(p.x - c.x) > MP8_ZONE_HX or absf(p.z - c.z) > MP8_ZONE_HZ:
+			return false
+
+	return true
+
+
+func _mp8_edit_check_keys() -> void :
+
+	var mine: Dictionary = {
+		KEY_Q: "上一个点", KEY_E: "下一个点",
+		KEY_I: "远", KEY_K: "近", KEY_J: "左", KEY_L: "右",
+		KEY_U: "左转", KEY_O: "右转",
+		KEY_5: "步长", KEY_0: "存盘", KEY_9: "复位", KEY_8: "打报告",
+	}
+	var clash := PackedStringArray()
+
+	for action in InputMap.get_actions():
+		for ev in InputMap.action_get_events(action):
+			var k := ev as InputEventKey
+			if k == null:
+				continue
+			for code in [k.keycode, k.physical_keycode]:
+				if code != 0 and mine.has(code):
+					clash.append("%s(%s)↔动作 %s" % [
+						OS.get_keycode_string(code), mine[code], String(action)
+					])
+
+	if clash.is_empty():
+		print("[MP8] 叉车认证：手调按键与游戏 InputMap 无冲突（查了 %d 个动作）" % InputMap.get_actions().size())
+	else:
+		push_warning("[MP8] 叉车认证：手调按键和游戏动作撞车 —— %s" % ", ".join(clash))
+		print("[MP8] 叉车认证：⚠️ 按键撞车 —— %s" % ", ".join(clash))
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or _mp8_spawns.is_empty():
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+	_mp8_edit_sel = clampi(_mp8_edit_sel, 0, _mp8_spawns.size() - 1)
+
+	match key.keycode:
+
+		KEY_Q, KEY_E:
+			var d: int = (-1 if key.keycode == KEY_Q else 1)
+			_mp8_edit_sel = posmod(_mp8_edit_sel + d, _mp8_spawns.size())
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			# 按**屏幕方向**推，不是世界坐标轴 —— 从当前相机基向量实时算。
+			# （枪械工厂 v1 就是没这么干才把桌子摆成一坨，见坑第 25 条。）
+			var dir := Vector2.ZERO
+			match key.keycode:
+				KEY_I: dir = Vector2(0, -1)
+				KEY_K: dir = Vector2(0, 1)
+				KEY_J: dir = Vector2(-1, 0)
+				KEY_L: dir = Vector2(1, 0)
+			var world := _mp8_screen_to_world(dir)
+			var moved: Array = _mp8_spawns[_mp8_edit_sel]
+			moved[0] = (moved[0] as Vector3) + world * step
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_U, KEY_O:
+			var dy: float = (- MP8_EDIT_YAW_STEP if key.keycode == KEY_U else MP8_EDIT_YAW_STEP)
+			var arr: Array = _mp8_spawns[_mp8_edit_sel]
+			arr[1] = fposmod(float(arr[1]) + dy, 360.0)
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_5:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_0:
+			_mp8_save_layout_file()
+			_mp8_edit_refresh()
+
+		KEY_9:
+			_mp8_build_spawns()
+			_mp8_rebuild_markers()
+			_mp8_edit_refresh()
+
+		KEY_8:
+			_mp8_edit_report()
+
+
+func _mp8_screen_to_world(dir: Vector2) -> Vector3 :
+
+	var cam := get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector3(dir.x, 0.0, dir.y)
+
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = -cam.global_transform.basis.z
+	right.y = 0.0
+	fwd.y = 0.0
+	if right.length() < 0.001 or fwd.length() < 0.001:
+		return Vector3(dir.x, 0.0, dir.y)
+	return (right.normalized() * dir.x + fwd.normalized() * -dir.y).normalized()
+
+
+func _mp8_edit_refresh() -> void :
+
+	if _mp8_edit_panel == null or not is_instance_valid(_mp8_edit_panel):
+		return
+
+	var r: Array = _mp8_spawns[_mp8_edit_sel]
+	var p: Vector3 = r[0]
+
+	var bad := PackedStringArray()
+	for i in _mp8_spawns.size():
+		if not _mp8_spawn_ok(i):
+			bad.append("%d%s" % [i / MP8_TEAM_SIZE + 1, ("A" if i % MP8_TEAM_SIZE == 0 else "B")])
+
+	_mp8_edit_panel.text = "\n".join([
+		"[叉车认证 出生点手调]  QE 选点   IJKL 推(屏幕方向)   UO 转   5 步长   0 存盘   9 复位   8 报告",
+		"当前 %d%s（区%d %s）  x=%.2f  z=%.2f  yaw=%.0f   步长 %.2f 米" % [
+			_mp8_edit_sel / MP8_TEAM_SIZE + 1,
+			("A" if _mp8_edit_sel % MP8_TEAM_SIZE == 0 else "B"),
+			_mp8_edit_sel / MP8_TEAM_SIZE, ("主位" if _mp8_edit_sel % MP8_TEAM_SIZE == 0 else "副位"),
+			p.x, p.z, float(r[1]), MP8_EDIT_STEPS[_mp8_edit_step_i],
+		],
+		"共 %d 个点（%s）  不合格：%s" % [
+			_mp8_spawns.size(), _mp8_spawns_src,
+			("无" if bad.is_empty() else ", ".join(bad)),
+		],
+	])
+
+
+func _mp8_edit_report() -> void :
+
+	print("[MP8] 叉车认证：出生点报告（%d 个，来源 %s）" % [_mp8_spawns.size(), _mp8_spawns_src])
+	for i in _mp8_spawns.size():
+		var r: Array = _mp8_spawns[i]
+		var p: Vector3 = r[0]
+		print("   %d%s  区%d %-4s  (%7.2f, %7.2f)  yaw=%4.0f   %s" % [
+			i / MP8_TEAM_SIZE + 1, ("A" if i % MP8_TEAM_SIZE == 0 else "B"),
+			i / MP8_TEAM_SIZE, ("主位" if i % MP8_TEAM_SIZE == 0 else "副位"),
+			p.x, p.z, float(r[1]),
+			("OK" if _mp8_spawn_ok(i) else "❌ 出界/叠车/不在自己区里"),
+		])
+
+	var worst: float = INF
+	for a in _mp8_spawns.size():
+		for b in range(a + 1, _mp8_spawns.size()):
+			var pa: Vector3 = (_mp8_spawns[a] as Array)[0]
+			var pb: Vector3 = (_mp8_spawns[b] as Array)[0]
+			worst = minf(worst, Vector2(pa.x - pb.x, pa.z - pb.z).length())
+	print("   彼此最小间距 %.2f 米（车身 3.0 x 6.0）" % worst)
