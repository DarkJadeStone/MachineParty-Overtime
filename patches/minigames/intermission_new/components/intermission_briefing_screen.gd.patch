+# [MP8] 邀请按钮：空位上的"点邀请好友"区域。原版 4 套，和玩家条一一对应。
+#
+# ⚠️ 这里有个坑：这两个数组**不在同一个坐标系**（probe69 量的实况）。
+#   invite_buttons_visuals   = SubViewport 内的 InviteButton0..3
+#                              （面板坐标，父节点 InviteButtonParent 在 y=69.25，
+#                                按钮 offset_top = 3.5 / 22.25 / 41.0 / 59.75，步长 18.75）
+#   invite_buttons_interacts = 屏幕覆盖层的 InviteOverlayButton0..3
+#                              （屏幕坐标，offset_top = 124 / 172 / 210 / 248，
+#                                注意**步长不均匀**：48 / 38 / 38，是人手摆的）
+# 真正能点的是后者，前者只是 ButtonClass 的 custom_ui_target（悬停时改透明度）。
+#
+# 🩸 旧版本这里错了两处，是用户 2026-08-18 报的"错位、只有三个"的成因：
+#   ① 映射系数取 (act[1]-act[0])/(vis[1]-vis[0]) = 48/18.75 = 2.56 ——
+#      正好取到那个**异常的第一段**（真实三段是 48/38/38）。
+#      改成对全部原始点做最小二乘拟合，斜率约 2.19。
+#   ② 只有 4 套，而 MP8 有 8 条玩家条 —— 见 _mp8_extend_invite_buttons。
+# （点击区跟着缩放那一条旧版本本来就是对的，保留。）
+var _mp8_inv_fit_ok: bool = false
+var _mp8_inv_k: float = 0.0        # 面板 y → 屏幕 y 的斜率
+var _mp8_inv_b: float = 0.0        # 截距
+var _mp8_inv_act_scale: Vector2 = Vector2.ONE
+
+
+# 拿原始的 4 对 (面板 y, 屏幕 y) 做最小二乘，得到两套坐标系之间的映射。
+# 用全部点而不是头两个：原版第一段间距是异常值，只看它会把后面几个越推越偏。
+func _mp8_fit_invite_mapping() -> void :
+
+	var vis: Array[Button] = invite_buttons_visuals
+	var act: Array[Button] = invite_buttons_interacts
+	var n: int = mini(vis.size(), act.size())
+	if n < 2:
+		return
+
+	var xs: Array[float] = []
+	var ys: Array[float] = []
+	for i in n:
+		if is_instance_valid(vis[i]) and is_instance_valid(act[i]):
+			xs.append(vis[i].position.y)
+			ys.append(act[i].position.y)
+	if xs.size() < 2:
+		return
+
+	var mx: float = 0.0
+	var my: float = 0.0
+	for i in xs.size():
+		mx += xs[i]
+		my += ys[i]
+	mx /= float(xs.size())
+	my /= float(xs.size())
+
+	var num: float = 0.0
+	var den: float = 0.0
+	for i in xs.size():
+		num += (xs[i] - mx) * (ys[i] - my)
+		den += (xs[i] - mx) * (xs[i] - mx)
+	if absf(den) < 0.0001:
+		return
+
+	_mp8_inv_k = num / den
+	_mp8_inv_b = my - _mp8_inv_k * mx
+	_mp8_inv_act_scale = act[0].scale if is_instance_valid(act[0]) else Vector2.ONE
+	_mp8_inv_fit_ok = true
+
+	print("[MP8] 邀请按钮映射：屏幕y = %.4f × 面板y + %.2f（%d 个原始点拟合）" % [
+		_mp8_inv_k, _mp8_inv_b, xs.size()])
+
+
+# [MP8] 把邀请按钮从 4 套补到 8 套，并把每条玩家条接到**自己**那一套。
+#
+# 🩸 不补的后果就是用户看到的现象。玩家条是用 duplicate() 复制出来的，
+#    而 duplicate() **不重映射 @export 引用**（坑第 14 条）：
+#    4~7 号条的 invite_visual_button / invite_interact_button 全都指着 0 号条那一套。
+#    于是 2 人局（0/1 号是玩家，2~7 号是空位）时：
+#      2 号 → InviteButton2 亮，3 号 → InviteButton3 亮，
+#      4/5/6/7 号 → 全都去点亮 InviteButton0
+#    → **屏幕上只有 3 个邀请按钮**，其中一个还压在 0 号玩家那一行上（"错位"）。
+#
+# 复制时要重接的引用（都是 duplicate() 不会帮你改的）：
+#   · 覆盖层按钮的 ButtonClass.custom_ui_target → 必须指向**新的**视觉按钮，
+#     否则悬停新按钮时闪的是 0 号那个；
+#   · 玩家条的两个 @export → 指向新的一套；
+#   · pressed 信号 → setup_invite_buttons() 已经跑过了（_ready 里在扩位之前），
+#     运行时连的 lambda 不会被 duplicate 带走，必须自己连。
+# ButtonClass 里的 speaker_press / speaker_hover 是**相对路径**，
+# 副本挂在同一个父节点下、深度一致，所以那两条不用动。
+func _mp8_extend_invite_buttons(target: int) -> void :
+
+	var vis: Array[Button] = invite_buttons_visuals
+	var act: Array[Button] = invite_buttons_interacts
+	if vis.size() == 0 or not is_instance_valid(vis[0]):
+		print("[MP8] 邀请按钮：场景里一个都没有，跳过")
+		return
+
+	# ⚠️ 映射必须在**动任何东西之前**拟合：下面摆位会把原始几何覆盖掉。
+	_mp8_fit_invite_mapping()
+
+	var n0: int = vis.size()
+	if n0 >= target:
+		return
+
+	var vis_parent: Node = vis[0].get_parent()
+	var act_parent: Node = act[0].get_parent() if (act.size() > 0 and is_instance_valid(act[0])) else null
+
+	for i in range(n0, target):
+		# ---- 视觉件 ----------------------------------------------------
+		var v: Button = vis[0].duplicate()
+		v.name = "MP8InviteButton%d" % i
+		v.visible = false
+		vis_parent.add_child(v)
+		vis.append(v)
+
+		# ---- 点击区 ----------------------------------------------------
+		if act_parent != null:
+			var a: Button = act[0].duplicate()
+			a.name = "MP8InviteOverlayButton%d" % i
+			a.visible = false
+			act_parent.add_child(a)
+			act.append(a)
+
+			# 悬停高亮的目标必须换成新的视觉件，否则闪的是 0 号
+			var bc: Node = a.get_node_or_null("ButtonClass")
+			if bc != null:
+				bc.set("custom_ui_target", v)
+
+			# _ready 里的 setup_invite_buttons() 早就跑完了，新按钮得自己接
+			if not GameManager.local_game:
+				a.pressed.connect(func():
+					Steam.activateGameOverlayInviteDialog(
+						NetworkManager.active_backend.lobby_id
+					)
+				)
+
+	# ---- 把每条玩家条接到自己那一套（0~3 号本来就是对的，4~7 号在此纠正）----
+	var fixed: int = 0
+	for i in user_container_array.size():
+		var uc = user_container_array[i]
+		if not is_instance_valid(uc):
+			continue
+		if i < vis.size() and is_instance_valid(vis[i]):
+			if uc.get("invite_visual_button") != vis[i]:
+				uc.set("invite_visual_button", vis[i])
+				fixed += 1
+		if i < act.size() and is_instance_valid(act[i]):
+			uc.set("invite_interact_button", act[i])
+
+	# 本地单机局整屏不给邀请（_ready 里已经把原版那 4 个关掉了，新增的补上）
+	if GameManager.local_game:
+		for b in vis:
+			if is_instance_valid(b):
+				b.visible = false
+		for b in act:
+			if is_instance_valid(b):
+				b.visible = false
+
+	print("[MP8] 邀请按钮：%d -> %d 套（视觉 %d / 点击区 %d），重接了 %d 条玩家条的悬空引用" % [
+		n0, target, vis.size(), act.size(), fixed])
+
+
+# [MP8] 邀请按钮的盒子高度占行距的比例。
+#
+# 为什么要单独收这一下（2026-08-18 看实机截图定的）：按钮高度是 anchor 驱动的
+# （anchor_bottom - anchor_top = 0.4 × 父高），运行时算出来**约等于一整行的行距**。
+# 4 行时行距 19，看着还行；压到 8 行、行距 9.5 之后，相邻两个盒子的边框直接贴死，
+# 六个空位连成一张表格，不像六个按钮。收到 0.78 就能露出缝。
+# ⚠️ 只收盒子高度，**不动字号**（字号在 theme_override 里，本来就只有 12×0.5，再小就糊了）。
+const MP8_INVITE_H_RATIO: float = 0.78
+
+var _mp8_invite_h_done: bool = false
+
+
+func _mp8_align_invite_buttons(s: float, step: float) -> void :
+
+	var vis: Array[Button] = invite_buttons_visuals
+	if vis.size() == 0:
+		return
+	var act: Array[Button] = invite_buttons_interacts
+
+	for i in vis.size():
+		# 原版 y = 3.5 + i×18.75，即"比玩家条低 3.5"，等比缩放后保持这层关系
+		var new_y: float = float(i) * step + 3.5 * s
+
+		if is_instance_valid(vis[i]):
+			# 先收高度再摆位：anchor 一改会重新算 rect，顺序反了位置会被冲掉。
+			# 加 _mp8_invite_h_done 是防重入 —— 这个函数万一被调两次，
+			# 比例会连乘两遍，盒子越缩越扁。
+			if not _mp8_invite_h_done:
+				var span: float = vis[i].anchor_bottom - vis[i].anchor_top
+				vis[i].anchor_bottom = vis[i].anchor_top + span * MP8_INVITE_H_RATIO
+			vis[i].scale = Vector2(s, s)
+			vis[i].position.y = new_y
+
+		# 点击区：走拟合出来的映射，并且**跟着一起缩小**——
+		# 不缩的话 8 行时相邻点击区会互相压住（原版点击区高约 36 屏幕像素，
+		# 而 8 行的行距映射过去只有约 21）。
+		if _mp8_inv_fit_ok and i < act.size() and is_instance_valid(act[i]):
+			act[i].position.y = _mp8_inv_k * new_y + _mp8_inv_b
+			act[i].scale = _mp8_inv_act_scale * s
+
+	_mp8_invite_h_done = true
+
