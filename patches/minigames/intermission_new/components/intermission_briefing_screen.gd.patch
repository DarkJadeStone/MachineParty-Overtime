+# 8 人下后 4 个人根本不显示分数。
+#
+# 做法沿用大厅排布那条血泪教训：**复制现成的条目，让原有代码去摆位置，不自己算坐标。**
+# reset_briefing_rpc() 本来就会按 rank_y_positions[i] 给每条设 y，
+# 所以这里只要把条目补到 8 个、把 y 坐标表按原间距续到 8 个即可，排序/填数据的代码一行不用动。
+func _mp8_extend_score_slots() -> void :
+
+	var target: int = NetworkManager.MAX_PLAYERS
+	var n: int = user_container_array.size()
+
+	if n == 0 or n >= target:
+		return
+
+	var src = user_container_array[0]
+	if not is_instance_valid(src):
+		return
+
+	var parent: Node = src.get_parent()
+	if parent == null:
+		return
+
+	for i in range(n, target):
+		var dup = src.duplicate()
+		dup.name = "MP8UserContainer%d" % i
+		parent.add_child(dup)
+		user_container_array.append(dup)
+
+	# ---- 排版：8 条必须缩小才塞得下 ----------------------------------------
+	# 面板几何（probe13/15 从原装 PCK 量出来的确定值，单位是"面板单位"，
+	# 整块 UI 被父节点 scale 4 倍后画进 1920×1080 的 SubViewport）：
+	#
+	#   玩家条起点 y = 69.25（user data container parent 的位置）
+	#   行间距       = 19        文字高 = 字号 221 × 0.06703 ≈ 14.8
+	#   准备按钮     y = 149.5   （local_ready_button 在 147.6）
+	#   进度条框     y = 227.5
+	#
+	# 于是可用高度只有 149.5 - 67.5 ≈ 79.5，而 8 条按原间距要 7×19+14.8 = 148，
+	# **原尺寸怎么排都塞不下**（哪怕把准备按钮压到进度条上也差 10 个单位）。
+	# 所以必须整条缩小：缩放 s、间距 19×s，占用 147.8×s ≤ 79.5 → s ≤ 0.538。
+	# 取 s = 0.5 / 间距 9.5：8 条占 73.9，完全落在原本 4 条的地盘里，
+	# **准备按钮、进度条、分页线一个都不用动**（改别的元素才是风险）。
+	var s: float = MP8_ROW_SCALE
+	var step: float = MP8_ROW_STEP
+	for a in OS.get_cmdline_args():
+		var t: String = String(a)
+		if t.begins_with("mp8row="):
+			var parts: PackedStringArray = t.substr(7).split(",")
+			if parts.size() >= 1 and parts[0] != "":
+				s = float(parts[0])
+			if parts.size() >= 2 and parts[1] != "":
+				step = float(parts[1])
+
+	var base_y: float = rank_y_positions[0] if rank_y_positions.size() > 0 else 0.0
+	rank_y_positions.clear()
+	for i in target:
+		rank_y_positions.append(base_y + float(i) * step)
+
+	for uc in user_container_array:
+		uc.scale = Vector2(s, s)
+
+	# 邀请按钮：先补到 8 套并把每条玩家条接到自己那一套，再按行距摆位。
+	# 顺序不能反 —— 摆位要对全部 8 套生效。
+	_mp8_extend_invite_buttons(target)
+	_mp8_align_invite_buttons(s, step)
+
+	# ⚠️ 这一屏还有另外两个**按玩家下标索引**的定长数组，必须一起补到 8。
+	# 只补 user_container_array 会直接导致原生崩溃（0xc0000005）：
+	#   sort_user_containers_by_score():  score_container_nodes[i] = ...   ← 越界【写】
+	#   show_score_nodes() / update_players():  speakers_show_player_card[i].play()  ← 越界【读】
+	# 发行版模板不带边界检查，越界写就是访问违例。
+	# （2026-08-14 实测：只补一个数组时 duck_hunt / dvd_roomba 必崩，
+	#   disco_dodge 侥幸不崩只是执行顺序的运气，并不安全。）
+	while score_container_nodes.size() < target:
+		score_container_nodes.append(user_container_array[score_container_nodes.size()])
+
+	# 音源只需要"数组够长、索引不越界"，**不要往场景树里塞新节点**。
+	# 试过用 duplicate() 建 4 个新 AudioStreamPlayer，结果整个流程卡在 SessionIntro
+	# 推进不下去（2026-08-14 实测，mp8noscore 关掉本函数即恢复正常）。
+	# 这里改成循环复用已有音源：第 5~8 张卡的音效会重触发前 4 个音源，
+	# 顶多是听感上少一层叠音，功能与稳定性都没有代价。
+	var spk_n: int = speakers_show_player_card.size()
+	if spk_n > 0:
+		while speakers_show_player_card.size() < target:
+			speakers_show_player_card.append(
+				speakers_show_player_card[speakers_show_player_card.size() % spk_n]
+			)
+
+	print("[MP8] 结算记分板：玩家条 %d->%d, score_container %d, 音源 %d, 缩放 %.2f, 间距 %.2f, y表 %s" % [
+		n, user_container_array.size(), score_container_nodes.size(),
+		speakers_show_player_card.size(), s, step, str(rank_y_positions)
+	])
+
