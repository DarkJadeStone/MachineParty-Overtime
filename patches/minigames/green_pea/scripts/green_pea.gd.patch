+# 椅子实体：左右各拿一张原版椅子复制。
+# ⚠️ 父节点 `walls` 的 basis 实测是**单位阵**（probe48 逐级验过），所以可以直接改 position；
+#    换了版本万一不是单位阵，得按坑第 27 条用 basis.inverse() 换算，别直接平移。
+func _mp8_add_chairs(left_src: Node3D, right_src: Node3D) -> void :
+
+	var walls := get_node_or_null("pea dinner scene4/walls")
+	if walls == null:
+		print("[MP8] 吃豆子：找不到 walls，新座位没有椅子")
+		return
+
+	var chair_l := walls.get_node_or_null("chair player0")   # 左，z≈1.29
+	var chair_r := walls.get_node_or_null("chair player3")   # 右，z≈1.29
+	if chair_l == null or chair_r == null:
+		print("[MP8] 吃豆子：找不到模板椅子，新座位没有椅子")
+		return
+
+	# 椅子的 z 和出生点的 z 差一点（实测 0.07 米）——**现算这个差**，不写死
+	var off_l: float = chair_l.position.z - left_src.position.z
+	var off_r: float = chair_r.position.z - right_src.position.z
+
+	var n: int = 0
+	for z in MP8_NEW_SEAT_Z:
+		for pair in [[chair_l, off_l], [chair_r, off_r]]:
+			var src: Node3D = pair[0]
+			var d: Node3D = src.duplicate()
+			d.name = "MP8Chair%d" % n
+			walls.add_child(d)
+			d.transform = src.transform
+			d.position = Vector3(src.position.x, src.position.y, z + float(pair[1]))
+			n += 1
+
+	print("[MP8] 吃豆子：新增椅子 %d 张" % n)
+
