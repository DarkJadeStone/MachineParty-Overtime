+# 血迹：`decals_by_seat_index` 是按座位下标索引的定长 4 项数组（坑第 13 条那个模式），
+# 5~8 号会越界读。复制**同侧最近**那一组，整组沿世界 z 平移过去。
+# ⚠️ 组自己带 yaw（seat1/seat3 是 -180°），但 position 在父空间、父节点是单位阵，
+#    所以直接加 z 就是世界平移；组内子件跟着整组走，不用管它们的局部朝向。
+func _mp8_extend_decals(base: int) -> void :
+
+	var coach = coach_handler.coach if coach_handler != null else null
+	if coach == null or coach.decals_by_seat_index == null:
+		return
+
+	var arr: Array = coach.decals_by_seat_index
+	if arr.size() != base:
+		print("[MP8] 吃豆子：血迹数组 %d 项（预期 %d），跳过扩位" % [arr.size(), base])
+		return
+
+	for i in range(base, _mp8_seat_z.size()):
+
+		var v: int = _mp8_nearest_vanilla(i, base)
+		var src = arr[v]
+		if src == null or not is_instance_valid(src):
+			arr.append(null)
+			continue
+
+		var d: Node3D = src.duplicate()
+		src.get_parent().add_child(d)
+		d.name = "MP8Decals%d" % i
+		d.transform = src.transform
+		d.position = src.position + Vector3(0.0, 0.0, _mp8_seat_z[i] - _mp8_seat_z[v])
+		d.visible = false
+		arr.append(d)
+
+	print("[MP8] 吃豆子：血迹组 %d → %d" % [base, arr.size()])
+
+
+# 教练动画就近映射：新座位借**同侧、z 最近**那个原版席位的动画。
