+func _mp8_setup_seats() -> void :
+
+	if player_spawn_positions == null:
+		push_warning("[MP8] 吃豆子：没有出生点容器，8 席不做")
+		return
+
+	var base: int = player_spawn_positions.get_child_count()
+	if base != 4:
+		print("[MP8] 吃豆子：出生点有 %d 个（预期 4），版本可能变了，8 席不做" % base)
+		return
+
+	# 原版 4 席的 z **现读**，不抄坐标（抄坐标是这个项目翻过车的事）
+	_mp8_seat_z.clear()
+	for i in base:
+		_mp8_seat_z.append(player_spawn_positions.get_child(i).position.z)
+
+	# 左右各取一个原版 Marker 当模板：x / y / 朝向全部沿用它的，只改 z
+	var left_src: Node3D = null
+	var right_src: Node3D = null
+	for i in base:
+		var m: Node3D = player_spawn_positions.get_child(i)
+		if m.position.x < 0.0:
+			if left_src == null:
+				left_src = m
+		elif right_src == null:
+			right_src = m
+
+	if left_src == null or right_src == null:
+		print("[MP8] 吃豆子：认不出左右两侧的出生点，8 席不做")
+		return
+
+	# ① 出生点：每个新 z 各加左右两个，顺序 = 左、右（和原版的左右交替一致）
+	for z in MP8_NEW_SEAT_Z:
