+# 场地中心的参考系。
+#
+# ⚠️⚠️ **`Minigame extends Node`，不是 Node3D** —— 本脚本的 `self` 上**没有**
+# `global_transform`/`global_position`。第一版在这里和 _mp8_node_direction 里
+# 直接写了 `global_transform`，`tools\build.ps1` **照样编译通过**
+# （gdre 不做基类标识符解析），但游戏一加载就是
+#   `Parse Error: Identifier "global_transform" not declared in the current scope`
+#   → 整个脚本 load 失败 → chisel_gauntlet 节点没有脚本 → 三个 Array[Node] 导出
+#     接不上（`Failed to get property 'speakers_switches'`）→ 小游戏永远起不来，
+#     表面症状是"卡在 SessionIntro"，跟 4→8 一点关系都没有。
+# **教训：编译通过 ≠ 能跑。判据只有一条 —— 日志里没有 `Parse Error`。**
+#
+# 用 `PlayerSpawnNode` 当基准：它是 Node3D，而且**定义上就是座位圆的圆心**
+# （spawn_players() 里所有人都被 teleport 到它的 global_position，靠 yaw 分方位）。
+# 比"小游戏根节点"更贴题，也不用假设场地在世界原点。
+func _mp8_field_transform() -> Transform3D :
+	if player_spawn_node != null:
+		return player_spawn_node.global_transform
+	return Transform3D.IDENTITY
+
+
+# 绕**场地中心**的 Y 轴把 dup 转 delta 度。
+#
+# ⚠️ 不能直接写 `dup.rotate_y()`：那是绕节点**自己**的原点转。
+# 所以统一在场地中心空间里左乘一个 Y 旋转。
+func _mp8_rotate_about_center(dup: Node3D, src: Node3D, delta_deg: float) -> void :
+	var base: Transform3D = _mp8_field_transform()
+	var rot := Transform3D(Basis(Vector3.UP, deg_to_rad(delta_deg)), Vector3.ZERO)
+	dup.global_transform = base * rot * base.affine_inverse() * src.global_transform
+
+
+# 一个节点在场地里的方位角（度，0 = 根节点的 +Z 方向）。
+# 网格件用**网格 AABB 的中心**而不是节点原点 —— 这些美术件全都摆在原点、
+# 只有 yaw 不同，节点原点算出来是 (0,0)，方位角毫无意义（美术把真实摆位烘进了网格）。
+func _mp8_node_direction(n: Node3D) -> float :
+
+	if n == null:
+		return 0.0
+
+	var p: Vector3 = n.global_position
+	var m = n.get("mesh")
+	if m != null and m is Mesh:
+		var ab: AABB = (m as Mesh).get_aabb()
+		p = n.global_transform * (ab.position + ab.size * 0.5)
+
+	var local: Vector3 = _mp8_field_transform().affine_inverse() * p
+	return _mp8_wrap360(rad_to_deg(atan2(local.x, local.z)))
+
+
+# 座位（= 一个 yaw）在场地里的方位角。玩家根节点在原点、只转 yaw，
+# 真正把人推出去的是 ./Visuals 的局部偏移，所以方位 = 偏移被 yaw 转过之后的朝向。
+func _mp8_seat_direction(visuals_offset: Vector3, yaw_deg: float) -> float :
+	var v: Vector3 = Basis(Vector3.UP, deg_to_rad(yaw_deg)) * visuals_offset
+	return _mp8_wrap360(rad_to_deg(atan2(v.x, v.z)))
+
