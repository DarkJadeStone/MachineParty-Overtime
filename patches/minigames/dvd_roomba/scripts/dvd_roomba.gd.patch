+# [MP8] 结算时把名次/名字/得分打进日志（不改任何分数）。
+# 格式与残骸平台、碎骨者、吃豆子一致，几个名次制小游戏对照着看方便。
+# ⚠️ 特别把「在场人数」和「阵亡人数」都打出来：两者差值 > 1 就说明有人掉线，
+# 而掉线正是本次唯一要修的东西 —— 不打出来没法验证修没修对。
+func _mp8_log_scores() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var keys: Array = player_scores.keys()
+	keys.sort_custom(func(a, b): return player_scores[a] > player_scores[b])
+
+	var parts: PackedStringArray = []
+	for i in keys.size():
+		var nid = keys[i]
+		var nm: String = "id%d" % nid
+		if PlayerManager.player_presences.has(nid):
+			nm = String(PlayerManager.player_presences[nid].network_name)
+		parts.append("第%d名 %s %d分" % [i + 1, nm, player_scores[nid]])
+
+	print("[MP8] 致命反弹结算（开局 %d 人 / %d 人阵亡 / 幸存者拿 %d 分）：%s" % [
+		player_count, dead_players.size(), dead_players.size() + 1, " / ".join(parts)
+	])
+
+
+# [MP8] 把出生点补到 8 个，摆成正八边形。原版 4 个一个字节不动。
+#
+# ⚠️ 只补不够的数量：万一以后场景自己就给了 8 个，这里不重复补。
+# ⚠️ 全部从原版点**现算**，不写死坐标 —— 场景挪了位置这段也跟着对。
+func _mp8_topup_spawns() -> void :
+
+	if player_spawn_parent_node == null:
+		push_warning("[MP8] 致命反弹：没有出生点容器，8 席不做")
+		return
+
+	var originals: Array = []
+	for c in player_spawn_parent_node.get_children():
+		if c is Node3D:
+			originals.append(c)
+
+	var n: int = originals.size()
+	if n == 0 or n >= 8:
+		return
+
+	# 中心 = 原版点的形心；半径 = 到形心的平均距离
+	var center: Vector3 = Vector3.ZERO
+	for o in originals:
+		center += o.position
+	center /= float(n)
+
+	var radius: float = 0.0
+	for o in originals:
+		radius += Vector2(o.position.x - center.x, o.position.z - center.z).length()
+	radius /= float(n)
+
+	# 原版各点的角度，排序后取相邻两个的中分角当新点方向
+	var angles: Array = []
+	for o in originals:
+		angles.append(atan2(o.position.z - center.z, o.position.x - center.x))
+	angles.sort()
+
+	var added := PackedStringArray()
+
+	for i in angles.size():
+
+		if originals.size() + added.size() >= 8:
+			break
+
+		var a: float = angles[i]
+		var b: float = float(angles[(i + 1) % angles.size()])
+		if b <= a:
+			b += TAU                       # 跨过 -π/π 那一段，别算出反方向
+		var mid: float = (a + b) * 0.5
+
+		var p: Vector3 = Vector3(
+			center.x + cos(mid) * radius,
+			originals[0].position.y,
+			center.z + sin(mid) * radius
+		)
+
+		# 模板取离新点最近的原版点：旋转/缩放/脚本就近继承
+		var tmpl: Node3D = originals[0]
+		var best: float = INF
+		for o in originals:
+			var d: float = o.position.distance_to(p)
+			if d < best:
+				best = d
+				tmpl = o
+
+		var dup: Node3D = tmpl.duplicate()
+		dup.name = "MP8Spawn%d" % (n + added.size())
+		player_spawn_parent_node.add_child(dup)
+		dup.position = p
+		added.append("(%.2f, %.2f)" % [p.x, p.z])
+
+	# 自检：把最小间距打出来。**两点重合正是这类补位最典型的坏法**
+	# （原版容器补位在本小游戏上就会算出两个 (0,0)，见本文件顶部那段），
+	# 光看"4 -> 8 成功"这行日志是看不出来的。
+	var pts: Array = []
+	for c in player_spawn_parent_node.get_children():
+		if c is Node3D:
+			pts.append(c.position)
+
+	var min_d: float = INF
+	for i in pts.size():
+		for j in range(i + 1, pts.size()):
+			min_d = minf(min_d, Vector2(pts[i].x - pts[j].x, pts[i].z - pts[j].z).length())
+
+	print("[MP8] 致命反弹：出生点 %d → %d（中心 (%.2f, %.2f) 半径 %.2f，最小间距 %.2f 米）新增 %s" % [
+		n, pts.size(), center.x, center.z, radius, min_d, " ".join(added)
+	])
+
