+	cam.position = Vector3(0.0, 26.0, 0.0)
+	cam.rotation_degrees = Vector3(- 89.0, 0.0, 0.0)
+	cam.fov = 60.0
+	add_child(cam)
+	_mp8_edit_cam = cam
+	cam.current = true
+	_mp8_edit_overview = true
+
+	print("[MP8] 人工筛选：-BurnEdit 已开（QE 选工位 / IJKL 推 / UO 转 / T 切视角 / G 联动 / P 暂停 / V 操作平台 / B 静态平台 / 5 步长 / 0 存盘 / 9 复位 / 8 报告）")
+	print("[MP8] 人工筛选：联动默认**开** —— 调新增四个里的任意一个，另外三个在各自局部系里同样地动")
+	_mp8_edit_refresh()
+
+
+# [MP8] 暂停 / 继续（P 键）—— **整局暂停，8 个实例一起停**（用户 2026-08-18 定）。
+#
+# 摆位时货物还在往前走、倒计时还在跑，很难对准。而且这局是联机的：
+# 只冻房主没有意义 —— 服务器那边回合照跑、货照发，一放开就跳一大截。
+# 所以 P 由房主按下，走 RPC 让**每一端各自冻住自己的树**。
+#
+# ### 为什么不是直接 get_tree().paused = true 就完事
+#
+# 暂停后本节点的 `_unhandled_key_input` 也会停 —— 按 P 就再也恢复不了，编辑模式当场变砖。
+# 所以要把**本节点**设成 PROCESS_MODE_ALWAYS（键盘继续响应），
+# 同时把它的**每个直接子节点**显式设成 PAUSABLE。
+# ⚠️ 这一步不能省：`PROCESS_MODE_INHERIT` 继承的是父节点的**生效模式**，
+# 父节点一旦是 ALWAYS，所有 INHERIT 的后代都跟着 ALWAYS —— 那就等于没暂停。
+# 子节点显式设成 PAUSABLE 之后，它们自己的后代再 INHERIT 就正常冻住了
+# （round_timer、状态机、玩家、传送带补间全在里面）。
+# 恢复时把原来的模式逐个还回去，不留痕。
+#
+# ### 暂停期间 RPC 还收得到吗 —— 收得到，这条是解冻的命根子
+#
+# `SceneTree.paused` 关掉的是**节点的** `_process` / `_physics_process` / `_input`，
+# 多人网络的 poll 是 SceneTree 层面的事，不受它影响；
+# 而且本节点在暂停期间是 PROCESS_MODE_ALWAYS。所以房主按 P 解冻的那条 RPC
+# 一定送得到每一端。（这是本做法成立的前提，别把本节点改回 PAUSABLE。）
+#
+# ### 客户端不需要开编辑模式
+#
+# `_mp8_pause_rpc` 与 `_mp8_edit_on` 无关：8 个实例里只有 1 号开了 -BurnEdit，
+# 其余 7 个照样得冻。所以判活逻辑放在 RPC 里，不放在按键处理里。
+@rpc("authority", "call_local", "reliable")
+func _mp8_pause_rpc(on: bool) -> void :
+
+	if on == _mp8_paused:
+		return
+
+	if on:
+		_mp8_pause_modes = []
+		for c in get_children():
+			_mp8_pause_modes.append([c, c.process_mode])
+			if c.process_mode == Node.PROCESS_MODE_INHERIT:
+				c.process_mode = Node.PROCESS_MODE_PAUSABLE
+		process_mode = Node.PROCESS_MODE_ALWAYS
+		if _mp8_edit_canvas != null:
+			_mp8_edit_canvas.process_mode = Node.PROCESS_MODE_ALWAYS
+		get_tree().paused = true
+		_mp8_paused = true
+		print("[MP8] 人工筛选：⏸ 整局已暂停")
+	else:
+		get_tree().paused = false
+		process_mode = Node.PROCESS_MODE_INHERIT
+		for e in _mp8_pause_modes:
+			var n: Node = e[0]
+			if n != null and is_instance_valid(n):
+				n.process_mode = e[1]
+		_mp8_pause_modes = []
+		_mp8_paused = false
+		print("[MP8] 人工筛选：▶ 整局已继续")
+
+	if _mp8_edit_panel != null:
+		_mp8_edit_refresh()
+
+
+func _mp8_edit_toggle_pause() -> void :
+
+	# @rpc("authority") 只有服务器发得出去。房主 = 1 号窗口 = 开编辑模式的那个，
+	# 所以正常路径永远走得通；万一在客户端按到了，退化成只冻本机，别静默什么都不做。
+	if multiplayer.is_server():
+		_mp8_pause_rpc.rpc(not _mp8_paused)
+	else:
+		push_warning("[MP8] 人工筛选：这不是房主端，P 只冻本机（整局暂停要在 1 号窗口按）")
+		_mp8_pause_rpc(not _mp8_paused)
+
+
+func _mp8_edit_seat_camera(seat: int) -> void :
+
+	# 切到某个工位「本人看出去」的取景。摄像机在玩家场景内部，
+	# 平时只有本人那端 current=true；在本机把它设 current 不影响别人。
+	var p = _mp8_seat_players.get(seat)
+	if p == null or not is_instance_valid(p):
+		print("[MP8] 人工筛选：%d 号工位还没有玩家实例，切不了本人视角" % seat)
+		return
+
+	var cam: Camera3D = null
+	for n in (p as Node).find_children("*", "Camera3D", true, false):
+		cam = n
+		break
+
+	if cam == null:
+		print("[MP8] 人工筛选：%d 号工位的玩家实例里找不到 Camera3D" % seat)
+		return
+
+	cam.current = true
+	_mp8_edit_overview = false
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on:
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = float(MP8_EDIT_STEPS[_mp8_edit_step_i])
+	var moved: bool = true
+
+	match key.keycode:
+		KEY_Q:
+			_mp8_edit_sel = (_mp8_edit_sel - 1 + mp8_seats) % mp8_seats
+		KEY_E:
+			_mp8_edit_sel = (_mp8_edit_sel + 1) % mp8_seats
+		KEY_I:
+			_mp8_edit_nudge(_mp8_screen_to_world(Vector2(0, - 1)) * step)
+		KEY_K:
+			_mp8_edit_nudge(_mp8_screen_to_world(Vector2(0, 1)) * step)
+		KEY_J:
+			_mp8_edit_nudge(_mp8_screen_to_world(Vector2(- 1, 0)) * step)
+		KEY_L:
+			_mp8_edit_nudge(_mp8_screen_to_world(Vector2(1, 0)) * step)
+		KEY_U:
+			_mp8_edit_turn(- MP8_EDIT_YAW_STEP)
+		KEY_O:
+			_mp8_edit_turn(MP8_EDIT_YAW_STEP)
+		KEY_5:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+		KEY_T:
+			if _mp8_edit_overview:
+				_mp8_edit_seat_camera(_mp8_edit_sel)
+			elif _mp8_edit_cam != null:
+				_mp8_edit_cam.current = true
+				_mp8_edit_overview = true
+		KEY_G:
+			_mp8_edit_link = not _mp8_edit_link
+		KEY_P:
+			_mp8_edit_toggle_pause()
+		KEY_V:
+			# [MP8] 玩家操作平台显隐。⚠️ **只翻本窗口**（与 P 暂停不同，那个走 RPC）：
+			# 这是"我要看清摆位"的观察开关，没有让别人跟着一起变的理由。
+			# 想让 8 个窗口都不显示，用命令行 mp8burnnopanel（play.ps1 -BurnNoPanel）。
+			_mp8_show_panels = not _mp8_show_panels
+			_mp8_set_panels_visible(_mp8_show_panels)
+		KEY_B:
+			# [MP8] 可见平台（静态工位框架）显隐。同上，只翻本窗口。
+			_mp8_show_frames = not _mp8_show_frames
+			_mp8_set_frames_visible(_mp8_show_frames)
+		KEY_0:
+			_mp8_save_layout()
+		KEY_9:
+			_mp8_edit_reset_all()
+		KEY_8:
+			_mp8_edit_report()
+			moved = false
+		_:
+			moved = false
+
+	if moved:
+		_mp8_edit_refresh()
+
+
+# [MP8] 屏幕方向 → 世界水平方向（从当前相机的基向量实时算，压平 y）。
+func _mp8_screen_to_world(dir: Vector2) -> Vector3 :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector3(dir.x, 0.0, dir.y)
+
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var right: Vector3 = cam.global_transform.basis.x
+	fwd.y = 0.0
+	right.y = 0.0
+	if fwd.length() < 0.001:
+		fwd = Vector3(0, 0, - 1)
+	if right.length() < 0.001:
+		right = Vector3(1, 0, 0)
+
+	return (right.normalized() * dir.x - fwd.normalized() * dir.y).normalized()
+
+
+# [MP8] 联动组：**同奇偶的四个工位一起动**（用户 2026-08-18 要求）。
+#
+# 奇数号 = 扩容新增的那四个（外圈），偶数号 = 原版那四个。
+# 新增的四个在 45°/135°/225°/315°，是一组旋转对称的东西 ——
+# 用户调其中一个，另外三个必须**同样地**跟着动，否则手工调四遍还调不齐。
+#
+# ⚠️ "同样地动"**不是同样的世界位移**。四个工位朝向各差 90°，
+# 按世界坐标一起平移的话四个会朝同一个方向滑成一坨，对称性当场毁掉。
+# 正确做法是**在各自的局部坐标系里同样地动**：把选中工位的位移拆成
+# 「径向分量 + 切向（货道方向）分量」，再用每个工位自己的径向/切向重新组装。
+# 于是"往外 1 米"对四个都是各自的往外 1 米。见 _mp8_edit_nudge()。
+#
+# G 键可以关掉联动，单独微调某一个。
+func _mp8_edit_group(seat: int) -> Array :
+
+	if not _mp8_edit_link:
+		return [seat]
+
+	var g: Array = []
+	for s in mp8_seats:
+		if (s % 2) == (seat % 2):
+			g.append(s)
+	return g
+
+
+func _mp8_edit_nudge(delta: Vector3) -> void :
+
+	var s0: int = _mp8_edit_sel
+
+	# 把这次位移拆到**选中工位**的局部坐标系里
+	var r0: Vector3 = _mp8_radial(s0)          # 径向（由中心指向工位）
+	var t0: Vector3 = _mp8_goods_dir(s0)       # 切向（货道方向）
+	var d_radial: float = delta.dot(r0)
+	var d_tangent: float = delta.dot(t0)
+
+	for s in _mp8_edit_group(s0):
+		# 用**每个工位自己的**径向/切向重新组装 → 四个各自往外/往侧同样多
+		var d: Vector3 = _mp8_radial(s) * d_radial + _mp8_goods_dir(s) * d_tangent
+		var row: Array = _mp8_layout[s]
+		_mp8_layout[s] = [(row[0] as Vector3) + d, row[1]]
+		_mp8_apply_station(s)                  # 从快照重建，不在当前位姿上叠
+
+
+func _mp8_edit_turn(dyaw: float) -> void :
+
+	# 转是绕各自的锚点转，本来就与朝向无关，直接同角度施加即可
+	for s in _mp8_edit_group(_mp8_edit_sel):
+		var row: Array = _mp8_layout[s]
+		_mp8_layout[s] = [row[0], float(row[1]) + dyaw]
+		_mp8_apply_station(s)
+
+
+func _mp8_edit_reset_all() -> void :
+
+	for s in mp8_seats:
+		_mp8_layout[s] = [Vector3.ZERO, 0.0]
+		_mp8_apply_station(s)              # 增量归零后重建 = 回到快照原样
+	print("[MP8] 人工筛选：已复位成默认两派摆位（存盘文件还在，按 0 才会覆盖它）")
+
+
+func _mp8_edit_refresh() -> void :
+
+	if _mp8_edit_panel == null:
+		return
+
+	var s: int = _mp8_edit_sel
+	var row: Array = _mp8_layout[s]
+	var d: Vector3 = row[0]
+	var anchor: Vector3 = _mp8_station_anchor(s)
+	var hw: int = _mp8_station_hardware(s).size()
+	var has_p: bool = _mp8_seat_players.get(s) != null
+
+	var grp: Array = _mp8_edit_group(s)
+	var grp_txt: String = "单独调这一个"
+	if _mp8_edit_link:
+		grp_txt = "联动 %s 四个 %s" % [
+			"新增(奇数号)" if (s % 2) == 1 else "原版(偶数号)", str(grp)]
+
+	var lines := PackedStringArray()
+	lines.append("[MP8] 人工筛选 · 工位手调    来源=%s%s" % [
+		_mp8_layout_src, "    ⏸ 整局已暂停" if _mp8_paused else ""])
+	lines.append("选中 %d 号工位（%s）  部件：玩家%s + 硬件%d 件" % [
+		s, "外圈" if _mp8_push_for(s) > 0.0 else "内圈", "有" if has_p else "无", hw])
+	lines.append("联动：%s" % grp_txt)
+	lines.append("增量 dx=%.2f dz=%.2f dyaw=%.0f°    锚点(%.2f, %.2f) 半径 %.2f 米" % [
+		d.x, d.z, float(row[1]), anchor.x, anchor.z, Vector2(anchor.x, anchor.z).length()])
+	lines.append("步长 %.2f 米    视角：%s" % [
+		float(MP8_EDIT_STEPS[_mp8_edit_step_i]), "总览" if _mp8_edit_overview else "%d号本人" % s])
+	lines.append("可见（只本窗口）：操作平台 %s    静态平台 %s" % [
+		"显" if _mp8_show_panels else "隐", "显" if _mp8_show_frames else "隐"])
+	lines.append("QE 选工位 | IJKL 推（按屏幕方向）| UO 转 %.0f° | T 切视角" % MP8_EDIT_YAW_STEP)
+	lines.append("G 开关联动 | P 暂停/继续 | V 操作平台 | B 静态平台 | 5 步长 | 0 存盘 | 9 复位 | 8 报告")
+
+	_mp8_edit_panel.text = "\n".join(lines)
+
+
+func _mp8_edit_report() -> void :
+
+	print("[MP8] 人工筛选：==== 工位手调报告（来源=%s）====" % _mp8_layout_src)
+	print("   可见（本窗口）：玩家操作平台=%s  静态工位框架=%s" % [
+		"显" if _mp8_show_panels else "隐", "显" if _mp8_show_frames else "隐"])
+	for s in mp8_seats:
+		var row: Array = _mp8_layout[s]
+		var d: Vector3 = row[0]
+		var a: Vector3 = _mp8_station_anchor(s)
+		print("   %d号 %s  增量(%.2f, %.2f) yaw%+.0f°  锚点(%.2f, %.2f) 半径%.2f  硬件%d件 玩家%s" % [
+			s, "外" if _mp8_push_for(s) > 0.0 else "内", d.x, d.z, float(row[1]),
+			a.x, a.z, Vector2(a.x, a.z).length(),
+			_mp8_station_hardware(s).size(),
+			"有" if _mp8_seat_players.get(s) != null else "无"])
+
+	# 复用既有的带子两两交叉自检（按带子当前世界位置算，手调完照样准）
+	_mp8_check_belt_overlap()
