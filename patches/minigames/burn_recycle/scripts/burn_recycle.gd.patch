+# [MP8] 把带子按槽位数缩短，并沿自身长轴滑到新的货道中点上。
+#
+# 用户 2026-08-17 定「允许重叠」，所以这一步**不是为了不重叠**，
+# 而是让带子长度跟真正会走货的那段对上（缩短之后重叠也顺带小了）。
+#
+# 几何：带子的长轴是它自己的局部 +X，方向正好等于玩家的局部 +z（货道方向）。
+# 缩放绕带子自身中心，所以先缩再沿长轴平移两个中点的差值即可；
+# "带子中心比货道中点偏 0.79 米"这个关系自动保持，不需要知道 0.79 是多少。
+#
+# 幂等：每次都从 _mp8_belt_base（未缩过的 45° 摆位）重算。
+func _mp8_fit_belts(slots: int) -> void :
+
+	if _mp8_belt_base.is_empty():
+		return
+
+	if MP8_BELT_FIT:
+		var span_orig: float = float(MP8_ORIG_SLOTS - 1) * MP8_SLOT_SPACING
+		var span_new: float = float(slots - 1) * MP8_SLOT_SPACING
+		var k: float = span_new / span_orig
+		# 货道中点从 (首格 + 旧跨度/2) 挪到 (首格 + 新跨度/2)，带子跟着走同样的距离。
+		# ⚠️ 沿 **_mp8_goods_dir(i)** 走，不要用带子自己的 basis.x —— 四条原版带子的
+		# +X 指向不一致（有的正有的反），拿它当方向会有一半带子滑反。
+		var slide: float = (span_new - span_orig) * 0.5
+
+		for i in _mp8_belt_base.size():
+			if i >= belts.size() or belts[i] == null:
+				continue
+			var base: Transform3D = _mp8_belt_base[i]
+			var t: Transform3D = base
+			t.basis = base.basis * Basis.from_scale(Vector3(k, 1.0, 1.0))
+			t.origin = base.origin + _mp8_goods_dir(i) * slide
+			belts[i].global_transform = t
+
+		print("[MP8] 人工筛选：带子按 %d 槽缩到 %.3f 倍（%.2f→%.2f 米）、沿长轴滑 %+.2f 米" % [
+			slots, k, span_orig, span_new, slide])
+
+	_mp8_check_belt_overlap()
+
+
+# [MP8] 带子到底还重不重叠 —— 拿真实几何算，不靠估。
+#
+# 每条带子在 XZ 平面上就是一条线段：中心 = 节点位置，方向 = 自身 +X，
+# 长度 = Mesh 的 AABB.x × 该轴缩放（取实际值，游戏更新换了模型也照样对）。
+# 两两求线段最短距离，0 就是真的插在一起。
+# 这条日志是"两派摆位到底够不够退"的唯一判据 —— 用户调 mp8burnpush= 时看它。
+func _mp8_check_belt_overlap() -> void :
+
+	var segs: Array = []
+	for b in belts:
+		if b == null or b.mesh == null:
+			continue
+		var t: Transform3D = b.global_transform
+		var half: float = b.mesh.get_aabb().size.x * t.basis.get_scale().x * 0.5
+		var dir: Vector3 = t.basis.x.normalized()
+		var a: Vector3 = t.origin - dir * half
+		var c: Vector3 = t.origin + dir * half
+		segs.append([Vector2(a.x, a.z), Vector2(c.x, c.z)])
+
+	if segs.size() < 2:
+		return
+
+	var worst: float = INF
+	var crossings: int = 0
+	for i in segs.size():
+		for j in range(i + 1, segs.size()):
+			var pts: PackedVector2Array = Geometry2D.get_closest_points_between_segments(
+				segs[i][0], segs[i][1], segs[j][0], segs[j][1])
+			var d: float = pts[0].distance_to(pts[1])
+			if d < 0.01:
+				crossings += 1
+			worst = minf(worst, d)
+
+	if crossings > 0:
+		print("[MP8] 人工筛选：⚠️ 还有 %d 对带子插在一起（外推 %.2f 米不够，加大 mp8burnpush=）" % [
+			crossings, mp8_ring_push])
+	else:
+		print("[MP8] 人工筛选：带子两两不相交 ✅ 最小净距 %.2f 米（外推 %.2f 米）" % [
+			worst, mp8_ring_push])
+
+
+# [MP8] 绕世界 Y 轴转一个角度（连位置一起转，等于绕场地中心公转）
+func _mp8_spin(t: Transform3D, degrees: float) -> Transform3D:
+	var b: Basis = Basis(Vector3.UP, deg_to_rad(degrees))
+	return Transform3D(b * t.basis, b * t.origin)
+
+
+# [MP8] 某个工位的**径向单位向量**（由中心指向该工位）= 该工位玩家的局部 **+Z**。
+# ⚠️ 不是 +X（第一版就错在这儿）：控制台/货道离中心的那个 5.20 米是局部 z，见上面的常量块。
+# 绕 Y 转 θ 把局部 Z 映射成 (sinθ, 0, cosθ)。"往外退"就是沿这个方向加距离。
+func _mp8_radial(seat: int) -> Vector3:
+	var th: float = deg_to_rad(mp8_seat_step * float(seat))
+	return Vector3(sin(th), 0.0, cos(th))
+
+
+# [MP8] 某个工位的**货道方向**（货物从下标 0 走向末位）= 该工位玩家的局部 **+X**。
+# 与径向垂直。带子的长轴就是它，所以缩短带子后的"沿长轴滑动"沿这个方向算。
+func _mp8_goods_dir(seat: int) -> Vector3:
+	var th: float = deg_to_rad(mp8_seat_step * float(seat))
+	return Vector3(cos(th), 0.0, - sin(th))
+
+
+# [MP8] 该工位属于哪一圈：奇数号 = 外圈（往外退 mp8_ring_push 米），偶数号 = 内圈（原位）。
+# 偶数号正好是原版那四个工位，所以**内圈一件道具都没挪过**。
+func _mp8_push_for(seat: int) -> float:
+	if mp8_ring_push <= 0.0:
+		return 0.0
+	return mp8_ring_push if (seat % 2) == 1 else 0.0
+
+
+# [MP8] 把一件道具从 from_seat 摆到 to_seat：先绕中心转过去，再按两圈的差沿径向推。
+# from_seat 那一项在当前所有调用点都是内圈（推 0），留着是为了公式自洽。
+func _mp8_place(t: Transform3D, from_seat: int, to_seat: int) -> Transform3D:
+	var out: Transform3D = _mp8_spin(t, mp8_seat_step * float(to_seat - from_seat))
+	out.origin += _mp8_radial(to_seat) * _mp8_push_for(to_seat) \
+		- _mp8_radial(from_seat) * _mp8_push_for(from_seat)
+	return out
+
+
+# [MP8] 坑第 14 条：duplicate() 不重映射指向自己子节点的 @export 引用。
+# 冲压机有两个这样的引用：anim_press（播"press"动画）与 decals（血渍）。
+# 不重解析的话，第 5~8 号工位的死亡动画会播在**原件**身上（1~4 号那台跟着动）。
+func _mp8_reresolve_press(src: BurnRecyclePress, dup: BurnRecyclePress) -> void :
+
+	if src.anim_press != null:
+		var rel: NodePath = src.get_path_to(src.anim_press)
+		var node: Node = dup.get_node_or_null(rel)
+		if node is AnimationPlayer:
+			dup.anim_press = node
+		else:
+			printerr("[MP8] 人工筛选：冲压机副本没接上 anim_press（相对路径 %s）" % str(rel))
+
+	var new_decals: Array[Decal] = []
+	for d in src.decals:
+		if d == null:
+			continue
+		var nd: Node = dup.get_node_or_null(src.get_path_to(d))
+		if nd is Decal:
+			new_decals.append(nd)
+	dup.decals = new_decals
+
+
+# [MP8] 扩完之后自检 + 落日志。编号不是 0..N-1 各一份就当场喊出来 ——
+# 冲压机编号错 = 有人被淘汰时死亡流程中断（照样能玩），比崩溃更难发现。
+func _mp8_report_stations() -> void :
+
+	var press_ids: Array = []
+	for p in presses:
+		if p != null:
+			press_ids.append(p.press_id)
+	var ind_ids: Array = []
+	for i in indicators:
+		if i != null:
+			ind_ids.append(i.indicator_id)
+	press_ids.sort()
+	ind_ids.sort()
+
+	var want: Array = []
+	for s in mp8_seats:
+		want.append(s)
+
+	print("[MP8] 人工筛选工位表：传送带 %d 条 / 冲压机 %d 台 %s / 指示灯 %d 组 %s" % [
+		belts.size(), presses.size(), str(press_ids), indicators.size(), str(ind_ids)])
+	if press_ids != want:
+		printerr("[MP8] ❌ 冲压机编号不是 %s —— 5~8 号工位淘汰流程会中断，必须查" % str(want))
+	if ind_ids != want:
+		printerr("[MP8] ❌ 指示灯编号不是 %s" % str(want))
+	if belts.size() < mp8_seats:
+		printerr("[MP8] ❌ 传送带只有 %d 条，不够 %d 个工位" % [belts.size(), mp8_seats])
+
+	# 两派摆位：把每个工位的圈层和半径打出来，一眼看出内外圈分没分开
+	var rows: Array = []
+	for s in mini(belts.size(), mp8_seats):
+		if belts[s] == null:
+			continue
+		var r: float = belts[s].global_position.dot(_mp8_radial(s))
+		rows.append("%d号%s%.2f米" % [s, "外" if _mp8_push_for(s) > 0.0 else "内", r])
+	print("[MP8] 人工筛选圈层：%s" % " / ".join(rows))
+
+
+# [MP8] 结算时把名次/名字/得分打进日志。**不改任何分数**，纯给 ② 阶段核对用。
+# 只在服务器侧跑（check_game_end 本身就只有服务器会走到这里）。
+func _mp8_log_scores() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var lines: Array = []
+	var ranked: Array = player_scores.keys()
+	ranked.sort_custom(func(a, b): return player_scores[a] > player_scores[b])
+	var rank: int = 1
+	for network_id in ranked:
+		var who: String = str(network_id)
+		if PlayerManager.player_presences.has(network_id):
+			who = PlayerManager.player_presences[network_id].network_name
+		lines.append("第%d名 %s %d分" % [rank, who, player_scores[network_id]])
+		rank += 1
+
+	print("[MP8] 人工筛选结算（%d 人在场 / %d 人阵亡 / %d 工位）：%s" % [
+		player_count, dead_players.size(), mp8_seats, " / ".join(lines)])
+
+
+# [MP8] 本轮零件榜：**每轮结束**时左上角按零件数从多到少列一行一个人
+#（用户 2026-08-17 夜要求，并当场更正过一次：是**一轮**结束、看**零件数**，
+# 不是一局结束看名次分 —— 两个数完全不同，别再弄反）。
+#
+#   · 零件数 = `valid_burns + valid_recycles`，就是原版判淘汰用的那个数
+#     （`eliminate_players()` 里最低分出局），也是每人自己那块记分屏上显示的数；
+#   · 名次分 = `player_scores`，整局结束才定、给中场记分板累加用的。**榜不显示它。**
+#
+# 为什么要 RPC 而不是各端自己算：判活名单（谁还在场）只有服务器手里是权威的，
+# 而且 8 个窗口必须显示同一份数 —— 各算各的一旦有丢包就会各显示各的，
+# 那比不显示更糟（会让人以为算分错了）。
+# 传 id + 零件数两个平行数组，**名字各端自己查** `PlayerManager.player_presences`，
+# 查不到就退回显示 id（同 `_mp8_log_scores` 的兜底）。
+#
+# 约定：**`ids` 空 = 撤榜**（新一轮开打时用）；**某人的数 < 0 = 已淘汰**，
+# 那一行显示 `——` 而不是数字（他的计数停在死掉那轮，显示出来是过期数据）。
+@rpc("authority", "call_local", "reliable")
+func _mp8_score_board_rpc(ids: PackedInt32Array, counts: PackedInt32Array) -> void :
+
+	if ids.size() != counts.size():
+		return
+
+	# 空 = 撤榜
+	if ids.is_empty():
+		if _mp8_score_panel != null:
+			_mp8_score_panel.text = ""
+		return
+
+	# [零件数, 名字, id]。活着的按零件数降序排在前，已淘汰的沉底；
+	# 同数时按名字排 —— 不定死次序的话 8 个窗口的行序会不一样，看着像数对不上。
+	var rows: Array = []
+	for i in ids.size():
+		var network_id: int = ids[i]
+		var who: String = str(network_id)
+		if PlayerManager.player_presences.has(network_id):
+			who = String(PlayerManager.player_presences[network_id].network_name)
+		rows.append([counts[i], who, network_id])
+	rows.sort_custom(func(a, b):
+		var da: bool = int(a[0]) < 0
+		var db: bool = int(b[0]) < 0
+		if da != db:
+			return db                      # 淘汰的沉底
+		if not da and a[0] != b[0]:
+			return a[0] > b[0]
+		return String(a[1]) < String(b[1]))
+
+	# 带 -BurnDebug 时把 network_id 也列出来（验收时要和日志逐个对上）；
+	# 不带就是给玩家看的干净榜，只有零件数和名字。
+	var with_id: bool = Array(OS.get_cmdline_args()).has("mp8burndebug")
+
+	var lines := PackedStringArray()
+	lines.append("本轮零件数")
+	for r in rows:
+		var n: int = int(r[0])
+		var num: String = "——" if n < 0 else "%3d" % n
+		var tail: String = " (%d)" % int(r[2]) if with_id else ""
+		var out: String = "%s  —  %s%s" % [num, String(r[1]), tail]
+		if n < 0:
+			out += "  已淘汰"
+		lines.append(out)
+
+	_mp8_score_build()
+	if _mp8_score_panel != null:
+		_mp8_score_panel.text = "\n".join(lines)
+
+
+# [MP8] 服务器侧：把本轮零件数收齐发出去。已淘汰的人发 -1（见 RPC 那边的约定）。
+# ⚠️ 遍历 `players` 不是 `active_players` —— 榜上要看得见谁已经出局了。
+func _mp8_score_broadcast() -> void :
+
+	if not multiplayer.is_server() or not _mp8_score_on or mp8_seats <= MP8_ORIG_SEATS:
+		return
+
+	var ids := PackedInt32Array()
+	var counts := PackedInt32Array()
+	for network_id in players.keys():
+		var p = players[network_id]
+		if p == null:
+			continue
+		ids.append(network_id)
+		counts.append( - 1 if not active_players.has(network_id) \
+			else int(p.valid_burns) + int(p.valid_recycles))
+
+	if ids.is_empty():
+		return
+	_mp8_score_board_rpc.rpc(ids, counts)
+
+
+# [MP8] 榜的容器。用 CanvasLayer + Label，与 -BurnDebug 那块面板同一套做法。
+# ⚠️ 两块都在左上角：-BurnDebug 开着时把榜往下挪，别叠在它上面
+#（那块是每人一份的绑定面板，高度固定在 7 行左右，190 像素够让开）。
+func _mp8_score_build() -> void :
+
+	if _mp8_score_panel != null:
+		return
+
+	var lbl := Label.new()
+	lbl.name = "MP8BurnScoreBoard"
+	lbl.set_anchors_preset(Control.PRESET_TOP_LEFT)
+	lbl.position = Vector2(
+		14.0, 190.0 if Array(OS.get_cmdline_args()).has("mp8burndebug") else 10.0)
+	lbl.add_theme_color_override("font_color", Color(1.0, 0.94, 0.6))
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.add_theme_font_size_override("font_size", 22)
+
+	_mp8_score_canvas = CanvasLayer.new()
+	_mp8_score_canvas.layer = 127
+	_mp8_score_canvas.add_child(lbl)
+	# 挂在小游戏根下 = 随小游戏一起销毁，进中场时自然消失，不用手动清
+	add_child(_mp8_score_canvas)
+	_mp8_score_panel = lbl
+
+
+# [MP8] 自截图（HANDOFF 第八节）：靠游戏自己存 PNG，不需要任何屏幕录制权限。
+# 本局要看的就一件事：**45° 八工位到底挤成什么样、带子重叠难看不难看**。
+# 文件名带 peer id，8 个实例各存一张（每人看到的是自己工位的视角）。
+func _mp8_shot(tag: String, delay: float = 0.0) -> void :
+
+	if not Array(OS.get_cmdline_args()).has("mp8shot"):
+		return
+
+	if delay > 0.0:
+		await get_tree().create_timer(delay, false).timeout
+	if not is_inside_tree():
+		return
+	await RenderingServer.frame_post_draw
+
+	var peer: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var img: Image = get_viewport().get_texture().get_image()
+	if img != null:
+		img.save_png("user://mp8_burn_%s_%d.png" % [tag, peer])
+		print("[MP8] mp8shot：已存 user://mp8_burn_%s_%d.png" % [tag, peer])
+
+
+# [MP8] 取 mp8xxx=<值> 形式的命令行参数
+func _mp8_arg(prefix: String) -> String:
+	for a in OS.get_cmdline_args():
+		var s: String = str(a)
+		if s.begins_with(prefix):
+			return s.substr(prefix.length())
+	return ""
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] -BurnEdit：工位整体手调（用户 2026-08-18 要求）
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 宪法硬规矩一「摆位归用户」。前面那套两派摆位（内圈 4 + 外圈 4、外推 2.0 米）
+# 是**算出来的默认值**，用户要在实机里自己拖。
+#
+# ### 一个「工位」= 四件东西，整体刚性移动
+#
+#   1. **玩家实例**（控制台 / 两拉杆 / 活塞 / 记分屏 / 货道 / **摄像机**全在里面）
+#   2. belts[·]      传送带
+#   3. presses[·]    冲压机
+#   4. indicators[·] 结算指示灯
+#
+# ⚠️ 后三样**按几何角度分组，不按 id**。理由：press_id / indicator_id 与工位号之间
+# 隔着原版一个常数偏移（冲压机 yaw = 90*id + 90、指示灯 yaw = 90*id - 90、玩家 yaw = 90*seat），
+# 扩容后又叠了一层「原件 i → 2i、副本 → 2i+1」的重编号。按 id 认组一步错步步错，
+# 而**按世界角度认「谁站在这个工位上」永远不会错**。见 _mp8_seat_of_pos()。
+#
+# ### 玩家实例的原点在场地中心，不在工位上
+#
+# 这是本局最反直觉的一点：玩家实例的 origin 是 (0,0,0)（外推后才有个径向偏移），
+# 控制台那些在**局部 +Z 5.20 米**处。所以：
+#   * 平移工位 = 给实例 position 加世界增量（连人带镜头一起走）；
+#   * 转工位   = 绕**工位锚点**（不是绕实例原点）转，否则手一动人就飞到场地对面。
+# 锚点取实例局部 (0, 0, MP8_STATION_RADIAL_Z) 变换到世界，见 _mp8_station_anchor()。
+#
+# ### 存的是「相对默认摆位的增量」，不是绝对坐标
+#
+# user://mp8_burn_layout.txt，一行一个工位：dx, dz, dyaw。
+# 删掉文件 = 回到算出来的两派默认值。存增量而不是绝对值，是为了
+# 改 mp8burnpush= 或槽位数之后，手调结果仍然叠得上去。
+#
+# ### 为什么必须有总览相机（T 键）
+#
+# 叉车是俯视全场，一个窗口就能判摆位；**本局每人一台第一人称相机**，
+# 1 号窗口默认只看得到 0 号工位自己的视角，**根本看不见别的工位摆得怎么样**。
+# 所以编辑模式自带一台俯视总览相机，T 在「总览 / 当前选中工位的本人视角」之间切。
+# 后者才是真正要判的东西：外圈玩家自己看出去是什么取景。
+#
+# ### 生效范围
+#
+# 编辑时只动**本机**节点（1 号窗口自己看得见就够判）；存盘后**下一局**由
+# _mp8_layout_rpc 广播给所有端：硬件各端本地摆，玩家实例在 setup_rpc 里加增量。
+
+const MP8_BURN_LAYOUT_FILE: String = "user://mp8_burn_layout.txt"
+const MP8_EDIT_STEPS: Array = [0.25, 1.0, 4.0]
+const MP8_EDIT_YAW_STEP: float = 15.0
+
+var _mp8_edit_on: bool = false
+var _mp8_edit_sel: int = 0
+var _mp8_edit_step_i: int = 0
+var _mp8_edit_canvas: CanvasLayer = null
+var _mp8_edit_panel: Label = null
+var _mp8_edit_cam: Camera3D = null
+var _mp8_edit_overview: bool = true
+# 联动：同奇偶的四个工位一起动。默认开（新增的四个要对称），G 键关。
+var _mp8_edit_link: bool = true
+# 暂停：**整局**（房主按 P，走 _mp8_pause_rpc 让 8 个实例各自冻住自己的树）
+var _mp8_paused: bool = false
+var _mp8_pause_modes: Array = []
+
+# seat -> 玩家实例（只在服务器上填，spawn_players 里记）
+var _mp8_seat_players: Dictionary = {}
+# seat -> [Vector3 位移增量, float yaw 增量]，长度 = mp8_seats，各端一致（RPC 广播）
+var _mp8_layout: Array = []
+var _mp8_layout_src: String = "内置默认（两派摆位）"
+
+
+# [MP8] 玩家脚本在 setup_rpc 里调这个拿自己工位的手调增量。
+# 没手调过就是 (0,0,0) 与 0 —— 一个值都不动。
+func mp8_layout_delta(seat: int) -> Array :
+	if seat >= 0 and seat < _mp8_layout.size():
+		return _mp8_layout[seat]
+	return [Vector3.ZERO, 0.0]
+
+
+# [MP8] 玩家脚本算工位锚点要用（跨文件给方法比取 const 稳）
+func mp8_station_radial() -> float :
+	return MP8_STATION_RADIAL_Z
+
+
+# ── [MP8] 四周墙壁整体后退（用户 2026-08-18 定：退 5 米）──────────────────────
+#
+# 八工位 + 外圈外推之后场地显得挤，用户要把四周的墙往后退。
+#
+# ### 为什么是"缩放 + 回中"而不是"每面墙各挪 5 米"
+#
+# probe63 实测：**四周的墙是一整块 mesh**，不是四面独立节点 ——
+# `clientside visuals parent/burn recycle main wall7/main walls`，
+# MeshInstance3D，节点原点在 (0,0,0)，AABB 尺寸 47.88 × 13.38 × 48.95、
+# 中心偏在 (-1.59, 6.69, 2.12)。没有可以单独平移的"东墙/西墙"节点，
+# 所以只能对整块做**非等比缩放**，再平移把房间中心挪回原处 ——
+# 效果等价于每面墙沿自己的法线外移 push 米。
+#
+# 各轴缩放系数由 AABB 现算（不写死），所以将来 mesh 换了也不用改这里：
+#   scale_x = (宽 + 2*push) / 宽     scale_z = (深 + 2*push) / 深     scale_y = 1
+#
+# **y 不缩**：只把墙往外推，不要把房顶也抬高 5 米。
+#
+# ### 三条已核过的安全性
+#
+#   1. **整棵子树下没有任何 CollisionObject3D / CollisionShape3D**（probe63 Q6）——
+#      纯装饰件，所以坑第 28 条「一缩 scale 碰撞体就坏」在这里不成立；
+#   2. **只动墙这一个节点**。它的兄弟里有 `incinerator`（中央焚烧炉，在 (0, 0.68, 0)）
+#      和 6 盏 OmniLight3D —— **一个都不动**，炉子在正中心，跟着墙走就穿帮了；
+#   3. **≤4 人一个值都不动**（调用点带 seats > 4 的闸门），4 人局与零售版逐值一致。
+#
+# ### 代价（知情选择，不是 bug）
+#
+#   * 墙面在水平方向被拉伸约 20%，贴图会跟着横向拉长；
+#   * 房间变大而灯没动（灯在中心上方），**远处的墙会比原来暗一点**。
+#   两条都只影响背景观感。真嫌难看就传 mp8burnwall=0 关掉。
+func _mp8_push_walls(push: float) -> void :
+
+	if push <= 0.0:
+		return
+
+	var wall: MeshInstance3D = find_child("main walls", true, false) as MeshInstance3D
+	if wall == null:
+		push_warning("[MP8] 人工筛选：找不到 'main walls' 节点，四周墙壁没有后退")
+		return
+	if wall.mesh == null:
+		push_warning("[MP8] 人工筛选：'main walls' 没有 mesh，四周墙壁没有后退")
+		return
+
+	var ab: AABB = wall.mesh.get_aabb()
+	if ab.size.x < 0.01 or ab.size.z < 0.01:
+		push_warning("[MP8] 人工筛选：'main walls' 的 AABB 是扁的，不敢缩放")
+		return
+
+	var sx: float = (ab.size.x + push * 2.0) / ab.size.x
+	var sz: float = (ab.size.z + push * 2.0) / ab.size.z
+
+	# 缩放会把 AABB 中心按比例推离节点原点，再平移把它挪回原处 ——
+	# 这样"房间中心不动、每面墙各退 push 米"，而不是"整个房间往一边滑"。
+	var c: Vector3 = ab.get_center()
+	wall.scale = Vector3(sx, 1.0, sz)
+	wall.position += Vector3(c.x - c.x * sx, 0.0, c.z - c.z * sz)
+
+	print("[MP8] 人工筛选：四周墙壁后退 %.2f 米（%.2f x %.2f → %.2f x %.2f，缩放 %.4f/%.4f，y 不动）" % [
+		push, ab.size.x, ab.size.z, ab.size.x + push * 2.0, ab.size.z + push * 2.0, sx, sz])
+
+
+# ── [MP8] 只留地板与工位，其余场景隐掉（用户 2026-08-18 定）──────────────────
+#
+# 摆位定稿之后，用户要"除了地板和玩家的操作工位，其余场景全部不可见"。
+#
+# ### 地板和墙在**同一块 mesh** 里，但幸好是分开的 surface
+#
+# probe63/64 实测：`clientside visuals parent/burn recycle main wall7/main walls`
+# 是一块 **ArrayMesh，4 个 surface**，每个 surface 一张有名字的材质：
+#
+#   surface 0  floor tiles       ← **地板，要留**
+#   surface 1  metal wall        ← 隐
+#   surface 2  brick wall baked  ← 隐
+#   surface 3  void              ← 隐
+#
+# Godot 没有"隐藏单个 surface"的 API（`visible` 是整个 MeshInstance3D 的），
+# 所以对要隐的那几个 surface 挂一张**全透明的 override 材质**。
+# 认 surface 用的是**材质名**而不是下标 —— 下标会随美术改动漂移，名字不会。
+# 万一将来找不到 `floor tiles` 这个名字，宁可**一个都不隐**并报警，
+# 也不能瞎按下标猜，那样会把地板一起隐掉、玩家悬空。
+#
+# ### 顺带把阴影关掉
+#
+# 透明材质在 Godot 4 里默认不投影，但 `cast_shadow` 是**整个 MeshInstance 的**属性、
+# 不分 surface。为了确保隐掉的墙不在地板上留下"看不见的东西的影子"，
+# 直接把这块 mesh 的投影整体关掉 —— 地板自己投影本来也没意义（它底下没东西）。
+#
+# ### 还隐了什么
+#
+# 中央焚烧炉 `incinerator`（7.39 x 10.07 x 7.27，就在场地正中）—— 它不是工位，
+# 而且正好挡在俯视总览的中间。**它旁边的 6 盏灯一盏都没动**（灯不是 mesh，
+# 而且是 incinerator 的兄弟不是孩子，隐它不会连带熄灯）。
+#
+# **留下的**：四条传送带、四台冲压机、结算指示灯、传送带机架、
+# 以及玩家实例自带的控制台/拉杆/活塞/记分屏 —— 都是"操作工位"的一部分。
+#
+# ### 与"墙后退 5 米"的关系
+#
+# 墙既然隐了，把它推出去就没意义了，而且**地板和墙同属一块 mesh** ——
+# 推出去会把地板贴图一起横向拉伸 20%。所以隐场景时**跳过后退**（见调用点）。
+# 想看带墙的原样：传 `mp8burnkeepscene`（`play.ps1 -BurnKeepScene`），
+# 那时候墙会回来、后退也照做。
+const MP8_FLOOR_MATERIAL_NAME: String = "floor tiles"
+
+
+func _mp8_invisible_material() -> StandardMaterial3D :
+
+	var m := StandardMaterial3D.new()
+	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+	m.albedo_color = Color(0.0, 0.0, 0.0, 0.0)
+	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	m.disable_receive_shadows = true
+	return m
+
+
+func _mp8_hide_scenery() -> void :
+
+	# ── 四周墙：只隐非地板的那几个 surface ──────────────────────────────
+	var mw: MeshInstance3D = find_child("main walls", true, false) as MeshInstance3D
+	if mw == null or mw.mesh == null:
+		push_warning("[MP8] 人工筛选：找不到 'main walls'，墙没隐")
+	else:
+		# 先确认地板那个 surface 真的在，找不到就整块不动（宁可不隐，不能隐错）
+		var floor_i: int = - 1
+		for i in mw.mesh.get_surface_count():
+			var mat: Material = mw.mesh.surface_get_material(i)
+			if mat != null and String(mat.resource_name) == MP8_FLOOR_MATERIAL_NAME:
+				floor_i = i
+				break
+
+		if floor_i < 0:
+			push_warning("[MP8] 人工筛选：'main walls' 里找不到材质名 '%s' 的 surface —— 一个都不隐（不敢按下标猜，怕把地板隐掉）" % MP8_FLOOR_MATERIAL_NAME)
+		else:
+			var names := PackedStringArray()
+			for i in mw.mesh.get_surface_count():
+				if i == floor_i:
+					continue
+				var mat2: Material = mw.mesh.surface_get_material(i)
+				names.append("%d:%s" % [
+					i, "(无名)" if mat2 == null else String(mat2.resource_name)])
+				mw.set_surface_override_material(i, _mp8_invisible_material())
+
+			# 隐掉的墙别在地板上留影子（cast_shadow 是整块的，不分 surface）
+			mw.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+
+			print("[MP8] 人工筛选：墙已隐 —— 保留 surface %d '%s'（地板），隐掉 %s" % [
+				floor_i, MP8_FLOOR_MATERIAL_NAME, ", ".join(names)])
+
+	# ── 中央焚烧炉 ────────────────────────────────────────────────────
+	var inc: Node3D = find_child("incinerator", true, false) as Node3D
+	if inc != null:
+		inc.visible = false
+		print("[MP8] 人工筛选：中央焚烧炉已隐（6 盏灯一盏没动，它们是兄弟不是孩子）")
+	else:
+		push_warning("[MP8] 人工筛选：找不到 'incinerator'")
+
+
+# [MP8] 可见平台：主场景那几套**静态工位框架**（操作台主体）的显隐。
+#
+# 认组用**名字前缀**、不用下标 —— 同 `_mp8_hide_scenery()` 那一课：下标会随美术改动漂移。
+# 结构（probe65 量的）：
+#
+#   burn recycle visuals final
+#     ├ conveyor control panel main parent_001 / _002 / _003 / _004   ← 各一套，共 4 套
+#     │    └ conveyor frame（18.19 x 5.86 x 3.84，操作台主体）+ 烘在里面的活塞/拉杆/台屏
+#     └ Cube_135 ...                                                  ← 别的装饰，不动
+#
+# ⚠️ 一套里除了框架还烘着一份**静态的**活塞/拉杆/控制台屏（尺寸与玩家实例那份逐值相同，
+# 0 号工位那份的位置也与玩家实例那份重合）。所以隐掉一整套 parent = 框架连那份静态副本
+# 一起没了，**玩家实例自己那份不受影响**（那是另一棵树，归 mp8_set_panel_visible 管）。
+#
+# 纯视觉、各端本地做、不走 RPC；`visible` 不碰碰撞体（不是 scale，与第 28 条那个坑无关）。
+func _mp8_set_frames_visible(on: bool) -> void :
+
+	var root: Node = find_child(MP8_VISUALS_ROOT_NAME, true, false)
+	if root == null:
+		push_warning("[MP8] 人工筛选：找不到 '%s'，可见平台开关没生效" % MP8_VISUALS_ROOT_NAME)
+		return
+
+	var hit: int = 0
+	for c in root.get_children():
+		if not String(c.name).begins_with(MP8_FRAME_PARENT_PREFIX):
+			continue
+		var c3: Node3D = c as Node3D
+		if c3 == null:
+			continue
+		c3.visible = on
+		hit += 1
+
+	# 找不到就报警而不是默默什么都没做 —— 这个开关"没生效"和"生效了但场上本来就没框架"
+	# 在画面上长得一模一样，不报的话下次会白查一轮。
+	if hit == 0:
+		push_warning("[MP8] 人工筛选：'%s' 下没有名字以 '%s' 开头的节点，可见平台开关没生效" % [
+			MP8_VISUALS_ROOT_NAME, MP8_FRAME_PARENT_PREFIX])
+		return
+
+	print("[MP8] 人工筛选：可见平台（静态工位框架）%d 套 → %s%s" % [
+		hit, "显示" if on else "隐藏",
+		"（原版只有 4 套、没跟着扩到 8：偶数号工位有、奇数号没有）" if hit < mp8_seats else ""])
+
+
+# [MP8] 玩家操作平台：每个玩家实例自带的活塞 / 拉杆 / 控制台屏的显隐。
+# 对**所有**玩家实例做（这是大家都看得见的东西，不是本地 UI），逐个转发给实例自己去关。
+func _mp8_set_panels_visible(on: bool) -> void :
+
+	var hit: int = 0
+	for c in player_parent_node.get_children():
+		var p: BurnRecyclePlayer = c as BurnRecyclePlayer
+		if p == null:
+			continue
+		p.mp8_set_panel_visible(on)
+		hit += 1
+
+	print("[MP8] 人工筛选：玩家操作平台 %d 个 → %s" % [hit, "显示" if on else "隐藏"])
+
+
+func _mp8_layout_reset() -> void :
+	_mp8_layout = []
+	for i in mp8_seats:
+		_mp8_layout.append([Vector3.ZERO, 0.0])
+
+
+# [MP8] 世界坐标 → 它属于哪个工位（按绕 Y 的方位角就近归组）。
+# 工位 s 的方位角 = mp8_seat_step * s（与 _mp8_radial 同一套）。
+func _mp8_seat_of_pos(pos: Vector3) -> int :
+
+	if absf(pos.x) < 0.001 and absf(pos.z) < 0.001:
+		return - 1                     # 落在场地正中，判不了角度
+
+	var ang: float = rad_to_deg(atan2(pos.x, pos.z))
+	var best: int = 0
+	var best_d: float = 1e9
+	for s in mp8_seats:
+		var d: float = absf(wrapf(ang - mp8_seat_step * float(s), - 180.0, 180.0))
+		if d < best_d:
+			best_d = d
+			best = s
+	return best
+
+
+# [MP8] 工位锚点：玩家实例局部 (0, 0, 半径) 的世界位置 ≈ 控制台所在处。转工位时绕它转。
+# 玩家实例还没生成就退回按默认几何算。
+func _mp8_station_anchor(seat: int) -> Vector3 :
+
+	var p = _mp8_seat_players.get(seat)
+	if p != null and is_instance_valid(p):
+		return (p as Node3D).global_transform * Vector3(0.0, 0.0, MP8_STATION_RADIAL_Z)
+
+	return _mp8_radial(seat) * (MP8_STATION_RADIAL_Z + _mp8_push_for(seat))
+
+
+# [MP8] 这个工位上的主场景硬件（带子 / 冲压机 / 指示灯），按几何认组。
+func _mp8_station_hardware(seat: int) -> Array :
+
+	var out: Array = []
+	for arr in [belts, presses, indicators]:
+		for n in arr:
+			if n == null or not is_instance_valid(n):
+				continue
+			if _mp8_seat_of_pos((n as Node3D).global_position) == seat:
+				out.append(n)
+	return out
+
+
+# [MP8] **默认摆位的快照**：seat -> [[节点, 默认 global_transform], ...]。
+#
+# 为什么要快照、而不是每次按键在当前位姿上叠增量：
+# 平移与"绕锚点转"**不满足交换律**。手调时是"绕当前锚点转"，而下一局重放时
+# 只知道累计的 (dpos, dyaw)、只能绕**默认锚点**转 —— 两者会差一个偏移，
+# 于是"我摆好的样子"和"下一局跑出来的样子"对不上。
+# 所以任何一次改动都**从快照重建**：先绕默认锚点转 dyaw，再平移 dpos。
+# 手调所见 = 重放结果，逐值一致。
+var _mp8_station_base: Dictionary = {}
+
+
+# [MP8] 工位的默认锚点（不含手调增量）：转工位时绕它转。
+func _mp8_default_anchor(seat: int) -> Vector3 :
+	return _mp8_radial(seat) * (MP8_STATION_RADIAL_Z + _mp8_push_for(seat))
+
+
+# [MP8] 抓一次该工位所有部件的默认位姿。只抓一次；之后重建都以它为基准。
+func _mp8_snapshot_station(seat: int) -> Array :
+
+	if _mp8_station_base.has(seat):
+		return _mp8_station_base[seat]
+
+	var rows: Array = []
+	var nodes: Array = _mp8_station_hardware(seat)
+	var p = _mp8_seat_players.get(seat)
+	if p != null and is_instance_valid(p):
+		nodes.append(p)
+
+	for n in nodes:
+		rows.append([n, (n as Node3D).global_transform])
+
+	_mp8_station_base[seat] = rows
+	return rows
+
+
+# [MP8] 按布局表把一个工位从快照重建（先绕默认锚点转，再平移）。**只动本机节点。**
+func _mp8_apply_station(seat: int) -> void :
+
+	if seat < 0 or seat >= _mp8_layout.size():
+		return
+
+	var row: Array = _mp8_layout[seat]
+	var dpos: Vector3 = row[0]
+	var dyaw: float = float(row[1])
+
+	var anchor: Vector3 = _mp8_default_anchor(seat)
+	var b: Basis = Basis(Vector3.UP, deg_to_rad(dyaw))
+
+	for e in _mp8_snapshot_station(seat):
+		var n3: Node3D = e[0]
+		if n3 == null or not is_instance_valid(n3):
+			continue
+		var t: Transform3D = e[1]          # 默认位姿，不是当前位姿
+		t.origin = anchor + b * (t.origin - anchor) + dpos
+		t.basis = b * t.basis
+		n3.global_transform = t
+
+
+# [MP8] 把布局表应用到**主场景硬件**（各端本地做）。玩家实例那份在 setup_rpc 里加，
+# 因为这条 RPC 到达时玩家实例还没生成。
+func _mp8_apply_hardware_layout() -> void :
+
+	for s in mini(_mp8_layout.size(), mp8_seats):
+		var row: Array = _mp8_layout[s]
+		if (row[0] as Vector3).is_zero_approx() and absf(float(row[1])) < 0.001:
+			continue
+		_mp8_apply_station(s)
+
+
+# [MP8] 布局表广播。服务器在 spawn_players 里发，各端本地摆硬件。
+# ⚠️ 必须在 setup_rpc 之前发：玩家实例要在 setup_rpc 里问 mp8_layout_delta()。
+@rpc("authority", "call_local", "reliable")
+func _mp8_layout_rpc(flat: PackedFloat32Array) -> void :
+
+	_mp8_layout_reset()
+	var n: int = mini(int(flat.size() / 3), _mp8_layout.size())
+	for i in n:
+		_mp8_layout[i] = [
+			Vector3(flat[i * 3], 0.0, flat[i * 3 + 1]),
+			flat[i * 3 + 2],
+		]
+
+	_mp8_apply_hardware_layout()
+
+
+func _mp8_layout_flat() -> PackedFloat32Array :
+
+	var flat := PackedFloat32Array()
+	for row in _mp8_layout:
+		flat.append((row[0] as Vector3).x)
+		flat.append((row[0] as Vector3).z)
+		flat.append(float(row[1]))
+	return flat
+
+
+func _mp8_load_layout() -> void :
+
+	_mp8_layout_reset()
+
+	if not FileAccess.file_exists(MP8_BURN_LAYOUT_FILE):
+		return
+
+	var f := FileAccess.open(MP8_BURN_LAYOUT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] 人工筛选：读不了 %s（错误 %d）" % [
+			MP8_BURN_LAYOUT_FILE, FileAccess.get_open_error()])
+		return
+
+	var i: int = 0
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var parts: PackedStringArray = line.split(",", false)
+		if parts.size() < 3:
+			push_warning("[MP8] 人工筛选：布局文件这一行看不懂，跳过")
+			continue
+		if i < _mp8_layout.size():
+			_mp8_layout[i] = [
+				Vector3(float(parts[0].strip_edges()), 0.0, float(parts[1].strip_edges())),
+				float(parts[2].strip_edges()),
+			]
+		i += 1
+	f.close()
+
+	_mp8_layout_src = "存盘文件（%d 行）" % i
+	print("[MP8] 人工筛选：读到手调布局 %d 行 → %s" % [
+		i, ProjectSettings.globalize_path(MP8_BURN_LAYOUT_FILE)])
+
+
+func _mp8_save_layout() -> bool :
+
+	var f := FileAccess.open(MP8_BURN_LAYOUT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] 人工筛选：写不了 %s（错误 %d）" % [
+			MP8_BURN_LAYOUT_FILE, FileAccess.get_open_error()])
+		return false
+
+	f.store_line("# 人工筛选（mp8game=17）工位手调布局 —— 一行一个工位，共 %d 行" % mp8_seats)
+	f.store_line("# 每行：dx, dz, dyaw（相对**默认两派摆位**的增量，不是绝对坐标）")
+	f.store_line("# 一个工位 = 玩家实例（含控制台/货道/记分屏/摄像机）+ 传送带 + 冲压机 + 指示灯，整体移动")
+	f.store_line("# 删掉本文件 = 回到默认（内圈 4 + 外圈 4，外推 %.2f 米）" % mp8_ring_push)
+	f.store_line("# 可以直接用记事本改。存于 %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for s in _mp8_layout.size():
+		var row: Array = _mp8_layout[s]
+		var d: Vector3 = row[0]
+		f.store_line("%.3f, %.3f, %.1f    # %d号工位（%s）" % [
+			d.x, d.z, float(row[1]), s, "外圈" if _mp8_push_for(s) > 0.0 else "内圈"])
+	f.close()
+
+	print("[MP8] 人工筛选：布局已存盘（%d 个工位）→ %s" % [
+		_mp8_layout.size(), ProjectSettings.globalize_path(MP8_BURN_LAYOUT_FILE)])
+	return true
+
+
+# ── 局内手调 UI ────────────────────────────────────────────────────────────
+
+func _mp8_edit_begin() -> void :
+
+	var lbl := Label.new()
+	lbl.name = "MP8BurnEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.position = Vector2(16, - 220)
+	lbl.add_theme_color_override("font_color", Color(1, 1, 0.4))
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.add_theme_font_size_override("font_size", 16)
