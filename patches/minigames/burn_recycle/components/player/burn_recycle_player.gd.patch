+#
+# 为什么值得单独做一个：本局最致命的一类 bug 就是"工位号 → 硬件"配错或配不到 ——
+#   * belts[seat] 越界拿到 null → 货道不滚；
+#   * presses 匹配不到 → active_press 恒 null → set_eliminated_rpc() 第一句就报错
+#     中断整个函数 → **被淘汰的人照样能继续玩**。
+# 这两条在画面上都不会立刻显形（第二条要等有人被淘汰才爆），
+# 所以把绑定结果直接摆在屏幕上，一眼就能判 8 个工位是不是都配齐了。
+#
+# 原版有一个 `debug: Label3D` 只写了 "seat: N"，那是**世界空间**里的小牌子，
+# 远了根本看不清，也不含 id 与硬件绑定 —— 这里是屏幕空间的独立面板，不动它。
+#
+# ⚠️ ③ 收尾：这是显式开关、默认关、不跟 -debug-tools 走。不传参数一个像素都不多。
+
+var _mp8_dbg_canvas: CanvasLayer = null
+var _mp8_dbg_panel: Label = null
+
+
+func _mp8_debug_on() -> bool :
+	return Array(OS.get_cmdline_args()).has("mp8burndebug")
+
+
+func _mp8_debug_build() -> void :
+
+	if _mp8_dbg_panel != null or not _mp8_debug_on():
+		return
+
+	# 只在**本人那一端**建面板：每个窗口显示自己的绑定，不是别人的。
+	if player_presence == null:
+		return
+	if not GameManager.local_game and player_presence.network_id != multiplayer.get_unique_id():
+		return
+
+	var lbl := Label.new()
+	lbl.name = "MP8BurnDebugPanel"
+	lbl.set_anchors_preset(Control.PRESET_TOP_LEFT)
+	lbl.position = Vector2(14, 10)
+	lbl.add_theme_color_override("font_color", Color(0.6, 1.0, 0.6))
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.add_theme_font_size_override("font_size", 15)
+
+	_mp8_dbg_canvas = CanvasLayer.new()
+	_mp8_dbg_canvas.layer = 127
+	_mp8_dbg_canvas.add_child(lbl)
+	add_child(_mp8_dbg_canvas)
+	_mp8_dbg_panel = lbl
+
+
+func _mp8_debug_refresh() -> void :
+
+	if _mp8_dbg_panel == null:
+		return
+
+	var seats: int = _mp8_seats()
+	var pname: String = "?"
+	var pid: int = 0
+	if player_presence != null:
+		pname = String(player_presence.network_name)
+		pid = player_presence.network_id
+
+	# 指示灯：本工位负责点亮的是**前一个工位**那盏（原版语义，环形回绕）
+	var ind_id: int = active_seat_index - 1
+	if ind_id < 0:
+		ind_id = seats - 1
+
+	var belt_txt: String = "✗ 没配到"
+	if active_belt != null:
+		belt_txt = "✓ %s" % String(active_belt.name)
+
+	var press_txt: String = "✗ 没配到（淘汰流程会炸）"
+	if active_press != null:
+		press_txt = "✓ press_id=%d" % active_press.press_id
+
+	var ring: String = "?"
+	var push: float = 0.0
+	if game_instance != null:
+		push = float(game_instance.mp8_ring_push)
+		ring = "外圈 +%.2f 米" % push if (active_seat_index % 2) == 1 and push > 0.0 else "内圈"
+
+	var lines := PackedStringArray()
+	lines.append("[MP8] 人工筛选 · 绑定调试")
+	lines.append("玩家 %s    id = %d" % [pname, pid])
+	lines.append("工位 %d / 共 %d 个    %s" % [active_seat_index, seats, ring])
+	lines.append("传送带  %s" % belt_txt)
+	lines.append("冲压机  %s" % press_txt)
+	lines.append("指示灯  我负责点亮 %d 号工位那盏" % ind_id)
+	lines.append("货道 %d 格    工位世界坐标 (%.2f, %.2f)" % [
+		item_positions.size(), global_position.x, global_position.z])
+
+	_mp8_dbg_panel.text = "\n".join(lines)
