 	player_scores_finalized.emit(player_scores)
 
+
+# [MP8] 结算时把名次/名字/得分打进日志，纯为事后对账，不动任何分数。
+#
+# ② 得分**用户 2026-08-17 定案：保持原版，一个字不改**（和凿刻考验那次同样的选择）。
+# 原版机制只有两处：
+#   `player_scores[dead_players[i]] = i`   —— 第 i 个掉下去的拿 i 分
+#   `player_scores[幸存者] = player_count` —— 活到最后的拿总人数
+# 于是 4 人 = 0/1/2/**4**、8 人 = 0/1/2/3/4/5/6/**8**，
+# **冠亚之间恒跳 2 分**，其余步长 1。用户判定这一分是"活到最后"应得的奖励，不压平。
+#
+# ⚠️ **已知未修的原版 bug（用户同一次一并选择不动）**：
+# `player_count` 是 `spawn_players()` 里记的**开局人数**，不随掉线更新。
+# 有人中途掉线时，幸存者拿的分比实际参与结算的人数多 —— 凭空多几分。
+# 残骸平台当初刻意用 `dead_players.size()` 而不是 `player_count`，躲的就是这条。
+# 要修就把 `:431` 换成 `dead_players.size() + 1`（无人掉线时与原版逐值相同）。
+#
+# ⚠️ 顺带记一条：`scoring_players` 是**死代码** —— 声明了、`remove_player` 里有一处
+# `erase`，但全文件从没 append 过。和枪械工厂的 `finished_players` 一模一样的形状。
+# 不影响算分，但别被它误导成"这里还有一套顺序数组能用"。
+func _mp8_log_scores() -> void :
+
+	var rows := PackedStringArray()
+
+	for i in dead_players.size():
+		var id: int = dead_players[i]
+		rows.append("第%d个掉 %s %d分" % [i + 1, _mp8_name(id), i])
+
+	for network_id in active_players.keys():
+		rows.append("幸存 %s %d分" % [_mp8_name(network_id), player_count])
+		break
+
+	print("[MP8] 立足之本结算（开局 %d 人 / %d 人掉下去）：%s" % [
+		player_count, dead_players.size(), " | ".join(rows)
+	])
+
+
+func _mp8_name(network_id: int) -> String :
+	if players.has(network_id) and is_instance_valid(players[network_id]):
+		return String(players[network_id].player_presence.network_name)
+	return str(network_id)
+
 func finish_game():
 
 	await get_tree().create_timer(2.0).timeout
