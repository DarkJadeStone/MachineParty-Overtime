+# 命令行 `mp8spinefuse=<秒>`：把**所有**装置的引信按同一个值覆盖，返回 0 表示没传。
+# 故意做成"覆盖全部" —— 它的用途正是**手动制造锁步**来复现"两个人同时死"那个现象
+# （两台引信一样长就会同帧杀人，见 MP8_DEVICE_FUSE 那段）。
+func _mp8_fuse_forced() -> float :
+
+	for a in OS.get_cmdline_args():
+		var s: String = str(a)
+		if s.begins_with("mp8spinefuse="):
+			var v: String = s.substr(len("mp8spinefuse="))
+			if v.is_valid_float():
+				return clampf(float(v), 1.0, 60.0)
+
+	return 0.0
