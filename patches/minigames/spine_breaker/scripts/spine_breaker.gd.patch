+# [MP8] 给某台装置的机体染色，返回染了几个面。
+#
+# ⚠️⚠️ **绝对不能直接改材质本身**（`mat.albedo_color = 红` 这种写法）：
+# probe44 查清楚了，机体材质是**嵌在 device.tscn 里的** `StandardMaterial3D_66jhi`，
+# 同一个 .tscn 实例化出来的两台**指向同一个资源对象** —— 改它 1 号机会跟着红，
+# 而且资源跨局缓存，下一局、下一个小游戏它还是红的（T19 那个"一局比一局跑得更远"
+# 就是改资源留下的）。
+#
+# 正确做法是 `set_surface_override_material()` —— 覆盖材质挂在 **MeshInstance3D 节点**上，
+# 节点是每台各一份的。复制一份材质再改副本，原资源一个字节不动。
+# （复制的是**资源**不是**节点**，不触犯"补数组时不要新建场景节点"那条坑第 14 条。）
+#
+# 只染"本来就有 StandardMaterial3D 且看得见"的面：
+# `Visuals/MeshInstance3D` 那个球是 `visible=false` 的辅助件、且没有材质，
+# 给它硬塞一个覆盖材质等于凭空造出一个红球。
+func _mp8_tint_device(d, c: Color) -> int :
+
+	if not is_instance_valid(d):
+		return 0
+
+	var n: int = 0
+
+	for mi in d.find_children("", "MeshInstance3D", true, false):
+
+		if not mi.visible or mi.mesh == null:
+			continue
+
+		for s in mi.mesh.get_surface_count():
+
+			var src = mi.get_active_material(s)
+			if not (src is StandardMaterial3D):
+				continue
+
+			var sd: StandardMaterial3D = src
+
+			# 顺手记下机体贴图的钥匙（**白色那台也要记**，跟染不染色无关）：
+			# attach 之后要拿它在玩家背上那堆网格里认出哪个面是机器。
+			if d.mp8_tex_key == "" and sd.albedo_texture != null:
+				var f: String = str(sd.albedo_texture.resource_path).get_file()
+				var us: int = f.rfind("_")
+				d.mp8_tex_key = (f.substr(us + 1) if us >= 0 else f)
+
+			if c == Color.WHITE:
+				continue
+
+			# 已经染过就跳过 —— 本函数每轮都会跑一遍，不挡住会每轮多复制一份材质
+			if mi.get_surface_override_material(s) != null:
+				continue
+
+			var m: StandardMaterial3D = sd.duplicate()
+			m.albedo_color = c
+			mi.set_surface_override_material(s, m)
+			n += 1
+
+	return n
+
