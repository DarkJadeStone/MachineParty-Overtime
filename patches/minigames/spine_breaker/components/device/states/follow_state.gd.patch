+				"target": p
+			})
+			return
+
+		if not _mp8_can_target(p):      # [MP8] 换目标才看归属
+			continue
+
+		if distance < closest_distance:
 
 			closest_distance = distance
 			closest = p
@@ -107,6 +252,9 @@ func _on_player_attach_entered(body):
 	if body is not SpineBreakerPlayer:
