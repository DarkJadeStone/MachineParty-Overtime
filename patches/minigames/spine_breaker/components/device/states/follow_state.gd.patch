+# [MP8] 见文件头 MP8_DEADEND_RETRY 上那段：目标已经不可扑就跟宿主要新的。
+#
+# ⚙ 判据用 `_mp8_can_take` 而不是只看 `has_spine_breaker`：死人、失效引用
+#    同样是「永远扑不上」，一并覆盖（比如另一台先把他杀了，这台还在追尸体）。
+# ⚙ 只在服务器发：`request_new_target` 的接线在 `spine_breaker.gd` 里就包在
+#    `if multiplayer.is_server():` 内，客机发出去没人听。
+# ⚙ `not active` 时直接返回：本帧已经转出 Follow 了，不该再插一手。
+func _mp8_check_dead_end(_delta: float) -> void :
+
+	if not active:
+		return
+
+	if _mp8_deadend_cd > 0.0:
+		_mp8_deadend_cd -= _delta
+		return
+
+	if target == null:
+		return
+	if _mp8_can_take(target):
+		return
+
+	_mp8_deadend_cd = MP8_DEADEND_RETRY
+
+	if not multiplayer.is_server():
+		return
+
+	var who: String = "?"
+	var why: String = "引用已失效"
+	if is_instance_valid(target):
+		who = String(target.name)
+		if target.has_spine_breaker:
+			why = "已经背着机器"
+		elif not target.active:
+			why = "已死"
+	print("[MP8] 碎骨者：%d 号机盯着 %s 但永远扑不上（%s）—— 要新目标" % [
+		owner.mp8_index, who, why
+	])
+	owner.request_new_target.emit()
+
