+# [MP8] 服务器在 spawn_players() 里按总人数广播一次。
+# **每台机器都要收**：开枪判定 `gun_shot_area.get_overlapping_bodies()` 和
+# `shoot_cooldown_timer` 都是在**开枪那个人自己的机器**上算的，
+# 只在服务器改的话，客户端玩家手里还是原版那把强枪。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_set_gun_power_rpc(m: float) -> void :
+
+	mp8_gun_power = m
+	_mp8_apply_gun_power()
+
+
+func _mp8_apply_gun_power() -> void :
+
+	# 基准值只记一次，之后一律"基准 × 系数"。
+	# 不记基准的话反复调用会**连乘**（残骸平台落石倍率那个坑，按两次 5 倍变 25 倍）。
+	if _mp8_cd_base < 0.0:
+		_mp8_cd_base = shoot_cooldown
+	if _mp8_area_base_pos == Vector3.INF and gun_shot_area != null:
+		_mp8_area_base_pos = gun_shot_area.position
+
+	var m: float = maxf(0.05, mp8_gun_power)
+
+	# 射速 ×m ⇒ 冷却 ÷m（冷却变长 = 打得慢）
+	shoot_cooldown = _mp8_cd_base / m
+
+	# 范围 ×m：缩 Area3D 自己的位置与缩放，**不碰共享的 SphereShape3D 资源**
+	if gun_shot_area != null:
+		gun_shot_area.position = _mp8_area_base_pos * m
+		gun_shot_area.scale = Vector3.ONE * m
+
+	# 只打一次，8 个实例 × 8 个玩家节点会把日志刷爆
+	if not _mp8_gun_logged:
+		_mp8_gun_logged = true
+		var r: float = 0.0
+		if gun_shot_area != null:
+			for c in gun_shot_area.get_children():
+				if c is CollisionShape3D and (c as CollisionShape3D).shape is SphereShape3D:
+					r = ((c as CollisionShape3D).shape as SphereShape3D).radius * m
+		print("[MP8] 枪械工厂：枪力 ×%.2f —— 冷却 %.2f→%.2f 秒（%.1f→%.1f 发/分）、杀伤半径 %.2f、球心前移 %.2f 米" % [
+			m, _mp8_cd_base, shoot_cooldown, 60.0 / _mp8_cd_base, 60.0 / shoot_cooldown,
+			r, absf(gun_shot_area.position.z) if gun_shot_area != null else 0.0
+		])
+
