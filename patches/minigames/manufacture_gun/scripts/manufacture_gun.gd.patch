+func _mp8_child_count(path: String) -> int :
+	var n: Node = get_node_or_null(path)
+	return (n.get_child_count() if n != null else -1)
+
+
+# [MP8] 右上角常驻一行「枪械已削弱 · <程度>」，蓝色（用户 2026-08-16 要的）。
+#
+# 照猎鸭那条已定的规矩：**只说方向和程度，不显示具体数值**
+# （用户 2026-08-15：数值是设计者的事，玩家只需要知道方向）。蓝 = 削弱，也沿用猎鸭的配色。
+#
+# 这是**每台机器一份的屏幕提示，不是每个玩家节点一份**：挂在小游戏根节点上建一次就行。
+# ⚠️ 猎鸭那边把 HUD 挂在玩家身上，结果每台机器的节点树里 8 个玩家各建一个 Label、
+# 右上角叠成一团，还得判 `network_id == multiplayer.get_unique_id()` 才治好。
+# 这里从一开始就建在小游戏上，天然没有那个问题。
+#
+# 程度按系数分档（不是按人数写死），这样 `mp8gunpower=` 临时调值时标签也跟着对：
+#   ≥1.0 不显示 | ≥0.875 略微 | ≥0.825 小幅 | ≥0.70 中等 | 其余 大幅
+# 对应默认表：5 人 0.90=略微、6 人 0.85=小幅、7 人 0.80=中等、8 人 0.60=大幅。
+func _mp8_gun_hud() -> void :
+
+	var m: float = _mp8_gun_power()
+	if m >= 1.0:
+		return          # 没削弱就什么都不显示（≤4 人 = 原版，屏幕上一个像素都不多）
+
+	var level: String
+	if m >= 0.875:
+		level = "略微"
+	elif m >= 0.825:
+		level = "小幅"
+	elif m >= 0.70:
+		level = "中等"
+	else:
+		level = "大幅"
+
+	# 用户 2026-08-16 定：**一律中文**（不跟语言设置走），
+	# 程度词嵌在「已」和「削弱」中间 —— 「枪械已大幅削弱」，不是「大幅 · 枪械已削弱」。
+	var txt: String = "枪械已%s削弱" % level
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8GunNerfHud"
+	layer.layer = 100
+	add_child(layer)
+
+	var lbl := Label.new()
+	lbl.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+	lbl.offset_left = -640.0
+	lbl.offset_top = 14.0
+	lbl.offset_right = -18.0
+	lbl.offset_bottom = 54.0
+	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+	lbl.text = txt
+
+	# ⚠️ 必须显式指定游戏自己的字体：默认主题字体**字距是坏的**，
+	# 实测会把 "P3  id 104…" 挤成 "P36idc104…"。猎鸭、残骸平台都栽过，这是第三次。
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 26)
+	lbl.add_theme_color_override("font_color", Color(0.42, 0.71, 1.0))   # 蓝 = 削弱
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	layer.add_child(lbl)
+
+	print("[MP8] 枪械工厂：右上角提示「%s」（系数 ×%.2f，本局 %d 人）" % [txt, m, mp8_player_count])
+
+
+# [MP8] 本局的"枪力系数"。表在 ManufactureGunPlayer 里（那儿才是用它的地方）。
+# 命令行 `mp8gunpower=<系数>` 可临时覆盖，不用重新编译 —— 调手感时用。
+func _mp8_gun_power() -> float :
+
+	var forced: String = _mp8_arg("mp8gunpower=")
+	if forced.is_valid_float():
+		var f: float = clampf(float(forced), 0.05, 4.0)
+		print("[MP8] 枪械工厂：命令行强制枪力 ×%.2f（本局 %d 人）" % [f, mp8_player_count])
+		return f
+
+	# 表里没有的人数（≤4，或者万一超过 8）一律 1.0 = 原版
+	return float(ManufactureGunPlayer.MP8_GUN_POWER_BY_COUNT.get(mp8_player_count, 1.0))
+
+
+# [MP8] 按 MP8_LAYOUT_* 表补工位。每个新位都是**整组复制原版 0 号那一组**
+# （工位标记 + 它那张空桌 + 它那个教程高亮框），再整组搬到目标位置、整组转到目标角度。
+# 四份原件是同一个预制件（空桌网格都是 2.36×2.14×3.71、高亮框都是 2.36×2.11×3.88，
+# probe33 量过），所以拿哪一份当模子都一样，用 0 号最省事也最确定。
+#
+# ⚠️ 为什么**不搬玩家出生点**：出生点交给 network_manager 的通用补位
+# （它那 4 个中点实测都在空地上）。自己搬过一版，把出生点跟工位一起平移，
+# 实测有 2 个落进实体（(-1.32,-5.15) 在中央料台的道具里、
+# (-1.32,+5.33) 直接在料台碰撞盒里）。代价是 5~8 号玩家离自己工位远一些，
+# 日志里会把每个人的距离打出来。
+func _mp8_expand_workstations(want: int) -> void :
+
+	var ws: Node3D = get_node_or_null("WorkstationSpawns") as Node3D
+	if ws == null:
+		push_warning("[MP8] 枪械工厂：找不到 WorkstationSpawns，工位没扩")
+		return
+
+	var originals: Array[Node3D] = []
+	for c in ws.get_children():
+		if c is Node3D:
+			originals.append(c)
+
+	if originals.is_empty():
+		push_warning("[MP8] 枪械工厂：一个工位都没有，扩不了")
+		return
+	if originals.size() >= want:
+		return
+
+	var desks: Node3D = get_node_or_null("empty_desks") as Node3D
+	_mp8_collect_workspace_boxes()
+
+	var layout: Array = _mp8_layout_live
+	var src: Node3D = originals[0]
+	var src_desk: Node3D = (_mp8_nearest_child(desks, src.global_position) if desks != null else null)
+	var src_box: MeshInstance3D = _mp8_nearest_box(src.global_position)
+
+	var added := PackedStringArray()
+
+	for i in layout.size():
+
+		if ws.get_child_count() >= want:
+			break
+
+		var target: Vector3 = layout[i][0]
+		var yaw: float = layout[i][1]
+
+		# ---- 工位标记 ----
+		var dup: Node3D = src.duplicate()
+		dup.name = "MP8Workstation%d" % i
+		ws.add_child(dup)
+		dup.global_position = Vector3(target.x, src.global_position.y, target.z)
+		dup.rotation_degrees = Vector3(0.0, yaw, 0.0)
+
+		# ---- 那张空桌 ----
+		var desk_note: String = "无空桌"
+		var d2: Node3D = null
+		if src_desk != null:
+			d2 = _mp8_clone_to(src_desk, target, yaw, "MP8%d" % i)
+			if d2 != null:
+				empty_desk_array.append(d2)
+				desk_note = String(src_desk.name)
+
+		# ---- 那个教程高亮框 ----
+		var b2: MeshInstance3D = null
+		if src_box != null:
+			var b = _mp8_clone_to(src_box, target, yaw, "MP8%d" % i)
+			if b is MeshInstance3D:
+				b2 = b
+				_mp8_ws_boxes.append(b2)
+
+		# [MP8] 手调模式要一次挪动这一整组家当，**建的时候就把引用记下来**。
+		# 不用事后按位置认：位置正是待会儿要被改的东西，拿它当钥匙会越挪越错
+		# （残骸平台"编号不可信、位置才可信"那条的反面 —— 位置会变时，引用才可信）。
+		_mp8_slots.append({
+			"marker": dup, "desk": d2, "box": b2, "ws": null, "tag": null,
+		})
+
+		added.append("新%d(%.2f,%.2f)转%.0f° 空桌 %s" % [
+			i, target.x, target.z, yaw, desk_note
+		])
+
+	print("[MP8] 枪械工厂：工位 %d → %d（摆法 %s）—— %s" % [
+		originals.size(), ws.get_child_count(), _mp8_layout_src, " | ".join(added)
+	])
+	print("[MP8] 枪械工厂：empty_desk_array %d → %d 项；教程高亮框 %d 个" % [
+		originals.size(), empty_desk_array.size(), _mp8_ws_boxes.size()
+	])
+
+	_mp8_check_slots(ws)
+
+
+# 整组复制里的一件：搬到目标水平位置、转到目标角度，**保留它自己的 y**
+# （空桌在 -0.117、高亮框在 +1.9 左右，这些组内偏移不能动）。
+func _mp8_clone_to(src: Node3D, target: Vector3, yaw: float, suffix: String) -> Node3D :
+
+	var parent: Node = src.get_parent()
+	if parent == null:
+		return null
+
+	var dup: Node3D = src.duplicate()
+	dup.name = "%s_%s" % [String(src.name), suffix]
+	parent.add_child(dup)
+	dup.global_position = Vector3(target.x, src.global_position.y, target.z)
+	dup.global_rotation_degrees = Vector3(0.0, yaw, 0.0)
+	return dup
+
+
+# 自检：每个工位必须恰好配到一张空桌，而且两张桌子不能抢同一张。
+# （照残骸平台翻转配对那两条自检的写法：不满足就打 ❌，不用靠肉眼看画面。）
+func _mp8_check_slots(ws: Node3D) -> void :
+
+	var used: Array[int] = []
+	var bad := 0
+	var parts := PackedStringArray()
+
+	for c in ws.get_children():
+		if not (c is Node3D):
+			continue
+		var best := -1
+		var bd: float = INF
+		for k in empty_desk_array.size():
+			var d: Node3D = empty_desk_array[k]
+			if d == null or not is_instance_valid(d):
+				continue
+			var dd: float = _mp8_flat(d.global_position, (c as Node3D).global_position)
+			if dd < bd:
+				bd = dd
+				best = k
+		if best < 0 or bd > MP8_DESK_MATCH_TOL:
+			bad += 1
+			parts.append("%s→无桌(最近 %.2f)❌" % [String(c.name), bd])
+		elif used.has(best):
+			bad += 1
+			parts.append("%s→桌%d 抢占❌" % [String(c.name), best])
+		else:
+			used.append(best)
+			parts.append("%s→桌%d(%.2f)" % [String(c.name), best, bd])
+
+	print("[MP8-WIRE] 枪械工厂：工位↔空桌配对 %s —— %s" % [
+		("✓ 一一对应" if bad == 0 else "❌ %d 处不对" % bad), ", ".join(parts)
+	])
+	if bad > 0:
+		push_warning("[MP8] 枪械工厂：工位与空桌没能一一对应，空桌可能不会消失")
+
+
+func _mp8_collect_workspace_boxes() -> void :
+
+	_mp8_ws_boxes = []
+	var marker: Node = get_node_or_null("PlayerMarker")
+	if marker == null:
+		return
+	var boxes = marker.get("bounds_workspaces")
+	if not (boxes is Array):
+		return
+	for b in (boxes as Array):
+		if b is MeshInstance3D:
+			_mp8_ws_boxes.append(b)
+
+
+func _mp8_nearest_child(parent: Node, pos: Vector3) -> Node3D :
+	var best: Node3D = null
+	var bd: float = INF
+	for c in parent.get_children():
+		if not (c is Node3D):
+			continue
+		var d: float = _mp8_flat((c as Node3D).global_position, pos)
+		if d < bd:
+			bd = d
+			best = c
+	return (best if bd <= MP8_DESK_MATCH_TOL else null)
+
+
+func _mp8_nearest_box(pos: Vector3) -> MeshInstance3D :
+	var best: MeshInstance3D = null
+	var bd: float = INF
+	for b in _mp8_ws_boxes:
+		if not is_instance_valid(b):
+			continue
+		var d: float = _mp8_flat(b.global_position, pos)
+		if d < bd:
+			bd = d
+			best = b
+	return (best if bd <= MP8_DESK_MATCH_TOL * 3.0 else null)
+
+
+func _mp8_flat(a: Vector3, b: Vector3) -> float :
+	return Vector2(a.x - b.x, a.z - b.z).length()
+
+
+func _mp8_arg(prefix: String) -> String :
+	for a in OS.get_cmdline_args():
+		if String(a).begins_with(prefix):
+			return String(a).substr(prefix.length())
+	return ""
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 桌位手调 —— 用户自己在游戏里把新增的 4 张桌子推到想要的位置
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 只动**新增的 4 张**（用户 2026-08-16 定）。原版那 4 张一个字节不动，
+# 所以 4 人局与原版逐值一致这条永远成立，probe37 的合法性判据也还有校准基准。
+#
+# 三个部分：
+#   ① 存盘文件 user://mp8_gun_layout.txt —— 开局时读，覆盖内置 ring 表
+#   ② 局内按键 —— 选桌 / 推桌 / 转桌 / 存盘，走 RPC 让 8 个窗口同步
+#   ③ 屏幕上的读数 —— 把这个项目付过学费的两条判据实时显示出来：
+#        坑第 25 条：摆位要看**屏幕投影间距**，不是地上放不放得下
+#        probe36  ：两张桌挨太近，交互会互相打架（见 MP8_MIN_DESK_GAP）
+
+
+# 生效顺序：存盘文件 > mp8gunlayout= > 内置 ring。
+func _mp8_build_live_layout(ignore_file: bool) -> void :
+
+	var from_file: Array = ([] if ignore_file else _mp8_parse_layout_file())
+
+	if not from_file.is_empty():
+		_mp8_layout_live = from_file
+		_mp8_layout_src = "存盘文件 %s" % MP8_LAYOUT_FILE
+		print("[MP8] 枪械工厂：读到手调布局 —— %s" % _mp8_layout_desc())
+		return
+
+	# ⚠️ const 数组在 Godot 4 是只读的，内层那个 [Vector3, float] 也是只读，
+	# 所以必须**逐项重建**，不能 duplicate()（浅拷贝，内层还是只读）。
+	var base: Array = (MP8_LAYOUT_SOLVER if _mp8_layout == "solver" else MP8_LAYOUT_RING)
+	_mp8_layout_live = []
+	for r in base:
+		_mp8_layout_live.append([r[0], float(r[1])])
+	_mp8_layout_src = "内置 %s" % _mp8_layout
+
+
+func _mp8_layout_desc() -> String :
+	var parts := PackedStringArray()
+	for i in _mp8_layout_live.size():
+		var p: Vector3 = _mp8_layout_live[i][0]
+		parts.append("新%d(%.2f,%.2f)@%.0f°" % [i + 1, p.x, p.z, _mp8_layout_live[i][1]])
+	return " ".join(parts)
+
+
+# 文件格式（一行一张桌：x, z, 转角度数），`#` 开头是注释。
+# 故意做成人能直接用记事本改的样子 —— 不想开游戏时也能改。
+func _mp8_parse_layout_file() -> Array :
+
+	if not FileAccess.file_exists(MP8_LAYOUT_FILE):
+		return []
+
+	var f := FileAccess.open(MP8_LAYOUT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] 枪械工厂：打不开 %s（%d），用内置布局" % [
+			MP8_LAYOUT_FILE, FileAccess.get_open_error()
+		])
+		return []
+
+	var rows: Array = []
+	var line_no: int = 0
+
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		line_no += 1
+		if line.is_empty() or line.begins_with("#"):
+			continue
+
+		var cols: PackedStringArray = line.split(",", false)
+		if cols.size() < 3:
+			push_warning("[MP8] 枪械工厂：布局文件第 %d 行不是 3 个数，跳过：%s" % [line_no, line])
+			continue
+
+		var x: String = cols[0].strip_edges()
+		var z: String = cols[1].strip_edges()
+		var a: String = cols[2].strip_edges()
+		if not (x.is_valid_float() and z.is_valid_float() and a.is_valid_float()):
+			push_warning("[MP8] 枪械工厂：布局文件第 %d 行有非数字，跳过：%s" % [line_no, line])
+			continue
+
+		rows.append([Vector3(float(x), 0.0, float(z)), float(a)])
+
+	f.close()
+
+	# 少于 4 行就拿内置表把后面补齐，多了截断 —— 免得用户少写一行整局崩掉
+	if rows.is_empty():
+		return []
+	while rows.size() < MP8_LAYOUT_RING.size():
+		var r = MP8_LAYOUT_RING[rows.size()]
+		rows.append([r[0], float(r[1])])
+		push_warning("[MP8] 枪械工厂：布局文件只有 %d 行，第 %d 张用内置值补上" % [
+			rows.size() - 1, rows.size()
+		])
+	rows.resize(MP8_LAYOUT_RING.size())
+	return rows
+
+
+func _mp8_save_layout_file() -> bool :
+
+	var f := FileAccess.open(MP8_LAYOUT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] 枪械工厂：写不了 %s（错误 %d）" % [
+			MP8_LAYOUT_FILE, FileAccess.get_open_error()
+		])
+		return false
+
+	f.store_line("# 枪械工厂（mp8game=3）8 人布局 —— 新增的那 4 张桌子")
+	f.store_line("# 原版 4 张不在这个文件里，它们一个字节没动。")
+	f.store_line("# 每行 = x, z, 转角度数。可以直接用记事本改，也可以在游戏里按 0 存盘覆盖。")
+	f.store_line("# 删掉这个文件就回到内置 ring 布局。")
+	f.store_line("# 存于 %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for r in _mp8_layout_live:
+		var p: Vector3 = r[0]
+		f.store_line("%.2f, %.2f, %.0f" % [p.x, p.z, float(r[1])])
+	f.close()
+
+	# 顺带把可以直接贴回 MP8_LAYOUT_RING 的写法打进日志 ——
+	# 定稿之后要把它烘进常量，省得下一个 agent 再反推一次坐标。
+	var snippet := PackedStringArray()
+	for r in _mp8_layout_live:
+		var p: Vector3 = r[0]
+		snippet.append("\t[Vector3(%.2f, 0.0, %.2f), %.1f]," % [p.x, p.z, float(r[1])])
+	print("[MP8] 枪械工厂：布局已存盘 → %s" % ProjectSettings.globalize_path(MP8_LAYOUT_FILE))
+	print("[MP8] 枪械工厂：定稿后可直接贴进 MP8_LAYOUT_RING —— \n%s" % "\n".join(snippet))
+	return true
+
+
+func _mp8_edit_layer() -> CanvasLayer :
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+	return _mp8_edit_canvas
+
+
+# ⚠️ 必须显式指定游戏自己的字体：默认主题字体**字距是坏的**，
+# 实测会把 "P3  id 104..." 显示成 "P36idc104..."。猎鸭和残骸平台都栽过。
+func _mp8_style_label(lbl: Label, color: Color) -> void :
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 22)
+	lbl.add_theme_color_override("font_color", color)
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+func _mp8_edit_begin() -> void :
+
+	if _mp8_slots.is_empty():
+		push_warning("[MP8] 枪械工厂：没有新增桌子，手调模式不启动")
+		_mp8_edit_on = false
+		return
+
+	# 屏幕左下角的面板
+	var lbl := Label.new()
+	lbl.name = "MP8GunEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -150.0
+	lbl.offset_right = 900.0
+	lbl.offset_bottom = -8.0
+	_mp8_style_label(lbl, Color(0.6, 0.95, 1.0))
+	_mp8_edit_layer().add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	# 每张可调的桌子头顶挂个号码牌，否则 8 张桌子里根本认不出"我在调哪张"
+	for i in _mp8_slots.size():
+		var rec: Dictionary = _mp8_slots[i]
+		var marker = rec.get("marker")
+		if marker == null or not is_instance_valid(marker):
+			continue
+		var tag := Label3D.new()
+		tag.name = "MP8EditTag"
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 200
+		tag.outline_size = 40
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true       # 被桌子挡住也要看得见，否则转到背面就找不着了
+		var f = load("res://fonts/Terminal F4.ttf")
+		if f != null:
+			tag.font = f
+		marker.add_child(tag)
+		tag.position = Vector3(0.0, 4.0, 0.0)
+		rec["tag"] = tag
+
+	_mp8_edit_check_keys()
+	_mp8_edit_refresh()
+
+	print("[MP8] 枪械工厂：桌位手调模式已开 —— 可调 %d 张新桌，当前布局来源：%s" % [
+		_mp8_slots.size(), _mp8_layout_src
+	])
+
+
+# [MP8] 按键撞车自检。
+# 这个项目的规矩是"别拿脚本字面量当真值"，按键也一样：与其赌 I/J/K/L 没被占，
+# 不如开局把 InputMap 里真实绑定过的键查一遍，撞了就报出来。
+func _mp8_edit_check_keys() -> void :
+
+	var mine: Dictionary = {
+		KEY_1: "选1", KEY_2: "选2", KEY_3: "选3", KEY_4: "选4",
+		KEY_I: "远", KEY_K: "近", KEY_J: "左", KEY_L: "右",
+		KEY_U: "左转", KEY_O: "右转",
+		KEY_5: "步长", KEY_0: "存盘", KEY_9: "复位", KEY_8: "打报告",
+	}
+	var clash := PackedStringArray()
+
+	for action in InputMap.get_actions():
+		for ev in InputMap.action_get_events(action):
+			var k := ev as InputEventKey
+			if k == null:
+				continue
+			for code in [k.keycode, k.physical_keycode]:
+				if code != 0 and mine.has(code):
+					clash.append("%s(%s)↔动作 %s" % [
+						OS.get_keycode_string(code), mine[code], String(action)
+					])
+
+	if clash.is_empty():
+		print("[MP8] 枪械工厂：手调按键与游戏 InputMap 无冲突（查了 %d 个动作）" % InputMap.get_actions().size())
+	else:
+		push_warning("[MP8] 枪械工厂：手调按键和游戏动作撞车 —— %s" % ", ".join(clash))
+		print("[MP8] 枪械工厂：⚠️ 按键撞车 —— %s" % ", ".join(clash))
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or _mp8_slots.is_empty():
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+
+	match key.keycode:
+		KEY_1, KEY_2, KEY_3, KEY_4:
+			var want: int = key.keycode - KEY_1
+			if want >= _mp8_slots.size():
+				return
+			_mp8_edit_sel = want
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			# 按**屏幕方向**推，不是世界坐标轴。相机沿 +X 看，屏幕横向≈z、纵向≈x，
+			# 但这里不写死：直接从当前相机的基向量算，相机哪天改了也不会反向。
+			var dir: Vector2 = _mp8_screen_axis(key.keycode)
+			if dir == Vector2.ZERO:
+				return
+			var cur: Vector3 = _mp8_layout_live[_mp8_edit_sel][0]
+			var np := Vector3(cur.x + dir.y * step, 0.0, cur.z + dir.x * step)
+			mp8_gun_move_rpc.rpc(_mp8_edit_sel, np, float(_mp8_layout_live[_mp8_edit_sel][1]))
+
+		KEY_U, KEY_O:
+			var d: float = (- MP8_EDIT_YAW_STEP if key.keycode == KEY_U else MP8_EDIT_YAW_STEP)
+			var yaw: float = fposmod(float(_mp8_layout_live[_mp8_edit_sel][1]) + d, 360.0)
+			mp8_gun_move_rpc.rpc(_mp8_edit_sel, _mp8_layout_live[_mp8_edit_sel][0], yaw)
+
+		KEY_5:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_0:
+			var ok: bool = _mp8_save_layout_file()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("【已存盘】下次开局自动用这套坐标\n" if ok
+					else "【存盘失败】看日志\n") + _mp8_edit_panel.text
+
+		KEY_9:
+			# 回内置表：逐张广播回去，8 个窗口一起复位
+			var base: Array = (MP8_LAYOUT_SOLVER if _mp8_layout == "solver" else MP8_LAYOUT_RING)
+			for i in mini(base.size(), _mp8_slots.size()):
+				mp8_gun_move_rpc.rpc(i, base[i][0], float(base[i][1]))
+			print("[MP8] 枪械工厂：布局已复位成内置 %s（存盘文件没删，想彻底回退请删掉它）" % _mp8_layout)
+
+		KEY_8:
+			_mp8_edit_report()
+
+		_:
+			return
+
+	get_viewport().set_input_as_handled()
+
+
+# 屏幕方向 → 世界水平方向。返回 Vector2(dz, dx)：x 分量给世界 z，y 分量给世界 x。
+func _mp8_screen_axis(code: int) -> Vector2 :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector2.ZERO
+
+	# 相机右手方向 / 前方向，都压平到水平面（俯角不该让"往上推"变成往天上飞）
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var r2 := Vector2(right.z, right.x)
+	var f2 := Vector2(fwd.z, fwd.x)
+	if r2.length() < 0.001 or f2.length() < 0.001:
+		return Vector2.ZERO
+	r2 = r2.normalized()
+	f2 = f2.normalized()
+
+	match code:
+		KEY_L: return r2
+		KEY_J: return - r2
+		KEY_I: return f2
+		KEY_K: return - f2
+	return Vector2.ZERO
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 布局以房主为准广播（2026-08-19 修，用户 6 人真人局报的）
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# **症状**：房主视角里场地很干净，客机视角里路中间杵着一张桌子，还有碰撞体积。
+#
+# **根因不是几何，是"各机各读各的存盘文件"**：
+# `_mp8_setup_field()` 挂在 `_ready()`，每台机器都跑（空桌/高亮框是各机本地节点，
+# 本来就必须每台自己摆）；而它调的 `_mp8_build_live_layout()` 会去读
+# `user://mp8_gun_layout.txt`。那个文件是用户手调时按 `0` 存的，
+# **只存在于房主那台机器上** —— 房主读到定稿（四张桌全在墙边），
+# 客机读不到、回退内置 ring（B/C 摆在 x=+8.0 的开阔地正中，正是那两张挡路的）。
+# 两边场地从开局第一帧起就是两套，日志各自都是干净的。
+#
+# **做法**：`initialize()` 只在服务器上跑 —— 而且是在 `all_players_loaded()`
+# 之后才被 game.gd 调的（`_client_minigame_loaded_rpc` → `all_players_loaded`
+# → `minigame_ready` → `_on_minigame_ready` → `initialize`），
+# 也就是说这时**每台客机的本小游戏节点都已经在树上了**，RPC 一定收得到。
+# 房主把自己那份 `_mp8_layout_live` 逐张广播出去，各机本地摆自己的家当。
+#
+# 复用既有的 `mp8_gun_move_rpc` —— 手调模式已经验证过它能一次挪动一整组
+# （工位标记 + 空桌 + 教程高亮框 + 工作台实体），而且是绝对坐标、可重复调用。
+#
+# ⚠️ 先快照再发：`mp8_gun_move_rpc` 是 `call_local`，`.rpc()` 当场就会回改
+# `_mp8_layout_live[slot]`，边遍历边改自己会踩到。
+# ⚠️ 这条**不替代**把定稿烘进 `MP8_LAYOUT_RING`（上面已烘）：广播治的是
+# "两边不一致"，烘常量治的是"没有文件的那一端默认值就该是定稿"。两条都要。
+func _mp8_broadcast_layout() -> void :
+
+	if not multiplayer.is_server():
+		return
+	if GameManager.local_game:
+		return                      # 单机分屏没有客机，也不该发 RPC
+	if _mp8_no_expand or mp8_player_count <= 4:
+		return                      # 场地没扩过，没有新增桌子可广播
+	if _mp8_slots.is_empty():
+		push_warning("[MP8] 枪械工厂：房主这边一个新增工位都没有，布局没广播")
+		return
+
+	var rows: Array = []
+	for r in _mp8_layout_live:
+		rows.append([r[0], float(r[1])])
+
+	var n: int = mini(_mp8_slots.size(), rows.size())
+	for i in n:
+		mp8_gun_move_rpc.rpc(i, rows[i][0], float(rows[i][1]))
+
+	print("[MP8] 枪械工厂：布局以房主为准广播 %d 张（房主来源=%s）—— %s" % [
+		n, _mp8_layout_src, _mp8_layout_desc()
+	])
+
+
+# [MP8] any_peer + call_local：谁按的键谁发起，8 台机器一起挪。
+# ⚠️ 必须每台机器都挪：空桌和教程高亮框是**各机本地的场景节点**，不走网络同步
+# （和 _mp8_setup_field 每台都要跑是同一个理由）。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_gun_move_rpc(slot: int, pos: Vector3, yaw: float) -> void :
+
+	if slot < 0 or slot >= _mp8_slots.size():
+		# 房主广播过来、本机却没有这个工位 = 本机场地压根没扩（人数读少了 / 打错包）。
+		# 静默丢掉的话，画面上就是"客机比房主少一张桌"，一样是不一致 —— 让它出声。
+		push_warning("[MP8] 枪械工厂：收到第 %d 号工位的布局，但本机只有 %d 个新增工位，丢弃" % [
+			slot + 1, _mp8_slots.size()
+		])
+		return
+
+	_mp8_layout_live[slot] = [Vector3(pos.x, 0.0, pos.z), yaw]
+
+	var rec: Dictionary = _mp8_slots[slot]
+	var marker = rec.get("marker")
+	if marker == null or not is_instance_valid(marker):
+		return
+
+	# 工作台实体是开局后才生成的，第一次要用时按"旧位置最近"认一次，之后一直用这个引用。
+	var ws_node = rec.get("ws")
+	if (ws_node == null or not is_instance_valid(ws_node)) and workstations_node_parent != null:
+		ws_node = _mp8_nearest_child(workstations_node_parent, (marker as Node3D).global_position)
+		rec["ws"] = ws_node
+
+	# 工位标记的**局部** rotation_degrees 才是 spawn_workstations() 读的那个值
+	# （它读 c.global_position + c.rotation_degrees），所以这里跟建的时候写法保持一致。
+	(marker as Node3D).global_position = Vector3(pos.x, (marker as Node3D).global_position.y, pos.z)
+	(marker as Node3D).rotation_degrees = Vector3(0.0, yaw, 0.0)
+
+	for k in ["desk", "box"]:
+		_mp8_place_at(rec.get(k), pos, yaw)
+	_mp8_place_at(ws_node, pos, yaw)
+
+	_mp8_edit_refresh()
+
+
+# 搬一件家当：只改水平位置和偏航，**保留它自己的 y**
+# （空桌在 -0.117、高亮框在 +1.9，这些组内高度差不能动）。
+func _mp8_place_at(n, pos: Vector3, yaw: float) -> void :
+	if n == null or not is_instance_valid(n) or not (n is Node3D):
+		return
+	var n3: Node3D = n
+	n3.global_position = Vector3(pos.x, n3.global_position.y, pos.z)
+	n3.global_rotation_degrees = Vector3(0.0, yaw, 0.0)
+
+
+# 全部 8 个工位的水平位置（原版 4 个在前、新增的在后，和 WorkstationSpawns 子节点同序）
+func _mp8_desk_points() -> Array[Vector3] :
+	var out: Array[Vector3] = []
+	var ws: Node3D = get_node_or_null("WorkstationSpawns") as Node3D
+	if ws == null:
+		return out
+	for c in ws.get_children():
+		if c is Node3D:
+			out.append((c as Node3D).global_position)
+	return out
+
+
+# 离第 i 个工位最近的另一个工位有多远（世界水平距离）
+func _mp8_nearest_gap(pts: Array[Vector3], i: int) -> float :
+	var best: float = INF
+	for j in pts.size():
+		if j == i:
+			continue
+		best = minf(best, _mp8_flat(pts[i], pts[j]))
+	return best
+
+
+# [MP8] 坑第 25 条的判据：摆位好不好，要看**屏幕投影**，不是地上放不放得下。
+#
+# 返回 [全部 8 张的屏幕最小间距, 原版 4 张的屏幕最小间距]。
+# ⚠️ 及格线**不写死 0.334**，而是拿原版那 4 张在**同一块屏幕、同一帧**算出来的值当基准
+# —— 分辨率、宽高比、fov 全都自动抵消掉，这才是"以原版为校准基准"的正确做法。
+func _mp8_screen_gaps() -> Array :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	var pts: Array[Vector3] = _mp8_desk_points()
+	if cam == null or pts.size() < 2:
+		return [-1.0, -1.0]
+
+	var size: Vector2 = get_viewport().get_visible_rect().size
+	if size.x <= 0.0 or size.y <= 0.0:
+		return [-1.0, -1.0]
+
+	var ndc: Array[Vector2] = []
+	var ok: Array[bool] = []
+	for p in pts:
+		if cam.is_position_behind(p):
+			ndc.append(Vector2.ZERO)
+			ok.append(false)
+			continue
+		var s: Vector2 = cam.unproject_position(p)
+		ndc.append(Vector2(s.x / size.x * 2.0 - 1.0, s.y / size.y * 2.0 - 1.0))
+		ok.append(true)
+
+	var all_min: float = INF
+	var orig_min: float = INF
+	for i in ndc.size():
+		for j in range(i + 1, ndc.size()):
+			if not (ok[i] and ok[j]):
+				continue
+			var d: float = ndc[i].distance_to(ndc[j])
+			all_min = minf(all_min, d)
+			if i < 4 and j < 4:
+				orig_min = minf(orig_min, d)
+
+	return [
+		(-1.0 if is_inf(all_min) else all_min),
+		(-1.0 if is_inf(orig_min) else orig_min),
+	]
+
+
+func _mp8_edit_refresh() -> void :
+
+	for i in _mp8_slots.size():
+		var tag = (_mp8_slots[i] as Dictionary).get("tag")
+		if tag == null or not is_instance_valid(tag):
+			continue
+		var sel: bool = (i == _mp8_edit_sel)
+		(tag as Label3D).text = ("▼ %d ▼" % (i + 1)) if sel else str(i + 1)
+		(tag as Label3D).modulate = (Color(1.0, 0.85, 0.2) if sel else Color(0.55, 0.75, 0.85))
+
+	if _mp8_edit_panel == null:
+		return
+
+	var cur: Vector3 = _mp8_layout_live[_mp8_edit_sel][0]
+	var yaw: float = float(_mp8_layout_live[_mp8_edit_sel][1])
+	var pts: Array[Vector3] = _mp8_desk_points()
+	var gap: float = (_mp8_nearest_gap(pts, 4 + _mp8_edit_sel) if pts.size() > 4 + _mp8_edit_sel else -1.0)
+	var sg: Array = _mp8_screen_gaps()
+
+	var gap_txt: String = "—"
+	if gap >= 0.0:
+		gap_txt = "%.2f 米 %s" % [gap, ("✓" if gap >= MP8_MIN_DESK_GAP else "⚠ 低于 %.1f" % MP8_MIN_DESK_GAP)]
+
+	var scr_txt: String = "—"
+	if sg[0] >= 0.0 and sg[1] >= 0.0:
+		scr_txt = "%.3f（原版 4 张 %.3f）%s" % [
+			sg[0], sg[1], ("✓" if sg[0] >= sg[1] * 0.75 else "⚠ 会挤在一起")
+		]
+
+	_mp8_edit_panel.text = "\n".join([
+		"【桌位手调】选中第 %d 张新桌   步长 %.1f 米   来源 %s" % [
+			_mp8_edit_sel + 1, MP8_EDIT_STEPS[_mp8_edit_step_i], _mp8_layout_src],
+		"位置 x=%.2f  z=%.2f   转角 %.0f°" % [cur.x, cur.z, yaw],
+		"离最近的桌子 %s      屏幕最小间距 %s" % [gap_txt, scr_txt],
+		"1~4 选桌   I/K 远近   J/L 左右   U/O 转   5 步长   0 存盘   9 复位   8 打报告",
+	])
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 出生点跟着工位走（2026-08-16 用户手摆完桌子后补的）
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 原版的规则，是从 probe32 量出来的**事实**，不是设计出来的：
+#
+#   | 原版 | 工位 | 出生点 | 距离 | 出生点 yaw |
+#   | 1 | (-7.04,-7.59) | (-4.52,-5.15) | 3.51 | 90°  |
+#   | 2 | (-7.54,+7.53) | (-4.52,+5.33) | 3.73 | 90°  |
+#   | 3 | (+11.10,+8.38)| (+7.50,+8.00) | 3.62 | -90° |
+#   | 4 | (+10.39,-8.17)| (+6.97,-8.00) | 3.43 | -90° |
+#
+#   ① 出生点**逐个对齐自己的工位**（下标 i ↔ 下标 i），距离 3.4~3.7 米
+#   ② 站在工位**朝场地中心的那一侧**（四张桌都在角上，开阔面朝里）
+#   ③ **脸朝着自己那张桌子**（yaw 全部对得上）
+#
+# 之前那版没做这个，5~8 号走 network_manager 的通用补位（四条边的中点），
+# 结果 P3 要跑 11.7 米才到自己桌子，而原版是 3.4~3.7。
+#
+# ⚠️ **上一轮试过"让出生点跟工位一起平移"，实测有 2 个落进实体**
+# （(-1.32,-5.15) 在中央料台的道具里、(-1.32,+5.33) 直接在料台碰撞盒里）。
+# 所以这次**不硬算偏移，而是搜索 + 物理实测**：绕着桌子转一圈找一个真站得下的地方。
+#
+# **只动新增的 4 个出生点**，原版那 4 个一个字节不碰 —— 它们本来就是对的，
+# 而且它们还要当"判据校准基准"用（见 _mp8_calibrate_spot_test）。
+func _mp8_place_spawns() -> void :
+
+	if _mp8_no_expand or mp8_player_count <= 4 or _mp8_slots.is_empty():
+		return
+
+	var sp: Node3D = get_node_or_null("SpawnPositions") as Node3D
+	var ws: Node3D = get_node_or_null("WorkstationSpawns") as Node3D
+	if sp == null or ws == null:
+		push_warning("[MP8] 枪械工厂：找不到 SpawnPositions / WorkstationSpawns，出生点没跟工位走")
+		return
+
+	# ⚠️ 物理空间从**场景里的 Node3D** 取，不要用 get_viewport().world_3d ——
+	# 后者在视口没有自己的 World3D 时会返回 null。Node3D.get_world_3d() 拿的
+	# 就是这个节点实际注册进去的那个世界，定义上不会错。
+	_mp8_space = sp.get_world_3d().direct_space_state
+	if _mp8_space == null:
+		push_warning("[MP8] 枪械工厂：拿不到物理空间，出生点退回通用补位（不动它）")
+		return
+
+	# 先拿原版 4 个出生点把"站得下"这个判据校一遍。
+	# 判不通就是判据错了，不是位置错了（probe37 那三轮校准的教训）。
+	var tol: float = _mp8_calibrate_spot_test(sp)
+
+	var desks: Array[Vector3] = _mp8_desk_points()
+	var n_orig: int = desks.size() - _mp8_slots.size()   # 原版工位数（正常是 4）
+	var report := PackedStringArray()
+
+	for i in range(n_orig, desks.size()):
+
+		# 对应的出生点节点：不够就自己补（正常情况下 network_manager 的通用补位
+		# 已经把它补到 8 个了，这里只是覆盖位置；补不齐时兜底自己建）
+		var marker: Node3D = null
+		if i < sp.get_child_count():
+			marker = sp.get_child(i) as Node3D
+		if marker == null:
+			marker = Marker3D.new()
+			marker.name = "MP8Spawn%d" % (i - n_orig)
+			sp.add_child(marker)
+
+		var found: Array = _mp8_find_spawn_spot(desks, i, tol)
+		var pos: Vector3 = found[0]
+		var note: String = found[1]
+
