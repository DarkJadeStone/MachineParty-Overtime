+			if not _mp8_clear_of_other_desks(desks, i, cand):
+				continue
+			return [cand, ("正对中心" if k == 0 else "偏 %.0f°" % rad_to_deg(ang))]
+
+	# 一圈都没找着：退回"朝中心 3.5 米"硬摆，并明说这个点没验过。
+	# 宁可站得别扭，也不能少生成一个人（少一个人 = 这一局可能永远结束不了）。
+	var fb := Vector3(here.x + base.x * 3.5, 0.0, here.z + base.y * 3.5)
