+			# （变量别叫 sign —— 那是 GDScript 内置函数名）
+			var side: float = (1.0 if (k % 2) == 0 else -1.0)
+			var ang: float = deg_to_rad(float((k + 1) / 2) * 15.0) * side
+			var d: Vector2 = base.rotated(ang)
+			var cand := Vector3(here.x + d.x * r, 0.0, here.z + d.y * r)
