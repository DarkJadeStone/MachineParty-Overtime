+# [MP8] ================ 玩法改造：扶梯定速下行 + 随时间加速 ================
+#
+# 用户 2026-08-16 定：**"扶梯按一定速度把玩家往搅拌机里带，存活越久扶梯掉得越快，
+# 玩家需要按键越快才能存活。"** —— 小游戏的性格从"追逐赛"改成**耐久生存**。
+#
+# ⚠️ 这条会**顶掉原版的核心规则**：原版 `escalator_speed = 全场最快那个人的 speed`（钳 1.0），
+# 也就是"领先者把整条扶梯拉快、拖累所有人（含自己）"的橡皮筋设计。
+# 新玩法里扶梯**不看任何人**，只看本局已经打了多久：
+#
+#     扶梯速度 = min(起始速度 + 每秒增量 × 本局已进行秒数, 上限)
+#
+# 玩家净位移仍是 `(自己的 speed − 扶梯速度) × 0.5 × delta`，所以：
+#   - 开局扶梯就在往下带（起始速度 > 0），不按键必然掉下去；
+#   - 时间一长扶梯超过玩家速度上限（2.0），**谁都撑不住** → 局必然收敛，不会无限打下去。
+#
+# 原版规则保留成对照组：`mp8escmode=vanilla`。
+const MP8_BELT_BASE_DEFAULT: float = 0.35   ## 开局扶梯速度
+const MP8_BELT_RAMP_DEFAULT: float = 0.03   ## 每秒增加多少
+const MP8_BELT_CAP_DEFAULT: float = 2.0     ## 上限（= 玩家 speed 的上限，到顶就是谁都跟不上）
+
+# [MP8] ===== 名次制算分：**存活顺序**（用户 2026-08-16 定）=====
+#
+# 原版是累加型：到顶第一名 +2、其余 +1；每有人掉下去，还活着的每人 +1；最后剩一人再 +1。
+# 8 人下它是坏的：**苟活收益最高 +8，冲第一只有 +2**，而且一到顶就退出 active 列表、
+# 之后别人再掉一分都拿不到 —— 「吊在半空等别人掉光」是压倒性最优解（人越多越离谱）。
+#
+# 新玩法是耐久生存，**存活时长天然就是名次**，所以直接拿小游戏自己的顺序数组当名次源
+# （`_mp8_dead_order` / `active_players` / `finished_players`），不在汇总处对整数计数排名
+# —— 这是项目的分数铁律，和猎鸭那套（T13）同一个路子。
+#
+# 排名从差到好：**先掉下去的最差 → 后掉下去的 → 活到最后的 → 逃到顶的（第一个到顶最好）**
+# 分数 = 步长 × 名次下标，第一个死的 0 分。8 人局正好铺满 {0,2,4,…,14}，不重不漏。
+#
+# 步长沿用猎鸭的 2：不是本局需要半分，而是**为了和名次型小游戏的量级对齐**
+# （名次型 8 人局大致 0~12~14）。真要调量级请用 `game.gd` 的 MP8_MINIGAME_SCORE_SCALE，
+# 别在这里改步长。
+const MP8_ESC_RANK_STEP: int = 2
+
+var _mp8_dead_order: Array[int] = []    # 掉进搅拌机的先后顺序（网络 id），本局的名次源
+
+var _mp8_survival: bool = true          # false = 回原版"最快的人带动扶梯"
+var _mp8_belt_base: float = MP8_BELT_BASE_DEFAULT
+var _mp8_belt_ramp: float = MP8_BELT_RAMP_DEFAULT
+var _mp8_belt_cap: float = MP8_BELT_CAP_DEFAULT
+var _mp8_belt_elapsed: float = 0.0      # 本局 Play 开始后的秒数
+var _mp8_belt_running: bool = false     # 倒计时结束才开始加速
+var _mp8_belt_log_t: float = 0.0
+var _mp8_info_on: bool = false          # mp8escinfo：屏幕上显示扶梯速度，调参用
+var _mp8_info_label: Label = null
+
+var _mp8_edit_on: bool = false
+var _mp8_edit_sel: int = 0
+var _mp8_edit_step_i: int = 1
+var _mp8_edit_items: Array = []          # [{ "node": Node3D, "src": String }]，8 台机器顺序一致
+var _mp8_edit_panel: Label = null
+var _mp8_edit_canvas: CanvasLayer = null
+var _mp8_edit_src: String = "自动布局"
+
+
+# 把可手调的件收进注册表：先原件，再它的副本（`_MP8L` / `_MP8R`）。
+# 顺序在每台机器上都一样（同一份场景 + 同一段代码），所以下标可以直接当 RPC 参数用。
+func _mp8_edit_collect() -> void :
+
+	_mp8_edit_items.clear()
+	var art: Node3D = get_node_or_null("escalator pit art11") as Node3D
+	if art == null:
+		return
+
+	for src_name in MP8_EDIT_SOURCES:
+		for c in art.get_children():
+			if not (c is Node3D):
+				continue
+			var nm := String(c.name)
+			if nm == src_name or nm == src_name + "_MP8L" or nm == src_name + "_MP8R" \
+					or nm.begins_with(src_name + "_MP8X"):
+				_mp8_edit_items.append({"node": c, "src": src_name})
+
+
+# 读存盘文件并按它摆。文件在 = 文件说了算（多的行建副本，少的行把多余的藏掉）。
+func _mp8_apply_layout_file() -> void :
+
+	var rows := _mp8_parse_layout_file()
+	if rows.is_empty():
+		# 没有存盘文件 → 用烘进代码的定稿摆位（发布版走的就是这条）
+		rows = []
+		for r in MP8_LAYOUT_BAKED:
+			rows.append({
+				"src": String(r[0]), "pos": r[1], "yaw": float(r[2]),
+				"sx": float(r[3]), "vis": bool(r[4]),
+			})
+		_mp8_edit_src = "内置定稿表 MP8_LAYOUT_BAKED"
+	else:
+		_mp8_edit_src = "存盘文件 %s" % MP8_EDIT_FILE
+	if rows.is_empty():
+		return
+
+	var art: Node3D = get_node_or_null("escalator pit art11") as Node3D
+	if art == null:
+		return
+
+	# 按源件分组，逐组对齐：第 n 行 → 该组第 n 个实例，不够就复制一份
+	for src_name in MP8_EDIT_SOURCES:
+		var mine: Array = []
+		for it in _mp8_edit_items:
+			if String(it["src"]) == src_name:
+				mine.append(it["node"])
+
+		var want: Array = []
+		for r in rows:
+			if String(r["src"]) == src_name:
+				want.append(r)
+		if want.is_empty():
+			continue
+
+		var proto: Node3D = mine[0] if not mine.is_empty() else null
+		if proto == null:
+			push_warning("[MP8] 逆向行进：布局文件里的 '%s' 场景里没有，跳过" % src_name)
+			continue
+
+		var extra: int = 0
+		while mine.size() < want.size():
+			var m := proto as MeshInstance3D
+			if m == null:
+				break
+			extra += 1
+			var dup := _mp8_clone_mesh(m, Vector3.ZERO)
+			dup.name = "%s_MP8X%d" % [src_name, extra]
+			mine.append(dup)
+			_mp8_edit_items.append({"node": dup, "src": src_name})
+
+		for i in mine.size():
+			var n: Node3D = mine[i]
+			if i >= want.size():
+				n.visible = false                 # 文件里没写的多余副本：藏起来
+				continue
+			var r: Dictionary = want[i]
+			n.position = r["pos"]
+			n.rotation = Vector3(n.rotation.x, deg_to_rad(float(r["yaw"])), n.rotation.z)
+			n.scale.x = float(r["sx"])
+			n.visible = bool(r["vis"])
+
+	print("[MP8] 逆向行进：按手调布局摆好了（%d 件，来源：%s）" % [rows.size(), _mp8_edit_src])
+
+
+# 文件格式：`源件名, x, y, z, 转角度数, x缩放, 显示(1/0)`，`#` 开头是注释。
+# 一行 = 场景里的一份实例；想多加一条扶手，复制一行改 x 即可。
+func _mp8_parse_layout_file() -> Array :
+
+	if not FileAccess.file_exists(MP8_EDIT_FILE):
+		return []
+
+	var f := FileAccess.open(MP8_EDIT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] 逆向行进：打不开 %s（%d）" % [MP8_EDIT_FILE, FileAccess.get_open_error()])
+		return []
+
+	var rows: Array = []
+	var line_no: int = 0
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		line_no += 1
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var cols: PackedStringArray = line.split(",", false)
+		if cols.size() < 7:
+			push_warning("[MP8] 逆向行进：布局文件第 %d 行不是 7 列，跳过：%s" % [line_no, line])
+			continue
+		var src_name: String = cols[0].strip_edges()
+		if not MP8_EDIT_SOURCES.has(src_name):
+			push_warning("[MP8] 逆向行进：布局文件第 %d 行的件名 '%s' 不认识，跳过" % [line_no, src_name])
+			continue
+		rows.append({
+			"src": src_name,
+			"pos": Vector3(float(cols[1]), float(cols[2]), float(cols[3])),
+			"yaw": float(cols[4]),
+			"sx": float(cols[5]),
+			"vis": int(cols[6]) != 0,
+		})
+	f.close()
+	return rows
+
+
+func _mp8_save_layout_file() -> bool :
+
+	var f := FileAccess.open(MP8_EDIT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] 逆向行进：写不了 %s（%d）" % [MP8_EDIT_FILE, FileAccess.get_open_error()])
+		return false
+
+	f.store_line("# 逆向行进（mp8game=2）8 人场地手调 —— 铁皮与扶手的摆位")
+	f.store_line("# 每行 = 一份实例：源件名, x, y, z, 转角度数, x缩放, 显示(1/0)")
+	f.store_line("# 想多加一条扶手：把某行复制一份、改 x 即可（游戏会自动多建一份）。")
+	f.store_line("# 想去掉一条：把最后一列改成 0，或者直接删掉那一行。")
+	f.store_line("# 删掉整个文件 = 回到代码里的自动布局。")
+	f.store_line("# 存于 %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+
+	for it in _mp8_edit_items:
+		var n: Node3D = it["node"]
+		if not is_instance_valid(n):
+			continue
+		f.store_line("%s, %.3f, %.3f, %.3f, %.0f, %.3f, %d" % [
+			String(it["src"]), n.position.x, n.position.y, n.position.z,
+			rad_to_deg(n.rotation.y), n.scale.x, (1 if n.visible else 0)])
+	f.close()
+
+	print("[MP8] 逆向行进：布局已存盘 → %s（%d 件）" % [
+		ProjectSettings.globalize_path(MP8_EDIT_FILE), _mp8_edit_items.size()])
+	return true
+
+
+# 摆位广播：8 个窗口一起动，免得"只有我这台看着对"。
+@rpc("any_peer", "call_local", "reliable")
+func mp8_esc_place_rpc(idx: int, pos: Vector3, yaw_deg: float, sx: float, vis: bool) -> void :
+
+	if idx < 0 or idx >= _mp8_edit_items.size():
+		return
+	var n: Node3D = _mp8_edit_items[idx]["node"]
+	if not is_instance_valid(n):
+		return
+	n.position = pos
+	n.rotation = Vector3(n.rotation.x, deg_to_rad(yaw_deg), n.rotation.z)
+	n.scale.x = sx
+	n.visible = vis
+	if _mp8_edit_on:
+		_mp8_edit_refresh()
+
+
+func _mp8_edit_begin() -> void :
+
+	_mp8_edit_collect()
+	if _mp8_edit_items.is_empty():
+		push_warning("[MP8] 逆向行进：一个可调的件都没找到，手调模式不启动")
+		_mp8_edit_on = false
+		return
+
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+
+	var lbl := Label.new()
+	lbl.name = "MP8EscEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -200.0
+	lbl.offset_right = 1100.0
+	lbl.offset_bottom = -8.0
+	# ⚠️ 必须显式指定游戏自己的字体：默认主题字体字距是坏的（枪械工厂/猎鸭都栽过）
+	var font = load("res://fonts/Terminal F4.ttf")
+	if font != null:
+		lbl.add_theme_font_override("font", font)
+	lbl.add_theme_color_override("font_color", Color(0.6, 0.95, 1.0))
+	_mp8_edit_canvas.add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	# 每个件头顶挂号码牌，否则十几个件里根本认不出在调哪个
+	for i in _mp8_edit_items.size():
+		var n: Node3D = _mp8_edit_items[i]["node"]
+		if not is_instance_valid(n):
+			continue
+		var tag := Label3D.new()
+		tag.name = "MP8EditTag"
+		tag.text = "%d" % (i + 1)
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 200
+		tag.outline_size = 40
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true
+		if font != null:
+			tag.font = font
+		n.add_child(tag)
+		tag.position = Vector3(0.0, 6.0, 0.0)
+
+	_mp8_edit_check_keys()
+	_mp8_edit_refresh()
+	print("[MP8] 逆向行进：场地手调已开 —— %d 个件可调，布局来源：%s" % [
+		_mp8_edit_items.size(), _mp8_edit_src])
+
+
+# 按键撞车自检（照枪械工厂的规矩：别赌按键没被占，开局把 InputMap 查一遍）
+func _mp8_edit_check_keys() -> void :
+
+	var mine: Dictionary = {
+		KEY_6: "上一件", KEY_7: "下一件", KEY_4: "复制", KEY_3: "藏/显",
+		KEY_I: "推远", KEY_K: "拉近", KEY_J: "左移", KEY_L: "右移",
+		KEY_U: "升高", KEY_O: "降低", KEY_N: "左转", KEY_M: "右转",
+		KEY_Y: "加宽", KEY_H: "收窄",
+		KEY_5: "步长", KEY_0: "存盘", KEY_9: "复位", KEY_8: "打报告",
+	}
+	var clash := PackedStringArray()
+	for action in InputMap.get_actions():
+		for ev in InputMap.action_get_events(action):
+			var k := ev as InputEventKey
+			if k == null:
+				continue
+			for code in [k.keycode, k.physical_keycode]:
+				if code != 0 and mine.has(code):
+					clash.append("%s(%s)↔%s" % [OS.get_keycode_string(code), mine[code], String(action)])
+	if clash.is_empty():
+		print("[MP8] 逆向行进：手调按键与游戏 InputMap 无冲突（查了 %d 个动作）" % InputMap.get_actions().size())
+	else:
+		print("[MP8] 逆向行进：⚠️ 手调按键撞车 —— %s" % ", ".join(clash))
+
+
+func _mp8_edit_refresh() -> void :
+
+	if _mp8_edit_panel == null or _mp8_edit_items.is_empty():
+		return
+	_mp8_edit_sel = clampi(_mp8_edit_sel, 0, _mp8_edit_items.size() - 1)
+	var it: Dictionary = _mp8_edit_items[_mp8_edit_sel]
+	var n: Node3D = it["node"]
+	if not is_instance_valid(n):
+		return
+
+	_mp8_edit_panel.text = "\n".join([
+		"【场地手调】%d/%d  %s%s   步长 %.1f 米" % [
+			_mp8_edit_sel + 1, _mp8_edit_items.size(), String(n.name),
+			"" if n.visible else "（已藏）", MP8_EDIT_STEPS[_mp8_edit_step_i]],
+		"位置 (%.2f, %.2f, %.2f)   转角 %.0f°   x缩放 %.2f" % [
+			n.position.x, n.position.y, n.position.z, rad_to_deg(n.rotation.y), n.scale.x],
+		"6/7 选件   I/K 前后  J/L 左右  U/O 升降   N/M 转   Y/H 宽窄",
+		"4 复制一份   3 藏/显   5 换步长   0 存盘   9 复位   8 打报告",
+	])
+
+
+func _mp8_edit_report() -> void :
+	print("[MP8] 逆向行进：当前 %d 个件 ——" % _mp8_edit_items.size())
+	for i in _mp8_edit_items.size():
+		var n: Node3D = _mp8_edit_items[i]["node"]
+		if not is_instance_valid(n):
+			continue
+		print("   %2d  %-24s pos=(%8.2f,%7.2f,%8.2f) yaw=%4.0f° sx=%.2f %s" % [
+			i + 1, n.name, n.position.x, n.position.y, n.position.z,
+			rad_to_deg(n.rotation.y), n.scale.x, "" if n.visible else "（已藏）"])
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or _mp8_edit_items.is_empty():
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+	var n: Node3D = _mp8_edit_items[_mp8_edit_sel]["node"]
+	if not is_instance_valid(n):
+		return
+
+	var pos: Vector3 = n.position
+	var yaw: float = rad_to_deg(n.rotation.y)
+	var sx: float = n.scale.x
+	var vis: bool = n.visible
+	var changed: bool = false
+
+	match key.keycode:
+		KEY_6, KEY_7:
+			var d: int = -1 if key.keycode == KEY_6 else 1
+			_mp8_edit_sel = posmod(_mp8_edit_sel + d, _mp8_edit_items.size())
+			_mp8_edit_refresh()
+
+		KEY_J, KEY_L:
+			pos.x += (- step if key.keycode == KEY_J else step)
+			changed = true
+		KEY_I, KEY_K:
+			pos.z += (- step if key.keycode == KEY_I else step)
+			changed = true
+		KEY_U, KEY_O:
+			pos.y += (step if key.keycode == KEY_U else - step)
+			changed = true
+		KEY_N, KEY_M:
+			yaw = fposmod(yaw + (- MP8_EDIT_YAW_STEP if key.keycode == KEY_N else MP8_EDIT_YAW_STEP), 360.0)
+			changed = true
+		KEY_Y, KEY_H:
+			sx = maxf(0.05, sx + (MP8_EDIT_SCALE_STEP if key.keycode == KEY_Y else - MP8_EDIT_SCALE_STEP))
+			changed = true
+		KEY_3:
+			vis = not vis
+			changed = true
+
+		KEY_4:
+			# 复制一份：新件落在原件右边一个步长处，方便立刻看见
+			mp8_esc_dup_rpc.rpc(_mp8_edit_sel)
+
+		KEY_5:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_0:
+			var ok: bool = _mp8_save_layout_file()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("【已存盘】下次开局自动用这套摆位\n" if ok
+					else "【存盘失败】看日志\n") + _mp8_edit_panel.text
+
+		KEY_9:
+			print("[MP8] 逆向行进：想回自动布局请删掉 %s 再重开一局" %
+				ProjectSettings.globalize_path(MP8_EDIT_FILE))
+
+		KEY_8:
+			_mp8_edit_report()
+
+		_:
+			return
+
+	if changed:
+		mp8_esc_place_rpc.rpc(_mp8_edit_sel, pos, yaw, sx, vis)
+
+	get_viewport().set_input_as_handled()
+
+
+# 复制一份当前件（8 台机器一起建，否则下标就对不上了）
+@rpc("any_peer", "call_local", "reliable")
+func mp8_esc_dup_rpc(idx: int) -> void :
+
+	if idx < 0 or idx >= _mp8_edit_items.size():
+		return
+	var src: MeshInstance3D = _mp8_edit_items[idx]["node"] as MeshInstance3D
+	if src == null:
+		return
+
+	var dup := _mp8_clone_mesh(src, Vector3.ZERO)
+	dup.name = "%s_MP8X%d" % [String(_mp8_edit_items[idx]["src"]), _mp8_edit_items.size()]
+	dup.position.x += MP8_EDIT_STEPS[_mp8_edit_step_i]
+	_mp8_edit_items.append({"node": dup, "src": String(_mp8_edit_items[idx]["src"])})
+
+	if _mp8_edit_on:
+		var tag := Label3D.new()
+		tag.text = "%d" % _mp8_edit_items.size()
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 200
+		tag.outline_size = 40
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true
+		var font = load("res://fonts/Terminal F4.ttf")
+		if font != null:
+			tag.font = font
+		dup.add_child(tag)
+		tag.position = Vector3(0.0, 6.0, 0.0)
+		_mp8_edit_sel = _mp8_edit_items.size() - 1
+		_mp8_edit_refresh()
+
+	print("[MP8] 逆向行进：复制了 %s → 现在共 %d 个件" % [src.name, _mp8_edit_items.size()])
+
+
+# ---------------- 8. 生存玩法：扶梯速度 ----------------
+# 扶梯速度 = min(起始 + 每秒增量 × Play 开始后的秒数, 上限)。
+# **倒计时结束（进 Play）才开始计时**，赛前站桩那段不该把难度先耗掉。
+func _mp8_belt_speed(delta: float) -> float :
+
+	if not _mp8_belt_running:
+		return 0.0
+
+	_mp8_belt_elapsed += delta
+	var belt: float = minf(_mp8_belt_base + _mp8_belt_ramp * _mp8_belt_elapsed, _mp8_belt_cap)
+
+	# 每秒打一行：调参时要能看出"第几秒开始有人跟不上"
+	_mp8_belt_log_t += delta
+	if _mp8_belt_log_t >= 1.0:
+		_mp8_belt_log_t = 0.0
+		var fastest: float = 0.0
+		for p in player_characters.values():
+			if p.speed > fastest:
+				fastest = p.speed
+		print("[MP8] 逆向行进：%5.1f 秒  扶梯 %.2f  最快玩家 %.2f  还活着 %d 人%s" % [
+			_mp8_belt_elapsed, belt, fastest, active_players.size(),
+			"   ← 扶梯已封顶，谁都跟不上了" if belt >= _mp8_belt_cap - 0.001 else ""])
+
+	_mp8_belt_info(belt)
+	return belt
+
+
+# mp8escinfo：屏幕左上角显示扶梯速度 / 已进行时间 / 最快玩家，纯调参用（默认关）
+func _mp8_belt_info(belt: float) -> void :
+
+	if not _mp8_info_on:
+		return
+
+	if _mp8_info_label == null:
+		if _mp8_edit_canvas == null:
+			_mp8_edit_canvas = CanvasLayer.new()
+			_mp8_edit_canvas.layer = 100
+			add_child(_mp8_edit_canvas)
+		var lbl := Label.new()
+		lbl.name = "MP8EscInfo"
+		lbl.set_anchors_preset(Control.PRESET_TOP_LEFT)
+		lbl.offset_left = 16.0
+		lbl.offset_top = 16.0
+		lbl.offset_right = 700.0
+		lbl.offset_bottom = 100.0
+		var font = load("res://fonts/Terminal F4.ttf")
+		if font != null:
+			lbl.add_theme_font_override("font", font)
+		lbl.add_theme_color_override("font_color", Color(1.0, 0.85, 0.3))
+		_mp8_edit_canvas.add_child(lbl)
+		_mp8_info_label = lbl
+
+	var fastest: float = 0.0
+	for p in player_characters.values():
+		if p.speed > fastest:
+			fastest = p.speed
+	_mp8_info_label.text = "扶梯 %.2f   %.1f 秒   最快玩家 %.2f   活 %d" % [
+		belt, _mp8_belt_elapsed, fastest, active_players.size()]
+
+
+# ---------------- 公用：坐标系换算 ----------------
+# [MP8] ⚠️⚠️ 把"世界里往 x 走 dist 米"换算成**父节点局部坐标里的位移**。
+#
+# 这是 v3 第一版"4 个人掉进黑虚空"的真凶（2026-08-16 实测定位）：
+# `light parent` 在场景里带 **-135.7° 的 Y 旋转**（probe31 从原装 PCK 量的），
+# 而 `position` 是父节点局部坐标。写成 `od.position = o.position + Vector3(120,0,0)`
+# 等于沿它**转过的** x 轴走 —— 4 盏点光源被甩到世界 (-86, 0, +84) 那边，
+# 第二份场地一盏灯都没有。而本场景 `ambient_light_source` = 背景色 (0,0,0)、
+# 两盏 DirectionalLight3D 的 `visible = false` —— **没灯就是纯黑虚空**，
+# 几何体 / 履带 / 出生点 / 相机全对也没用（probe29 + probe30 + probe31 三张表钉死的）。
+#
+# 判据：写任何 `dup.position = src.position + 偏移` 之前，先问一句
+# **"这个父节点的 basis 是单位阵吗"**。本场景里不是单位阵的有三个：
+# `light parent`（转 -135.7°）、`sequence_label_scene_parent`（缩 0.818）、
+# `CameraTarget`（转 -43.7°/26.8°，但它的 position 在根空间里，不受影响）。
+#
+# ⚠️ 不能用 `global_transform` 算：本函数在根的 `_enter_tree()` 里跑，
+# 那时子节点还没进树，全局变换不可靠 —— 所以逐级累乘**局部** basis。
+# ⚠️ 形参是 `Node` 不是 `Node3D`：`Minigame` 并非 Node3D 的子类，
+# 写成 Node3D 会让 `_mp8_local_delta(self)` 在**加载期**就 Parse Error ——
+# 而 gdre 的"编译通过"查不出这种类型错，游戏里的表现是**全屏纯黑**（脚本整个没加载）。
+func _mp8_local_delta(node: Node, world_delta: Vector3) -> Vector3 :
+
+	if node == null or node == self:
+		return world_delta
+
+	var b := Basis.IDENTITY
+	var cur: Node = node
+	while cur != null and cur != self:
+		if cur is Node3D:
