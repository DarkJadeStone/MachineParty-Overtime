+# [MP8] 结算日志。纯为事后核对 —— 配合「验收口径」把 ② 的判据降级成
+# "真人玩到时顺手瞄一眼"。只在服务器侧跑（check_game_end 本来就是服务器调的）。
+#
+# 当前算分（2026-08-17 定案后）：
+#   第 i 个死的拿 i 分（**同一趟车里死的人仍分先后，用户定案保持原版不动**）
+#   幸存者拿 dead_players.size() + 1（只堵掉线洞，断层保留）
+#
+# ⚠️ 掉线人数是推出来的：开局人数 − 阵亡 − 幸存。用它核对冠军分对不对。
+func _mp8_log_scores() -> void :
+
+	var rows := PackedStringArray()
+
+	for i in dead_players.size():
+		var id: int = dead_players[i]
+		rows.append("第%d个死 %s %d分" % [i + 1, _mp8_name(id), i])
+
+	var survivors: int = 0
+	for network_id in active_players.keys():
+		rows.append("幸存 %s %d分" % [_mp8_name(network_id), dead_players.size() + 1])
+		survivors += 1
+		break
+
+	print("[MP8] 隧道险境结算（开局 %d 人 / %d 人阵亡 / 推算掉线 %d 人）：%s" % [
+		player_count, dead_players.size(),
+		maxi(player_count - dead_players.size() - survivors, 0),
+		" | ".join(rows)
+	])
+
+
