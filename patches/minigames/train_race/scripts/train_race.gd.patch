+# [MP8] 出生点 4 → 8：按列等分插入。原版那 4 个一个字节不动。
+func _mp8_expand_spawns() -> void :
+
+	var args := Array(OS.get_cmdline_args())
+	mp8_player_count = PlayerManager.player_presences.size()
+
+	if player_spawn_positions_node == null:
+		push_warning("[MP8] 隧道险境：没有出生点容器，8 席不做")
+		return
+
+	var originals: Array = []
+	for child in player_spawn_positions_node.get_children():
+		if child is Node3D:
+			originals.append(child)
+
+	var n: int = originals.size()
+	if n == 0:
+		push_warning("[MP8] 隧道险境：出生点容器是空的，8 席不做")
+		return
+
+	if args.has("mp8noexpand"):
+		print("[MP8] 隧道险境：mp8noexpand，出生点一个字不改（纯原版对照组，⚠️ 必须配 4 人）")
+		return
+
+	# ⚠️ ≤4 人一律不动。本局 spawn_players() 是 **shuffle 后按下标取**的，
+	# 多补的点会被 4 人局抽中 —— 补了就不再"与原版逐值一致"。
+	# （致命反弹/立足之本同样是 shuffle，立足之本就是这么把关的。）
+	if mp8_player_count <= 4:
+		print("[MP8] 隧道险境：%d 人，用原版 %d 个出生点，一个字不改" % [mp8_player_count, n])
+		return
+
+	var want: int = mini(maxi(mp8_player_count, 5), MP8_MAX_PLAYERS)
+	if n >= want:
+		print("[MP8] 隧道险境：出生点已有 %d 个（要 %d），不用补" % [n, want])
+		return
+
+	# 按 x 正负分两列（原版就是左右各两个）
+	var columns: Dictionary = {"left": [], "right": []}
+	for m in originals:
+		if m.position.x < 0.0:
+			columns["left"].append(m)
+		else:
+			columns["right"].append(m)
+
+	# 每列按 z 排序，便于在端点之间插值
+	for key in columns.keys():
+		columns[key].sort_custom(func(a, b): return a.position.z < b.position.z)
+
+	var need: int = want - n
+	var added: Array = []
+
+	# 需要的点在两列之间轮流分配，保证左右对称
+	var order: Array = ["left", "right"]
+	var per_column: Dictionary = {"left": 0, "right": 0}
+	for j in need:
+		per_column[order[j % order.size()]] += 1
+
+	for key in order:
+
+		var col: Array = columns[key]
+		var add: int = per_column[key]
+		if add <= 0:
+			continue
+
+		# 一列至少要两个端点才能插值；只有一个就退化成"贴着它排"，
+		# 但原版是 2/2，走不到这条。真走到了就报出来，别静默摆歪。
+		if col.size() < 2:
+			push_warning("[MP8] 隧道险境：%s 列只有 %d 个原版点，插不了值，这一列跳过" % [key, col.size()])
+			continue
+
+		var a: Node3D = col[0]
+		var b: Node3D = col[col.size() - 1]
+
+		for i in add:
+			# t 取 1/(add+1) .. add/(add+1)，把新点均匀铺在两端点之间（含 x 一起 lerp）
+			var t: float = float(i + 1) / float(add + 1)
+			var extra: Node3D = a.duplicate()
+			extra.name = "MP8Spawn_%s_%d" % [key, i]
+			player_spawn_positions_node.add_child(extra)
+			extra.position = a.position.lerp(b.position, t)
+			added.append(extra)
+
+	# 自证：把最小间距算出来打进日志。摆位改动必须能对着数字核，不能只说"摆好了"。
+	var all_points: Array = originals + added
+	var min_gap: float = INF
+	var min_pair: String = ""
+	for i in all_points.size():
+		for j in range(i + 1, all_points.size()):
+			var d: float = all_points[i].position.distance_to(all_points[j].position)
+			if d < min_gap:
+				min_gap = d
+				min_pair = "%s↔%s" % [all_points[i].name, all_points[j].name]
+
+	var parts: Array = []
+	for m in added:
+		parts.append("%s(%.2f,%.2f)" % [m.name, m.position.x, m.position.z])
+
+	print("[MP8] 隧道险境：%d 人 —— 出生点 %d → %d，最小间距 %.2f 米（%s）；新增 %s" % [
+		mp8_player_count, n, all_points.size(), min_gap, min_pair, ", ".join(parts)])
+
+	if min_gap < MP8_MIN_SPAWN_GAP:
+		push_warning("[MP8] 隧道险境：最小间距 %.2f 米 < %.2f，可能有人叠着生成" % [
+			min_gap, MP8_MIN_SPAWN_GAP])
+
+
