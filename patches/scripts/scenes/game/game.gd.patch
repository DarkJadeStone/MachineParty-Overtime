+# --------------------- 输入 ---------------------
+
+# The server owns a generation for one concrete scene/playlist slot/round.
+# Neither a delayed request nor a pending countdown may cross this boundary.
+func _mp8_round_open(identifier: int) -> void :
+	_mp8_round_epoch += 1
+	_mp8_round_identifier = identifier
+	_mp8_round_slot = session_minigame_index
+	_mp8_round_number = session_current_minigame_round
+	_mp8_round_instance = minigame.get_instance_id()
+	_mp8_round_score_snapshot = round_score_by_network_id.duplicate(true)
+	_mp8_round_snapshot_valid = true # An empty dictionary is also a valid snapshot.
+	_mp8_round_active = true
+	_mp8_vote_view_epoch = _mp8_round_epoch
+	_mp8_vote_view_open = true
+	_mp8_round_participants.clear()
+	for id in PlayerManager.player_presences:
+		var presence = PlayerManager.player_presences[id]
+		if is_instance_valid(presence) and not presence.debug_player:
+			_mp8_round_participants[id] = true
+	_mp8_vote_roster_cache = _mp8_vote_roster()
+	_mp8_vote_view_eligible = PackedInt32Array(_mp8_vote_roster_cache.keys())
+	_mp8_vote_view_cooldown = _mp8_vote_cooldown_remaining()
+	print("[MP8-HANDOFF] open epoch=%d id=%d slot=%d round=%d" % [
+		_mp8_round_epoch, identifier, _mp8_round_slot, _mp8_round_number])
+
+
+func _mp8_round_close(reason: String) -> void :
+	if multiplayer.is_server():
+		if _mp8_round_active:
+			print("[MP8-HANDOFF] close epoch=%d reason=%s" % [_mp8_round_epoch, reason])
+			_mp8_round_epoch += 1
+		_mp8_round_active = false
+		_mp8_round_snapshot_valid = false
+	_mp8_vote_view_open = false
+	_mp8_vote_clear()
+
+
+func _mp8_round_matches() -> bool :
+	return _mp8_round_active and _mp8_round_snapshot_valid \
+		and is_instance_valid(minigame) and not minigame.is_queued_for_deletion() \
+		and minigame.get_instance_id() == _mp8_round_instance \
+		and session_current_minigame_round == _mp8_round_number \
+		and session_minigame_index == _mp8_round_slot \
+		and _mp8_round_slot >= 0 and _mp8_round_slot < session_minigame_list.size() \
+		and int(session_minigame_list[_mp8_round_slot]) == _mp8_round_identifier
+
+
+# Called by the session's Finished handler before it increments rounds or scores.
+# Claiming the round closes voting before either normal completion or restart acts.
+func mp8_claim_round_finish(instance_id: int, epoch: int) -> bool :
+	if not multiplayer.is_server() or epoch != _mp8_round_epoch \
+			or instance_id != _mp8_round_instance or not _mp8_round_matches():
+		return false
+	_mp8_round_close("finished")
+	return true
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not (event is InputEventKey):
+		return
+	var k: InputEventKey = event
+	if not k.pressed or k.echo or k.keycode != MP8_VOTE_KEY:
+		return
+
+	get_viewport().set_input_as_handled()
+	_mp8_vote_press()
+
+
+# F5 与 ESC 按钮共用的入口。
+func _mp8_vote_press() -> void :
+
+	if not _mp8_vote_view_open:
+		return
+	var agree: bool = not _mp8_vote_view.has(_mp8_vote_local_id())
+	# 没联机（本地/单人）时直接走本地路径 —— 没有 peer 时 rpc_id 会报错
+	if not multiplayer.has_multiplayer_peer():
+		_mp8_vote_rpc(_mp8_vote_view_epoch, agree)
+	else:
+		_mp8_vote_rpc.rpc_id(get_multiplayer_authority(), _mp8_vote_view_epoch, agree)
+
+
+# --------------------- 服务器侧 ---------------------
+
+@rpc("any_peer", "call_local", "reliable")
+func _mp8_vote_rpc(epoch: int, agree: bool) -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var who: int = multiplayer.get_remote_sender_id()
+	if who == 0:
+		who = multiplayer.get_unique_id()           # 只把本进程明确调用解释成房主
+
+	if epoch != _mp8_round_epoch or not _mp8_round_matches():
+		if _mp8_vote_now_msec() - _mp8_vote_reject_log_ms >= 5000:
+			_mp8_vote_reject_log_ms = _mp8_vote_now_msec()
+			print("[MP8-投票] rejected stale epoch=%d current=%d sender=%d" % [epoch, _mp8_round_epoch, who])
+		if PlayerManager.player_presences.has(who):
+			_mp8_vote_broadcast(int(_mp8_vote_roster().size() / 2) + 1)
+		return
+	var roster: Dictionary = _mp8_vote_roster()
+	if not roster.has(who):
+		return
+
+	if roster.size() < 2:
+		return
+
+	if not agree:
+		if not _mp8_vote_yes.has(who):
+			return
+		_mp8_vote_yes.erase(who)
+		print("[MP8-投票] %d 撤票" % who)
+	else:
+		if _mp8_vote_yes.has(who):
+			return
+		if _mp8_vote_cooldown_remaining() > 0.0:
+			_mp8_vote_broadcast(int(roster.size() / 2) + 1)
+			return
+		var now: int = _mp8_vote_now_msec()
+		if now - int(_mp8_vote_last_agree_ms.get(who, -MP8_VOTE_AGREE_INTERVAL_MS)) < MP8_VOTE_AGREE_INTERVAL_MS:
+			if who == multiplayer.get_unique_id():
+				_mp8_vote_rate_notice_rpc(_mp8_round_epoch)
+			else:
+				_mp8_vote_rate_notice_rpc.rpc_id(who, _mp8_round_epoch)
+			return
+		_mp8_vote_last_agree_ms[who] = now
+		_mp8_vote_yes[who] = true
+		print("[MP8-投票] %d 投票重开本轮" % who)
+
+	_mp8_vote_recount()
+
+
+func _mp8_vote_now_msec() -> int :
+	return Time.get_ticks_msec()
+
+
+func _mp8_vote_cooldown_remaining() -> float :
+	return maxf(0.0, float(_mp8_vote_cooldown_until_ms - _mp8_vote_now_msec()) / 1000.0)
+
+
+func _mp8_vote_roster() -> Dictionary :
+	var roster: Dictionary = {}
+	for id in _mp8_round_participants:
+		var presence = PlayerManager.player_presences.get(id)
+		if is_instance_valid(presence) and not presence.debug_player:
+			roster[id] = true
+	return roster
+
+
+func _mp8_vote_sync_roster() -> bool :
+	var roster: Dictionary = _mp8_vote_roster()
+	var changed: bool = roster != _mp8_vote_roster_cache
+	for id in _mp8_vote_yes.keys():
+		if not roster.has(id):
+			_mp8_vote_yes.erase(id)
+	for id in _mp8_vote_last_agree_ms.keys():
+		if not roster.has(id):
+			_mp8_vote_last_agree_ms.erase(id)
+	if changed:
+		_mp8_vote_roster_cache = roster
+		_mp8_vote_deadline = -1.0 # Any membership change restarts the full confirmation window.
+	return changed
+
+
+@rpc("authority", "call_local", "reliable")
+func _mp8_vote_rate_notice_rpc(epoch: int) -> void :
+	if epoch != _mp8_vote_view_epoch:
+		return
+	_mp8_vote_notice_until_ms = _mp8_vote_now_msec() + MP8_VOTE_AGREE_INTERVAL_MS
+	_mp8_vote_refresh_ui()
+
+
+# 重新点票。掉线的人不该继续占着票 —— 8 人局里一个人掉线就可能让票数当场过半，
+# 那是「人少了」而不是「大家同意了」，必须先把他的票摘掉再算。
+func _mp8_vote_recount() -> void :
+
+	if not multiplayer.is_server():
+		return
+	if not _mp8_round_matches():
+		_mp8_round_close("recount-invalid")
+		return
+
+	_mp8_vote_sync_roster()
+	var n: int = _mp8_vote_roster_cache.size()
+	var yes: int = _mp8_vote_yes.size()
+	var need: int = int(floor(float(n) / 2.0)) + 1      # 过半
+	_mp8_vote_last_need = need
+
+	if n >= 2 and yes >= need and _mp8_vote_cooldown_remaining() <= 0.0:
+		if _mp8_vote_deadline < 0.0:
+			_mp8_vote_deadline = MP8_VOTE_COUNTDOWN
+			print("[MP8-投票] 过半（%d/%d，需 %d）—— %.0f 秒后自动重开本轮" % [yes, n, need, MP8_VOTE_COUNTDOWN])
+	else:
+		if _mp8_vote_deadline >= 0.0:
+			_mp8_vote_deadline = -1.0
+			print("[MP8-投票] 票数跌回 %d/%d（需 %d），倒计时取消" % [yes, n, need])
+
+	_mp8_vote_broadcast(need)
+
+
+# 名字在**服务器上**解析好再广播。让客机自己拿 id 查 player_presences
+# 会查不到（实测显示成 "P6"）—— 服务器这边数据全，还能退一步查
+# connected_players，那是游戏自己在 propagate_player_rpc 里的写法。
+func _mp8_vote_broadcast(need: int) -> void :
+
+	var voters := PackedInt32Array()
+	var names := PackedStringArray()
+	for id in _mp8_vote_yes.keys():
+		voters.append(int(id))
+		names.append(_mp8_vote_name_of(int(id)))
+	_mp8_vote_state_rpc.rpc(
+		voters, names, need, _mp8_vote_deadline,
+		session_current_minigame_round, session_current_minigame_max_rounds,
+		_mp8_round_epoch, _mp8_round_matches(),
+		_mp8_vote_cooldown_remaining(), PackedInt32Array(_mp8_vote_roster().keys())
+	)
+
+
+func _mp8_vote_name_of(id: int) -> String :
+
+	var pres = PlayerManager.player_presences.get(id)
+	if pres != null and is_instance_valid(pres):
+		var nm := String(pres.network_name)
+		if nm != "":
+			return nm
+
+	# 退一步：游戏自己在 propagate_player_rpc 里就是遍历 connected_players
+	# 按 peer_id 配对的，照抄那条路。
+	if NetworkManager.active_backend != null:
+		for info in NetworkManager.active_backend.connected_players.values():
+			if typeof(info) == TYPE_DICTIONARY and int(info.get("peer_id", -1)) == id:
+				var nm2 := String(info.get("name", ""))
+				if nm2 != "":
+					return nm2
+
+	return "P%d" % id
+
+
+func _mp8_vote_tick(delta: float) -> void :
+
+	var locale: String = NetworkManager.mp8_locale()
+	if _mp8_vote_ui_locale != locale or _mp8_vote_notice_until_ms > 0:
+		_mp8_vote_ui_locale = locale
+		_mp8_vote_refresh_ui()
+		if _mp8_vote_now_msec() >= _mp8_vote_notice_until_ms:
+			_mp8_vote_notice_until_ms = 0
+	if not multiplayer.is_server():
+		return
+	if not _mp8_round_active:
+		return
+	if not _mp8_round_matches():
+		_mp8_round_close("tick-invalid")
+		return
+
+	# An individual voter can leave even when yes <= player count. Recheck the
+	# actual roster, not only the lengths, before advancing the countdown.
+	var roster_changed: bool = _mp8_vote_sync_roster()
+	var n: int = _mp8_vote_roster_cache.size()
+	var need: int = int(floor(float(n) / 2.0)) + 1
+	if roster_changed or need != _mp8_vote_last_need or n < 2:
+		_mp8_vote_recount()
+		if roster_changed:
+			return
+
+	if _mp8_vote_deadline >= 0.0:
+		_mp8_vote_deadline -= delta
+		if _mp8_vote_deadline <= 0.0:
+			_mp8_do_restart_round()
+			return
+
+	# Include idle rounds too: a reconnecting client needs the current generation
+	# before its first vote, even when nobody has voted yet.
+	_mp8_vote_beat -= delta
+	if _mp8_vote_beat <= 0.0:
+		_mp8_vote_beat = 1.0
+		_mp8_vote_broadcast(need)
+
+
+func _mp8_do_restart_round() -> void :
+
+	if not multiplayer.is_server() or not _mp8_round_matches():
+		_mp8_round_close("restart-invalid")
+		return
+	if _mp8_vote_sync_roster():
+		_mp8_vote_recount()
+		return
+	var n: int = _mp8_vote_roster_cache.size()
+	var yes: int = _mp8_vote_yes.size()
+	var need: int = int(floor(float(n) / 2.0)) + 1
+	if n < 2 or yes < need or _mp8_vote_cooldown_remaining() > 0.0:
+		_mp8_vote_recount()
+		return
+	var target: int = _mp8_round_identifier
+	var snapshot: Dictionary = _mp8_round_score_snapshot.duplicate(true)
+	for id in snapshot.keys():
+		if not _mp8_vote_roster_cache.has(id):
+			snapshot.erase(id)
+	var mg: String = String(minigame.name)
+	# Close synchronously before any side effect. A Finished callback from the
+	# replaced instance can no longer commit scores or load another round.
+	_mp8_vote_cooldown_until_ms = _mp8_vote_now_msec() + MP8_VOTE_COOLDOWN_MS
+	_mp8_round_close("restart")
+
+	# 强制日志 —— 整个功能里最值钱的一行，不受任何排查开关门控。
+	# 玩家什么时候重开、在哪个小游戏、几个人、第几轮，全在这里。
+	# 用 printerr 是为了它同时进 stderr，玩家发日志时不容易漏。
+	printerr("[MP8-重开] 本轮被投票重开 —— 小游戏=%s id=%d 人数=%d 轮次=%d/%d 票数=%d" % [
+		mg, int(Globals.current_minigame_identifier), n,
+		session_current_minigame_round, session_current_minigame_max_rounds, yes
+	])
+
+	# 回滚本轮已经入账的分数（理由见本节开头）
+	round_score_by_network_id = snapshot
+
+	# 跟「进下一轮」同一条路：_total_rounds 用默认 -1，轮次计数不重置
+	load_minigame(target, true)
+
+
+func _mp8_vote_clear() -> void :
+
+	_mp8_vote_yes.clear()
+	_mp8_vote_deadline = -1.0
+	_mp8_vote_beat = 0.0
+	_mp8_vote_last_need = 0
+	_mp8_vote_last_agree_ms.clear()
+	_mp8_vote_notice_until_ms = 0
+	_mp8_vote_view = PackedInt32Array()
+	_mp8_vote_view_secs = -1.0
+	_mp8_vote_refresh_ui()
+
+	# 服务器清票时必须把空状态播出去，否则客机那块面板会残留：
+	# 每秒心跳只在「有票」时才播，清空之后就没人再告诉客机了。
+	# （正常推进下一轮也会走到这里 —— 那才是最容易出现残留的路径。）
+	if multiplayer.has_multiplayer_peer() and multiplayer.is_server():
+		_mp8_vote_state_rpc.rpc(PackedInt32Array(), PackedStringArray(), 0, -1.0, 0, 0,
+			_mp8_round_epoch, _mp8_round_active, _mp8_vote_cooldown_remaining(), PackedInt32Array())
+
+
+# --------------------- 显示层（每端各自）---------------------
+
+@rpc("authority", "call_local", "reliable")
+func _mp8_vote_state_rpc(
+	voters: PackedInt32Array, names: PackedStringArray,
+	need: int, secs: float, rnd: int, rnd_max: int,
+	epoch: int, round_open: bool, cooldown: float = 0.0, eligible: PackedInt32Array = PackedInt32Array()
+) -> void :
+
+	if epoch < _mp8_vote_view_epoch:
+		return
+	_mp8_vote_view_epoch = epoch
+	_mp8_vote_view_open = round_open
+	_mp8_vote_view = voters
+	_mp8_vote_view_names = names
+	_mp8_vote_view_need = need
+	_mp8_vote_view_secs = secs
+	_mp8_vote_view_round = rnd
+	_mp8_vote_view_round_max = rnd_max
+	_mp8_vote_view_cooldown = cooldown
+	_mp8_vote_view_eligible = eligible
+	_mp8_vote_refresh_ui()
+
+
+func _mp8_vote_local_id() -> int :
+
+	return 1 if not multiplayer.has_multiplayer_peer() else multiplayer.get_unique_id()
+
+
+# 本 mod 自己的字符串取词。回退 EN —— 与游戏 default_settings 的默认一致。
+func _mp8_t(key: String) -> String :
+
+	var en: Dictionary = MP8_VOTE_L10N["EN"]
+	var tbl: Dictionary = MP8_VOTE_L10N.get(NetworkManager.mp8_locale(), en)
+	return String(tbl.get(key, en.get(key, key)))
+
+
+func _mp8_vote_clip(nm: String) -> String :
+
+	if nm.length() <= MP8_VOTE_NAME_MAX:
+		return nm
+	return nm.substr(0, MP8_VOTE_NAME_MAX) + "…"
+
+
+func _mp8_vote_names_text() -> String :
+
+	var n: int = _mp8_vote_view_names.size()
+	if n == 0:
+		return _mp8_t("none")
+
+	var shown := PackedStringArray()
+	for i in mini(n, MP8_VOTE_NAMES_SHOWN):
+		shown.append(_mp8_vote_clip(_mp8_vote_view_names[i]))
+
+	var joined: String = String(_mp8_t("sep")).join(shown)
+	if n > MP8_VOTE_NAMES_SHOWN:
+		return _mp8_t("more") % [joined, n]
+	return joined
+
+
+func _mp8_vote_refresh_ui() -> void :
+
+	var n: int = _mp8_vote_view_eligible.size()
+	var yes: int = _mp8_vote_view.size()
+	var me: int = _mp8_vote_local_id()
+	var i_voted: bool = _mp8_vote_view.has(me)
+	var counting: bool = _mp8_vote_view_secs >= 0.0
+
+	# —— ESC 菜单那颗按钮：局内一直在，文案跟着状态走 ——
+	if is_instance_valid(_mp8_vote_btn):
+		_mp8_vote_btn.visible = _mp8_vote_view_open and is_instance_valid(minigame)
+		_mp8_vote_btn.disabled = not _mp8_vote_view_eligible.has(me) or (_mp8_vote_view_cooldown > 0.0 and not i_voted)
+		if not _mp8_vote_view_eligible.has(me):
+			_mp8_vote_btn.text = _mp8_t("next_round")
+		elif _mp8_vote_view_cooldown > 0.0 and not i_voted:
+			_mp8_vote_btn.text = _mp8_t("cooldown") % int(ceil(_mp8_vote_view_cooldown))
+		elif _mp8_vote_notice_until_ms > _mp8_vote_now_msec() and not i_voted:
+			_mp8_vote_btn.text = _mp8_t("rate")
+		elif counting:
+			_mp8_vote_btn.text = _mp8_t("btn_go") % int(ceil(_mp8_vote_view_secs))
+		elif yes <= 0:
+			_mp8_vote_btn.text = _mp8_t("btn")
+		elif i_voted:
+			_mp8_vote_btn.text = _mp8_t("btn_undo") % [yes, _mp8_vote_view_need]
+		else:
+			_mp8_vote_btn.text = _mp8_t("btn_vote") % [yes, _mp8_vote_view_need]
+
+	# —— 屏幕上方的 HUD：没投票时整块收起来 ——
+	if yes <= 0 and not counting:
+		if is_instance_valid(_mp8_vote_hud):
+			_mp8_vote_hud.visible = false
+		return
+
+	if not is_instance_valid(_mp8_vote_hud):
+		_mp8_vote_hud_build()
+
+	_mp8_vote_hud.visible = true
+
+	# 小游戏名走游戏自己的本地化表 —— 抽签屏用的是同一条路
+	# （intermission_game_picker.gd:345），17 种语言自动跟着走。
+	var mg_name: String = tr(String(
+		Globals.MinigameReadableNames.get(Globals.current_minigame_identifier, "N/A")
+	))
+
+	_mp8_vote_lbl_ctx.text = _mp8_t("ctx") % [
+		mg_name, _mp8_vote_view_round, _mp8_vote_view_round_max, n
+	]
+	_mp8_vote_lbl_count.text = _mp8_t("count") % [yes, _mp8_vote_view_need]
+	_mp8_vote_lbl_who.text = _mp8_t("who") + _mp8_vote_names_text()
+
+	if counting:
+		_mp8_vote_lbl_title.text = _mp8_t("title_go")
+		_mp8_vote_lbl_you.text = _mp8_t("go") % [
+			int(ceil(_mp8_vote_view_secs)),
+			(_mp8_t("go_yes") if i_voted else _mp8_t("go_no"))
+		]
+	else:
+		_mp8_vote_lbl_title.text = _mp8_t("title")
+		_mp8_vote_lbl_you.text = (_mp8_t("you_yes") if i_voted else _mp8_t("you_no"))
+
+
+# 原生渲染只有 960x540，字号给小了看不清；亮场景里没有底色也看不清，
+# 所以用 PanelContainer 加半透明深底 + 绿边（沿用本 mod 其它 HUD 的配色）。
+func _mp8_vote_hud_build() -> void :
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8VoteHud"
+	layer.layer = 100
+	add_child(layer)
+
+	var panel := PanelContainer.new()
+	panel.name = "Panel"
+	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	panel.anchor_left = 0.5
+	panel.anchor_right = 0.5
+	panel.anchor_top = 0.0
+	panel.anchor_bottom = 0.0
+	panel.grow_horizontal = Control.GROW_DIRECTION_BOTH
+	panel.grow_vertical = Control.GROW_DIRECTION_END
+	panel.offset_top = 10.0
+
+	var sb := StyleBoxFlat.new()
+	sb.bg_color = Color(0.0, 0.0, 0.0, 0.72)
+	sb.border_color = Color(0.4, 0.9, 0.4)
+	sb.set_border_width_all(1)
+	sb.set_content_margin_all(10)
+	panel.add_theme_stylebox_override("panel", sb)
+	layer.add_child(panel)
+
+	var box := VBoxContainer.new()
+	box.add_theme_constant_override("separation", 2)
+	panel.add_child(box)
+
+	_mp8_vote_lbl_title = _mp8_vote_mk_label(box, 18, Color(0.55, 1.0, 0.55))
+	_mp8_vote_lbl_ctx   = _mp8_vote_mk_label(box, 13, Color(0.75, 0.75, 0.75))
+	_mp8_vote_lbl_count = _mp8_vote_mk_label(box, 16, Color(1.0, 1.0, 1.0))
+	_mp8_vote_lbl_who   = _mp8_vote_mk_label(box, 13, Color(0.85, 0.85, 0.85))
+	_mp8_vote_lbl_you   = _mp8_vote_mk_label(box, 14, Color(1.0, 0.9, 0.4))
+
+	# 这两行是唯一会变长的：名字可能很长很多，英文提示也比中文长。
+	# 限宽 + 自动换行，面板才不会被撑到屏幕外。
+	for l in [_mp8_vote_lbl_who, _mp8_vote_lbl_you]:
+		l.custom_minimum_size.x = MP8_VOTE_PANEL_W
+		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+
+	_mp8_vote_hud = panel
+
+
+# 字体必须显式套游戏自带的那份。默认主题字体不含中文字形，
+# 直接用会显示成方块 —— 枪械工厂那块「枪械已大幅削弱」的提示
+# （manufacture_gun.gd）就是这么做的，那条路径已经在实机上验过。
+func _mp8_vote_mk_label(parent: Node, size: int, col: Color) -> Label :
+
+	var l := Label.new()
+	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		l.add_theme_font_override("font", f)
+
+	l.add_theme_font_size_override("font_size", size)
+	l.add_theme_color_override("font_color", col)
+	l.add_theme_color_override("font_outline_color", Color.BLACK)
+	l.add_theme_constant_override("outline_size", 4)
+	parent.add_child(l)
+	return l
+
+
+# ----------- ESC 菜单里的按钮（运行时注入）-----------
+#
+# 为什么是运行时注入而不是改场景：本项目的构建管线只编译 .gdc（54 个脚本），
+# 改 .tscn 要产出二进制场景，是全新能力，成本和风险都不成比例。
+#
+# 为什么由 game.gd 注入、而不是新增 pause_menu.gd 补丁：那样补丁面会从 54 变 55，
+# 刚验完的「覆盖包 vs 重打 PCK 逐字节等价」就得重做一遍。
+# 而且投票逻辑本来就都在这个文件里。
+#
+# 外观靠 duplicate() 白嫖：复制现成的 Resume 按钮，主题、字体、
+# 连同它下面那个 ButtonClass 子节点全部免费继承 ——
+# 跟大厅那边复制椅子（_mp8_clone_chairs）是同一招。
+
+func _mp8_vote_button_attach() -> void :
+
+	if is_instance_valid(_mp8_vote_btn):
+		return
+	if PauseMenu == null:
+		return
+
+	var resume = PauseMenu.get("resume_button")
+	if resume == null or not is_instance_valid(resume):
+		print("[MP8-投票] ESC 菜单里没找到 Resume 按钮，跳过按钮注入（F5 仍然可用）")
+		return
+
+	var box: Node = (resume as Button).get_parent()
+	if box == null:
+		return
+
+	# 不复制信号 —— 带上的话点它会触发 Resume。
+	var btn: Button = (resume as Button).duplicate(
+		Node.DUPLICATE_GROUPS | Node.DUPLICATE_SCRIPTS
+	)
+	btn.name = "MP8RestartVote"
+	btn.visible = false
+
+	# 保险：万一 duplicate 还是带过来了连接，全断掉
+	for c in btn.pressed.get_connections():
+		btn.pressed.disconnect(c["callable"])
+	btn.pressed.connect(_mp8_vote_press)
+
+	box.add_child(btn)
+	var at: int = box.get_children().find(resume) + 1
+	box.move_child(btn, clampi(at, 0, box.get_child_count() - 1))
+
+	_mp8_vote_btn = btn
+	print("[MP8-投票] ESC 菜单已插入「重开本轮」按钮")
+	_mp8_vote_refresh_ui()
+
+
+func _mp8_vote_button_detach() -> void :
+
+	if is_instance_valid(_mp8_vote_btn):
+		_mp8_vote_btn.queue_free()
+	_mp8_vote_btn = null
