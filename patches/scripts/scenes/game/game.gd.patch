+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 宣传截图（mp8promo）—— 通用局内自截图，与具体小游戏无关
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 起因：15 个小游戏里只有 5 个自带 `_mp8_shot()`（残骸/凿刻/猎鸭/逆向/人工筛选），
+# 另外 10 个一张画面都截不出来。逐个去加等于改 10 个脚本、10 份回归风险，
+# 而**抓视口这件事跟小游戏是什么毫无关系** —— 所以挂在这里，一处覆盖全部 15 个。
+#
+# 与 `_mp8_shot()` 的分工：那些是**验收**用的（定点、定时、配合各自的调试开关）；
+# 这个是**出宣传图**用的，只关心画面干不干净。两者互不干扰，可以并存。
+#
+# ⚠️ 为什么挂在 load_minigame() 末尾而不是某个 Play 状态：
+# `game.gd` 看不见各小游戏内部的状态机（那是 15 套各不相同的东西）。
+# 从"小游戏进树"这一刻起算秒数是唯一对 15 个都成立的参照系。
+# 代价是时点不精确（各小游戏的开场长度不同），所以默认一次截三个时点，挑着用。
+#
+# 开关（都只在带 mp8promo 时有意义）：
+#   mp8promo          总开关，不传则整个函数第一行就 return
+#   mp8promoat=10,16  进小游戏后第几秒截，逗号分隔，可给任意多个（默认 10,16,22）
+#   mp8promoui        **保留**调试 UI（默认是截图瞬间藏掉的）
+#
+# 落点：user://mp8_promo_<小游戏id>_t<秒>_<peer>.png
+#   即 %APPDATA%\Godot\app_userdata\Machine Party\
+func _mp8_promo_shot(minigame_identifier: int) -> void :
+
+	if not Array(OS.get_cmdline_args()).has("mp8promo"):
+		return
+
+	var times: Array = []
+	var spec: String = _mp8_arg("mp8promoat=")
+	if spec == "":
+		times = [10.0, 16.0, 22.0]
+	else:
+		for part in spec.split(",", false):
+			var v: float = float(part)
+			if v > 0.0:
+				times.append(v)
+	if times.is_empty():
+		return
+	times.sort()
+
+	var peer: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var waited: float = 0.0
+
+	for t in times:
+		# 逐段等待：时点是相对"进树"的绝对秒数，不是彼此的间隔
+		var gap: float = float(t) - waited
+		if gap > 0.0:
+			await get_tree().create_timer(gap, false).timeout
+			waited = float(t)
+
+		# 小游戏中途被换掉（局数走完 / 掉线重来）就别再截了，
+		# 否则会把下一个小游戏的画面按上一个的 id 存盘。
+		if not is_inside_tree():
+			return
+		if Globals.current_minigame_identifier != minigame_identifier:
+			return
+
+		# 截图瞬间藏掉调试 UI，截完立刻还原。
+		# 这样不管命令行开了多少调试开关，出来的图都是干净的。
+		# ⚠️ 只藏 help_label（调试帮助文字），**不动头顶名牌** ——
+		# 名牌和 help_label 同在 Globals.GROUP_UI 里，但名牌是原版的东西，
+		# 而且"8 个名字同时挂在头上"正是这张图要说明的事，藏了反而没说服力。
+		var hidden: Array = []
+		if not Array(OS.get_cmdline_args()).has("mp8promoui"):
+			if debug_player_handler != null and debug_player_handler.help_label != null:
+				if debug_player_handler.help_label.visible:
+					hidden.append(debug_player_handler.help_label)
+					debug_player_handler.help_label.visible = false
+			_mp8_hide_debug_overlays(get_tree().root, hidden)
+
+		await RenderingServer.frame_post_draw
+
+		var img: Image = get_viewport().get_texture().get_image()
+		if img != null:
+			var path: String = "user://mp8_promo_%d_t%d_%d.png" % [minigame_identifier, int(t), peer]
+			img.save_png(path)
+			print("[MP8] mp8promo：已存 %s" % path)
+
+		for node in hidden:
+			if is_instance_valid(node):
+				node.visible = true
+
+
+# [MP8] 递归藏掉本 mod 自己加的调试浮层，收进 out 供截图后还原。
+#
+# ⚠️ 判据是**三条同时成立**，缺一条都会误伤：
+#   ① 是 CanvasLayer 或 Control —— 挡住 MP8Press / MP8Belt / MP8Spawn 那些
+#      同样以 MP8 开头、但**是玩法实体**的 Node3D，藏了它们就把场地拆了；
+#   ② 名字以 MP8 开头 —— 只认本 mod 加的，原版 UI 一律不碰；
+#   ③ 名字里带 Panel / Debug / Info —— 只认**调试浮层**。
+#      这条把 MP8BurnScoreBoard（8 人结算榜）和 MP8RoleRich（角色揭示）留了下来，
+#      它们是玩家该看到的东西，恰恰是宣传图想要的内容。
+func _mp8_hide_debug_overlays(node: Node, out: Array) -> void :
+
+	var n: String = node.name
+	if n.begins_with("MP8") and (node is CanvasLayer or node is Control):
+		if n.contains("Panel") or n.contains("Debug") or n.contains("Info"):
+			if node.visible:
+				out.append(node)
+				node.visible = false
+			return
+
+	for child in node.get_children():
+		_mp8_hide_debug_overlays(child, out)
+
+
+# [MP8] 取 mp8xxx=<值> 形式的命令行参数，取不到返回空串
+func _mp8_arg(prefix: String) -> String:
+	for a in OS.get_cmdline_args():
+		var s: String = str(a)
+		if s.begins_with(prefix):
+			return s.substr(prefix.length())
+	return ""
+
+
+# [MP8] 崩溃面包屑：每条都开-写-关，保证落盘。只在传 mp8trace 时启用。
+var _mp8_trace_on: int = -1
+
+func _mp8_trace(msg: String) -> void :
+
+	if _mp8_trace_on == -1:
+		_mp8_trace_on = 1 if Array(OS.get_cmdline_args()).has("mp8trace") else 0
+
+	if _mp8_trace_on == 0:
+		return
+
+	var path := "user://mp8_trace.txt"
+	var f := FileAccess.open(path, FileAccess.READ_WRITE) if FileAccess.file_exists(path) else FileAccess.open(path, FileAccess.WRITE)
+	if f == null:
+		return
+	f.seek_end()
+	f.store_line("[%d] %s" % [multiplayer.get_unique_id() if multiplayer else 0, msg])
+	f.close()
 
